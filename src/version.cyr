# nous/version — SemVer parsing, constraint matching
# ===================================================================
# P1: Version Constraints
# ===================================================================

# Constraint operators
enum ConstraintOp {
    OP_EQ = 0;
    OP_GTE = 1;
    OP_GT = 2;
    OP_LTE = 3;
    OP_LT = 4;
    OP_CARET = 5;
    OP_TILDE = 6;
    OP_ANY = 7;
    OP_SET = 8;     # 1.7.1: a compound range; its comparators are in nous_ct_sets()
}

# SemVer: sv_major(0) sv_minor(8) sv_patch(16) sv_pre(24) sv_build(32) = 40 bytes.
# 1.7.0: +pre, the pre-release identifiers after '-' ("rc.1"), and +build, the
# build metadata after '+' ("build.5"); each an owned Str, or 0 when absent
# (SemVer 2.0.0 §9, §10). Before, both were dropped, so 1.0.0-rc.1 was 1.0.0.
#
# SemVer constructor: major, minor, patch (i64), with no pre-release or build.
fn semver_new(major, minor, patch): i64 {
    var p = alloc(40);
    store64(p, major); store64(p + 8, minor); store64(p + 16, patch);
    store64(p + 24, 0); store64(p + 32, 0);
    return p;
}
# SemVer constructor with a pre-release and build metadata (Str each, or 0). 1.7.0.
fn nous_semver_new_full(major, minor, patch, pre, build): i64 {
    var p = semver_new(major, minor, patch);
    store64(p + 24, pre); store64(p + 32, build);
    return p;
}
# SemVer field: major component.
fn sv_major(v): i64 { return load64(v); }
# SemVer field: minor component.
fn sv_minor(v): i64 { return load64(v + 8); }
# SemVer field: patch component.
fn sv_patch(v): i64 { return load64(v + 16); }
# SemVer field: pre-release identifiers as written ("rc.1", a Str), or 0 for a release. 1.7.0.
fn nous_sv_pre(v): i64 { return load64(v + 24); }
# SemVer field: build metadata as written ("build.5", a Str), or 0. Never part of precedence. 1.7.0.
fn nous_sv_build(v): i64 { return load64(v + 32); }

# Constraint: ct_op(0) ct_ver(8) ct_prec(16) ct_err(24) ct_range(32) ct_sets(40)
# ct_rset(48) = 56 bytes. 1.5.3: +prec, the number of version components
# written ("1.2" = 2), and +err, a Str reason when the text is not a supported
# constraint, else 0. 1.7.1: +sets, the comparator sets of an OP_SET (compound)
# constraint, and +rset, its cached range set (_nous_ct_rset).
#
# Constraint constructor: op (ConstraintOp), ver (SemVer); precision 3, no error.
fn constraint_new(op, ver): i64 {
    var p = alloc(56);
    store64(p, op); store64(p + 8, ver); store64(p + 16, 3); store64(p + 24, 0);
    store64(p + 32, 0);     # cached range (see _nous_range_of)
    store64(p + 40, 0); store64(p + 48, 0);
    return p;
}
# Constraint field: the ConstraintOp.
fn ct_op(c): i64 { return load64(c); }
# Constraint field: the SemVer bound (0.0.0 for OP_ANY; 0 for OP_SET or a refused constraint).
fn ct_ver(c): i64 { return load64(c + 8); }
# Constraint field: how many version components were written ("1.2" = 2), 1 to 3.
fn ct_prec(c): i64 { return load64(c + 16); }
# 0 for a supported constraint, else why it is not (a Str). 1.5.3.
fn nous_constraint_error(c): i64 { return load64(c + 24); }
# Constraint field: an OP_SET constraint's comparator sets, a vec (OR) of vecs (AND) of simple
# Constraints; 0 for a simple constraint. 1.7.1.
fn nous_ct_sets(c): i64 { return load64(c + 40); }
fn _nous_ct_fail(op, why): i64 {
    var c = constraint_new(op, 0);
    store64(c + 24, str_from(why));
    return c;
}

# 1 when byte c may appear in a SemVer identifier: [0-9A-Za-z-] (§9, §10).
fn _nous_id_char(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 97 && c <= 122) { return 1; }
    if (c == 45) { return 1; }
    return 0;
}

# Parse a version into a SemVer: "M[.m[.p]][-pre][+build]", optionally
# "v"-prefixed. Lenient, as nous has always been for versions it is handed:
# missing parts are 0 ("1.2" = 1.2.0), leading zeros are read as numbers, and
# trailing text it does not recognise is ignored. 0 when a part overflows i64.
#
# 1.7.0: the pre-release and build metadata are kept (SemVer 2.0.0 §9, §10),
# each as the run of [0-9A-Za-z.-] after its '-' / '+'; an empty one is dropped.
# Before, everything after the patch number was ignored, so 1.0.0-rc.1
# compared equal to 1.0.0 and the release was never offered as an update.
#
# Parse version Str s into a SemVer (lenient; see above), or 0 when a part overflows i64.
fn semver_parse(s): i64 {
    var d = str_data(s);
    var len = str_len(s);
    var pos = 0;
    # 1.5.3: a leading 'v' / 'V' is accepted ("v2.0.0"), as npm does. It parsed
    # as 0.0.0, so update_is_newer("v2.0.0", "1.0.0") missed a real update
    # and update_is_newer("1.0.0", "v2.0.0") reported a downgrade as one.
    if (len > 0 && (load8(d) == 118 || load8(d) == 86)) { pos = 1; }
    # Overflow guard (1.5.3: exact). `x * 10 + d` fits in i64 iff
    # x <= (INT64_MAX - d) / 10. The old `x > INT64_MAX / 10` test ran before
    # the multiply-add, so 9223372036854775808 wrapped to INT64_MIN and
    # compared below 0.0.1.
    var I64MAX = 9223372036854775807;
    # The three parts unrolled, as before 1.7.0 (a loop over them cost ~10% on
    # the constraint bench); a missing '.' ends the core early.
    var v0 = 0;
    var v1 = 0;
    var v2 = 0;
    while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
        var dg0 = load8(d + pos) - 48;
        if (v0 > (I64MAX - dg0) / 10) { return 0; }
        v0 = v0 * 10 + dg0;
        pos = pos + 1;
    }
    if (pos < len && load8(d + pos) == 46) {
        pos = pos + 1;
        while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
            var dg1 = load8(d + pos) - 48;
            if (v1 > (I64MAX - dg1) / 10) { return 0; }
            v1 = v1 * 10 + dg1;
            pos = pos + 1;
        }
        if (pos < len && load8(d + pos) == 46) {
            pos = pos + 1;
            while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
                var dg2 = load8(d + pos) - 48;
                if (v2 > (I64MAX - dg2) / 10) { return 0; }
                v2 = v2 * 10 + dg2;
                pos = pos + 1;
            }
        }
    }
    var pre = 0;
    var build = 0;
    if (pos < len && load8(d + pos) == 45) {
        var ps = pos + 1;
        var pe = ps;
        while (pe < len && (_nous_id_char(load8(d + pe)) == 1 || load8(d + pe) == 46)) { pe = pe + 1; }
        if (pe > ps) { pre = str_clone(str_new(d + ps, pe - ps)); }
        pos = pe;
    }
    if (pos < len && load8(d + pos) == 43) {
        var bs = pos + 1;
        var be = bs;
        while (be < len && (_nous_id_char(load8(d + be)) == 1 || load8(d + be) == 46)) { be = be + 1; }
        if (be > bs) { build = str_clone(str_new(d + bs, be - bs)); }
    }
    var p = alloc(40);
    store64(p, v0); store64(p + 8, v1); store64(p + 16, v2);
    store64(p + 24, pre); store64(p + 32, build);
    return p;
}

# 1 when the n bytes at p are a SemVer numeric identifier: one or more digits.
fn _nous_id_isnum(p, n): i64 {
    if (n == 0) { return 0; }
    var i = 0;
    while (i < n) {
        var c = load8(p + i);
        if (c < 48 || c > 57) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Compare one identifier [p, p+pn) with [q, q+qn) by SemVer §11.4.1-3:
# digit-only ones numerically (any length: leading zeros skipped, then the
# longer is larger), others by ASCII byte order, and numeric before
# alphanumeric. Returns -1, 0 or 1.
fn _nous_id_cmp(p, pn, q, qn): i64 {
    var np = _nous_id_isnum(p, pn);
    var nq = _nous_id_isnum(q, qn);
    if (np == 1 && nq == 1) {
        while (pn > 1 && load8(p) == 48) { p = p + 1; pn = pn - 1; }
        while (qn > 1 && load8(q) == 48) { q = q + 1; qn = qn - 1; }
        if (pn < qn) { return 0 - 1; }
        if (pn > qn) { return 1; }
    } else {
        if (np == 1) { return 0 - 1; }
        if (nq == 1) { return 1; }
    }
    var m = pn;
    if (qn < m) { m = qn; }
    var i = 0;
    while (i < m) {
        var a = load8(p + i);
        var b = load8(q + i);
        if (a < b) { return 0 - 1; }
        if (a > b) { return 1; }
        i = i + 1;
    }
    if (pn < qn) { return 0 - 1; }
    if (pn > qn) { return 1; }
    return 0;
}

# Compare two dot-separated identifier lists (Strs, non-empty) by SemVer
# §11.4: identifier by identifier, and when one list is a prefix of the other
# the longer one is larger (§11.4.4). pub_semver orders build parts the same
# way. Returns -1, 0 or 1.
fn _nous_ids_cmp(a, b): i64 {
    var ad = str_data(a);
    var al = str_len(a);
    var bd = str_data(b);
    var bl = str_len(b);
    var ia = 0;
    var ib = 0;
    while (1 == 1) {
        var ea = ia;
        while (ea < al && load8(ad + ea) != 46) { ea = ea + 1; }
        var eb = ib;
        while (eb < bl && load8(bd + eb) != 46) { eb = eb + 1; }
        var c = _nous_id_cmp(ad + ia, ea - ia, bd + ib, eb - ib);
        if (c != 0) { return c; }
        var ma = 0;
        if (ea < al) { ma = 1; }
        var mb = 0;
        if (eb < bl) { mb = 1; }
        if (ma == 0 && mb == 0) { return 0; }
        if (ma == 0) { return 0 - 1; }
        if (mb == 0) { return 1; }
        ia = ea + 1;
        ib = eb + 1;
    }
    return 0;
}

# Compare two SemVers by precedence (SemVer 2.0.0 §11): major, minor and
# patch numerically, then a pre-release sorts before its release, and two
# pre-releases compare identifier by identifier. Build metadata is ignored
# (§10), so 1.0.0+a and 1.0.0+b are equal. 1.7.0: pre-releases took no part,
# so 1.0.0-rc.1 compared equal to 1.0.0.
#
# Compare two SemVers by precedence (§11; build ignored). Returns -1, 0, or 1.
fn semver_cmp(a, b): i64 {
    if (sv_major(a) < sv_major(b)) { return (0 - 1); }
    if (sv_major(a) > sv_major(b)) { return 1; }
    if (sv_minor(a) < sv_minor(b)) { return (0 - 1); }
    if (sv_minor(a) > sv_minor(b)) { return 1; }
    if (sv_patch(a) < sv_patch(b)) { return (0 - 1); }
    if (sv_patch(a) > sv_patch(b)) { return 1; }
    var pa = load64(a + 24);
    var pb = load64(b + 24);
    if (pa == 0 && pb == 0) { return 0; }
    if (pa == 0) { return 1; }
    if (pb == 0) { return 0 - 1; }
    return _nous_ids_cmp(pa, pb);
}

# Dart pub_semver's order, for Flutter versions (1.7.0): SemVer precedence,
# then build metadata, where no build sorts first and build parts compare like
# pre-release identifiers ("1.0.0+1" < "1.0.0+2"). Flutter puts the build
# number there, so it orders updates. This departs from SemVer §10 on purpose
# (pub_semver's Version.compareTo; see docs/sources.md).
#
# Compare two SemVers in pub_semver order (precedence, then build). Returns -1, 0, or 1.
fn nous_semver_cmp_pub(a, b): i64 {
    var c = semver_cmp(a, b);
    if (c != 0) { return c; }
    var ba = nous_sv_build(a);
    var bb = nous_sv_build(b);
    if (ba == 0 && bb == 0) { return 0; }
    if (ba == 0) { return 0 - 1; }
    if (bb == 0) { return 1; }
    return _nous_ids_cmp(ba, bb);
}

# 1 when SemVers a and b have equal precedence (major, minor, patch, pre-release; build ignored).
fn semver_eq(a, b): i64 { return semver_cmp(a, b) == 0; }

# "major.minor.patch[-pre][+build]" text (Str) of SemVer v.
fn semver_to_str(v): i64 {
    var sb = str_builder_new();
    str_builder_add_int(sb, sv_major(v));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, sv_minor(v));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, sv_patch(v));
    if (nous_sv_pre(v) != 0) {
        str_builder_add_cstr(sb, "-");
        str_builder_add(sb, nous_sv_pre(v));
    }
    if (nous_sv_build(v) != 0) {
        str_builder_add_cstr(sb, "+");
        str_builder_add(sb, nous_sv_build(v));
    }
    return str_builder_build(sb);
}

# A version at d[pos..len): "M[.m[.p]]", optionally "v"-prefixed, where a part
# may be a wildcard x / X / *. Writes the SemVer (missing and wildcard parts 0)
# to out+0, the PRECISION (numeric parts before the first wildcard or the end)
# to out+8, and the end position to out+16. Returns 1, or 0 when there is no
# number at pos or a part overflows i64.
fn _nous_ver_parse_p(d, len, pos, out): i64 {
    var I64MAX = 9223372036854775807;
    if (pos < len && (load8(d + pos) == 118 || load8(d + pos) == 86)) { pos = pos + 1; }
    var parts = alloc(24);
    store64(parts, 0); store64(parts + 8, 0); store64(parts + 16, 0);
    var prec = 0;
    var wild = 0;
    var k = 0;
    while (k < 3) {
        if (pos < len && (load8(d + pos) == 120 || load8(d + pos) == 88 || load8(d + pos) == 42)) {
            wild = 1;
            pos = pos + 1;
        } else {
            var start = pos;
            var x = 0;
            while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
                var dg = load8(d + pos) - 48;
                if (x > (I64MAX - dg) / 10) { return 0; }
                x = x * 10 + dg;
                pos = pos + 1;
            }
            if (pos == start) {
                if (k == 0) { return 0; }
                k = 3;
            } else {
                store64(parts + k * 8, x);
                if (wild == 0) { prec = prec + 1; }
            }
        }
        if (k < 3) {
            k = k + 1;
            if (k < 3) {
                if (pos < len && load8(d + pos) == 46) { pos = pos + 1; }
                else { k = 3; }
            }
        }
    }
    store64(out, semver_new(load64(parts), load64(parts + 8), load64(parts + 16)));
    store64(out + 8, prec);
    store64(out + 16, pos);
    return 1;
}

# End of a strict SemVer identifier list in d[pos..len): one or more non-empty
# [0-9A-Za-z-] identifiers joined by '.', stopping at the first other byte.
# With `strict_num` (pre-release, §9) a numeric identifier may not have a
# leading zero; build metadata (§10) allows one. -1 when malformed. 1.7.0.
fn _nous_ids_end(d, len, pos, strict_num): i64 {
    var i = pos;
    while (1 == 1) {
        var s0 = i;
        var digits = 1;
        while (i < len && _nous_id_char(load8(d + i)) == 1) {
            if (load8(d + i) < 48 || load8(d + i) > 57) { digits = 0; }
            i = i + 1;
        }
        if (i == s0) { return 0 - 1; }
        if (strict_num == 1 && digits == 1 && i - s0 > 1 && load8(d + s0) == 48) { return 0 - 1; }
        if (i < len && load8(d + i) == 46) { i = i + 1; } else { return i; }
    }
    return i;
}

# Parse a version constraint (1.5.3, decision D1).
#   *  x  ""            any version
#   =V  or bare V        exactly V; a partial is an X-range ("1.2" = >=1.2.0 <1.3.0)
#   >=V  >V  <=V  <V     comparators (partials as Cargo: ">1.2" = >=1.3.0)
#   ^V   ~V              caret / tilde with npm/Cargo zero-major rules; partials
#                        "^0" = <1.0.0, "^0.0" = <0.1.0, "~1" = <2.0.0
#   V-pre[+build]        (1.7.0) a full M.m.p may carry a pre-release, written
#                        strictly per SemVer §9; build metadata is accepted and
#                        ignored, as npm and Cargo do
# A leading "v" is accepted. Anything else sets nous_constraint_error() and
# never matches: unknown or doubled operators ("!=", "==", "~>", ">>"), a
# pre-release on a partial version ("1.2-rc"), a malformed pre-release or
# build, and trailing text. Before 1.5.3 these were accepted silently:
# "!=1.0.0" became "=0.0.0", and ">=1.0, <2.0" matched 3.0.0.
#
# Compound ranges (1.7.1; npm "Range Grammar", Cargo "Multiple version
# requirements"):
#   A B   or   A, B     AND: a comparator set; whitespace (npm) or commas
#                       (Cargo), and an operator may stand apart (">= 1.2")
#   S1 || S2            OR of comparator sets; an empty side is "*"
#   A - B               hyphen range, inclusive: >=A <=B, where a partial A
#                       fills zeros and a partial B is an X-range
#                       ("1.2.3 - 2.3" = >=1.2.3 <2.4.0)
# One comparator stays a simple Constraint; anything more is OP_SET, with the
# sets in nous_ct_sets().
#
# A pre-release VERSION matches only a constraint whose own version has a
# pre-release on the same M.m.p (npm / Cargo; see constraint_matches).
#
# One comparator, d[pos..len): what constraint_parse accepted before 1.7.1.
fn _nous_ct_parse1(d, pos, len): i64 {
    while (pos < len && (load8(d + pos) == 32 || load8(d + pos) == 9)) { pos = pos + 1; }
    var end = len;
    while (end > pos && (load8(d + end - 1) == 32 || load8(d + end - 1) == 9)) { end = end - 1; }
    if (pos >= end) { return constraint_new(OP_ANY, semver_new(0, 0, 0)); }
    if (end - pos == 1) {
        var only = load8(d + pos);
        if (only == 42 || only == 120 || only == 88) { return constraint_new(OP_ANY, semver_new(0, 0, 0)); }
    }
    var op = OP_EQ;
    var c = load8(d + pos);
    if (c == 94) { op = OP_CARET; pos = pos + 1; }
    elif (c == 126) { op = OP_TILDE; pos = pos + 1; }
    elif (c == 62) {
        pos = pos + 1;
        if (pos < end && load8(d + pos) == 61) { op = OP_GTE; pos = pos + 1; } else { op = OP_GT; }
    }
    elif (c == 60) {
        pos = pos + 1;
        if (pos < end && load8(d + pos) == 61) { op = OP_LTE; pos = pos + 1; } else { op = OP_LT; }
    }
    elif (c == 61) { op = OP_EQ; pos = pos + 1; }
    elif (c == 33) { return _nous_ct_fail(OP_EQ, "'!=' is not supported"); }
    while (pos < end && load8(d + pos) == 32) { pos = pos + 1; }
    if (pos < end) {
        var c2 = load8(d + pos);
        if (c2 == 61 || c2 == 62 || c2 == 60 || c2 == 126 || c2 == 94 || c2 == 33) {
            return _nous_ct_fail(op, "doubled or unknown operator");
        }
    }
    var out = alloc(24);
    if (_nous_ver_parse_p(d, end, pos, out) == 0) {
        if (pos < end && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
            return _nous_ct_fail(op, "version number too large");
        }
        return _nous_ct_fail(op, "missing or malformed version");
    }
    var vend = load64(out + 16);
    var prec = load64(out + 8);
    var ver = load64(out);
    # 1.7.0: a pre-release and build metadata on a full version.
    if (vend < end && (load8(d + vend) == 45 || load8(d + vend) == 43)) {
        if (prec < 3) { return _nous_ct_fail(op, "a pre-release or build needs a full version (M.m.p-pre)"); }
        var pre = 0;
        if (load8(d + vend) == 45) {
            var pe = _nous_ids_end(d, end, vend + 1, 1);
            var pre_msg = "malformed pre-release (SemVer §9: dot-separated [0-9A-Za-z-], no leading zeros)";
            if (pe < 0) { return _nous_ct_fail(op, pre_msg); }
            pre = str_clone(str_new(d + vend + 1, pe - vend - 1));
            vend = pe;
        }
        var build = 0;
        if (vend < end && load8(d + vend) == 43) {
            var be = _nous_ids_end(d, end, vend + 1, 0);
            var build_msg = "malformed build metadata (SemVer §10: dot-separated [0-9A-Za-z-])";
            if (be < 0) { return _nous_ct_fail(op, build_msg); }
            build = str_clone(str_new(d + vend + 1, be - vend - 1));
            vend = be;
        }
        ver = nous_semver_new_full(sv_major(ver), sv_minor(ver), sv_patch(ver), pre, build);
    }
    if (vend < end) { return _nous_ct_fail(op, "unexpected text after the version"); }
    if (prec == 0) { return constraint_new(OP_ANY, semver_new(0, 0, 0)); }
    var ct = constraint_new(op, ver);
    store64(ct + 16, prec);
    return ct;
}

# 1 when byte c is a constraint operator character: < > = ~ ^ !
fn _nous_ct_opchar(c): i64 {
    if (c == 60 || c == 62 || c == 61 || c == 126 || c == 94 || c == 33) { return 1; }
    return 0;
}

# 1 when d[a..b) is only operator characters (an operator standing apart).
fn _nous_ct_is_op(d, a, b): i64 {
    if (b <= a) { return 0; }
    var i = a;
    while (i < b) {
        if (_nous_ct_opchar(load8(d + i)) == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# A copy of simple Constraint c with operator `op` (for a hyphen range's bounds).
fn _nous_ct_with_op(c, op): i64 {
    var n = constraint_new(op, ct_ver(c));
    store64(n + 16, ct_prec(c));
    return n;
}

# The comparators of one comparator set, d[a..b): a vec of simple
# Constraints, empty for an empty set (which means "*"). On a refused
# comparator it returns 0 and stores that Constraint at *err_out.
fn _nous_ct_parse_set(d, a, b, err_out): i64 {
    var out = vec_new();
    # Tokens: maximal runs that are not whitespace or ','. A ',' must sit
    # between two comparators (Cargo); a stray one is an error.
    var toks = vec_new();
    var i = a;
    var need_tok = 0;
    while (i < b) {
        var c = load8(d + i);
        if (c == 32 || c == 9) { i = i + 1; }
        elif (c == 44) {
            if (vec_len(toks) == 0 || need_tok == 1) {
                store64(err_out, _nous_ct_fail(OP_EQ, "empty comparator (a stray ',')"));
                return 0;
            }
            need_tok = 1;
            i = i + 1;
        } else {
            var ts = i;
            while (i < b && load8(d + i) != 32 && load8(d + i) != 9 && load8(d + i) != 44) { i = i + 1; }
            vec_push(toks, ts);
            vec_push(toks, i);
            need_tok = 0;
        }
    }
    if (need_tok == 1) {
        store64(err_out, _nous_ct_fail(OP_EQ, "empty comparator (a stray ',')"));
        return 0;
    }
    var nt = vec_len(toks) / 2;
    if (nt == 0) { return out; }
    # A hyphen range: exactly "A - B".
    var hy = 0;
    var k = 0;
    while (k < nt) {
        var hs = vec_get(toks, k * 2);
        if (vec_get(toks, k * 2 + 1) - hs == 1 && load8(d + hs) == 45) { hy = hy + 1; }
        k = k + 1;
    }
    if (hy > 0) {
        var hy_msg = "a hyphen range is 'A - B': one ' - ' between two plain versions";
        if (hy != 1 || nt != 3 || vec_get(toks, 3) - vec_get(toks, 2) != 1 || load8(d + vec_get(toks, 2)) != 45) {
            store64(err_out, _nous_ct_fail(OP_EQ, hy_msg));
            return 0;
        }
        var lo = _nous_ct_parse1(d, vec_get(toks, 0), vec_get(toks, 1));
        var hi = _nous_ct_parse1(d, vec_get(toks, 4), vec_get(toks, 5));
        if (nous_constraint_error(lo) != 0) { store64(err_out, lo); return 0; }
        if (nous_constraint_error(hi) != 0) { store64(err_out, hi); return 0; }
        if ((ct_op(lo) != OP_EQ && ct_op(lo) != OP_ANY) || (ct_op(hi) != OP_EQ && ct_op(hi) != OP_ANY)) {
            store64(err_out, _nous_ct_fail(OP_EQ, hy_msg));
            return 0;
        }
        if (ct_op(lo) == OP_EQ) { vec_push(out, _nous_ct_with_op(lo, OP_GTE)); }
        if (ct_op(hi) == OP_EQ) { vec_push(out, _nous_ct_with_op(hi, OP_LTE)); }
        if (vec_len(out) == 0) { vec_push(out, constraint_new(OP_ANY, semver_new(0, 0, 0))); }
        return out;
    }
    # Comparators; an operator standing apart joins the token after it.
    k = 0;
    while (k < nt) {
        var cs = vec_get(toks, k * 2);
        var ce = vec_get(toks, k * 2 + 1);
        if (_nous_ct_is_op(d, cs, ce) == 1) {
            if (k + 1 >= nt) {
                store64(err_out, _nous_ct_fail(OP_EQ, "an operator needs a version after it"));
                return 0;
            }
            k = k + 1;
            ce = vec_get(toks, k * 2 + 1);
        }
        var cmp = _nous_ct_parse1(d, cs, ce);
        if (nous_constraint_error(cmp) != 0) { store64(err_out, cmp); return 0; }
        vec_push(out, cmp);
        k = k + 1;
    }
    return out;
}

# Parse Str s into a Constraint; a refused one never matches and nous_constraint_error says why.
fn constraint_parse(s): i64 {
    var d = str_data(s);
    var len = str_len(s);
    # Fast path: one comparator, parsed as before 1.7.1, in one pass. Only when
    # that fails and the text has a separator ('|', ',' or inner whitespace) is
    # it a compound range. A text the one-comparator parser accepts holds no
    # separator, so both paths agree on it.
    var one = _nous_ct_parse1(d, 0, len);
    if (load64(one + 24) == 0) { return one; }
    var i = 0;
    var sep = 0;
    while (i < len && sep == 0) {
        var c = load8(d + i);
        if (c == 124 || c == 44) { sep = 1; }
        elif ((c == 32 || c == 9) && i > 0 && i + 1 < len) { sep = 1; }
        i = i + 1;
    }
    if (sep == 0) { return one; }
    # OR of comparator sets, split at "||".
    var sets = vec_new();
    var err = alloc(8);
    var a = 0;
    i = 0;
    while (i <= len) {
        if (i == len || load8(d + i) == 124) {
            if (i < len && (i + 1 >= len || load8(d + i + 1) != 124)) {
                return _nous_ct_fail(OP_EQ, "a single '|' is not an operator (use '||')");
            }
            var set = _nous_ct_parse_set(d, a, i, err);
            if (set == 0) { return load64(err); }
            if (vec_len(set) == 0) { vec_push(set, constraint_new(OP_ANY, semver_new(0, 0, 0))); }
            vec_push(sets, set);
            i = i + 2;
            a = i;
        } else {
            i = i + 1;
        }
    }
    # One comparator in one set is a simple constraint, exactly as before.
    if (vec_len(sets) == 1 && vec_len(vec_get(sets, 0)) == 1) { return vec_get(vec_get(sets, 0), 0); }
    var ct = constraint_new(OP_SET, 0);
    store64(ct + 16, 0);
    store64(ct + 40, sets);
    return ct;
}

# ---- version ranges (1.5.3) -------------------------------------------
# Range: lo(0) lo_incl(8) hi(16) hi_incl(24); lo / hi are SemVers, or 0 for
# unbounded.
fn _nous_range_new(lo, lo_incl, hi, hi_incl): i64 {
    var p = alloc(32);
    store64(p, lo); store64(p + 8, lo_incl); store64(p + 16, hi); store64(p + 24, hi_incl);
    return p;
}
fn _rg_lo(r): i64 { return load64(r); }
fn _rg_lo_incl(r): i64 { return load64(r + 8); }
fn _rg_hi(r): i64 { return load64(r + 16); }
fn _rg_hi_incl(r): i64 { return load64(r + 24); }

# The range a supported constraint denotes (npm / Cargo desugaring; see
# docs/sources.md). 0 for a constraint with an error.
fn _nous_range_of(c): i64 {
    if (nous_constraint_error(c) != 0 || ct_ver(c) == 0) { return 0; }
    # Computed once per constraint (1.5.3, perf): matching against the same
    # constraint must not allocate a range on every call.
    if (load64(c + 32) != 0) { return load64(c + 32); }
    var rg = _nous_range_build(c);
    store64(c + 32, rg);
    return rg;
}

fn _nous_range_build(c): i64 {
    var op = ct_op(c);
    if (op == OP_ANY) { return _nous_range_new(0, 1, 0, 1); }
    var v = ct_ver(c);
    var M = sv_major(v);
    var m = sv_minor(v);
    var pt = sv_patch(v);
    var P = ct_prec(c);
    if (op == OP_EQ) {
        if (P >= 3) { return _nous_range_new(v, 1, v, 1); }
        if (P == 2) { return _nous_range_new(semver_new(M, m, 0), 1, semver_new(M, m + 1, 0), 0); }
        return _nous_range_new(semver_new(M, 0, 0), 1, semver_new(M + 1, 0, 0), 0);
    }
    if (op == OP_GTE) { return _nous_range_new(v, 1, 0, 1); }
    if (op == OP_GT) {
        if (P >= 3) { return _nous_range_new(v, 0, 0, 1); }
        if (P == 2) { return _nous_range_new(semver_new(M, m + 1, 0), 1, 0, 1); }
        return _nous_range_new(semver_new(M + 1, 0, 0), 1, 0, 1);
    }
    if (op == OP_LT) { return _nous_range_new(0, 1, v, 0); }
    if (op == OP_LTE) {
        if (P >= 3) { return _nous_range_new(0, 1, v, 1); }
        if (P == 2) { return _nous_range_new(0, 1, semver_new(M, m + 1, 0), 0); }
        return _nous_range_new(0, 1, semver_new(M + 1, 0, 0), 0);
    }
    if (op == OP_CARET) {
        if (P == 1) { return _nous_range_new(v, 1, semver_new(M + 1, 0, 0), 0); }
        if (M > 0) { return _nous_range_new(v, 1, semver_new(M + 1, 0, 0), 0); }
        if (P == 2 || m > 0) { return _nous_range_new(v, 1, semver_new(0, m + 1, 0), 0); }
        return _nous_range_new(v, 1, semver_new(0, 0, pt + 1), 0);
    }
    if (op == OP_TILDE) {
        if (P == 1) { return _nous_range_new(v, 1, semver_new(M + 1, 0, 0), 0); }
        return _nous_range_new(v, 1, semver_new(M, m + 1, 0), 0);
    }
    return 0;
}

# 1 when SemVer `v` lies in range `rg`.
fn _nous_range_contains(rg, v): i64 {
    if (rg == 0 || v == 0) { return 0; }
    if (_rg_lo(rg) != 0) {
        var a = semver_cmp(v, _rg_lo(rg));
        if (a < 0 || (a == 0 && _rg_lo_incl(rg) == 0)) { return 0; }
    }
    if (_rg_hi(rg) != 0) {
        var b = semver_cmp(v, _rg_hi(rg));
        if (b > 0 || (b == 0 && _rg_hi_incl(rg) == 0)) { return 0; }
    }
    return 1;
}

# The intersection of two ranges, or 0 when it is empty.
fn _nous_range_intersect(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var lo = _rg_lo(a);
    var lo_i = _rg_lo_incl(a);
    if (_rg_lo(b) != 0) {
        if (lo == 0) { lo = _rg_lo(b); lo_i = _rg_lo_incl(b); }
        else {
            var c = semver_cmp(_rg_lo(b), lo);
            if (c > 0) { lo = _rg_lo(b); lo_i = _rg_lo_incl(b); }
            elif (c == 0 && _rg_lo_incl(b) == 0) { lo_i = 0; }
        }
    }
    var hi = _rg_hi(a);
    var hi_i = _rg_hi_incl(a);
    if (_rg_hi(b) != 0) {
        if (hi == 0) { hi = _rg_hi(b); hi_i = _rg_hi_incl(b); }
        else {
            var c2 = semver_cmp(_rg_hi(b), hi);
            if (c2 < 0) { hi = _rg_hi(b); hi_i = _rg_hi_incl(b); }
            elif (c2 == 0 && _rg_hi_incl(b) == 0) { hi_i = 0; }
        }
    }
    if (lo != 0 && hi != 0) {
        var e = semver_cmp(lo, hi);
        if (e > 0) { return 0; }
        if (e == 0 && (lo_i == 0 || hi_i == 0)) { return 0; }
    }
    return _nous_range_new(lo, lo_i, hi, hi_i);
}

# The smallest RELEASE version (no pre-release) in non-empty range rg, or 0
# when rg holds only pre-releases. Then they are all pre-releases of one
# M.m.p, the release returned by `_nous_range_release_floor`. 1.7.0.
fn _nous_range_release_floor(rg): i64 {
    var lo = _rg_lo(rg);
    var r = 0;
    if (lo == 0) { r = semver_new(0, 0, 0); }
    elif (nous_sv_pre(lo) != 0) { r = semver_new(sv_major(lo), sv_minor(lo), sv_patch(lo)); }
    elif (_rg_lo_incl(rg) == 1) { r = semver_new(sv_major(lo), sv_minor(lo), sv_patch(lo)); }
    else { r = semver_new(sv_major(lo), sv_minor(lo), sv_patch(lo) + 1); }
    return r;
}

# 1 when non-empty range rg contains a release version (see
# _nous_range_release_floor). It compares the floor's M.m.p with hi in place,
# without building the floor: constraints_compatible calls this every time.
fn _nous_range_has_release(rg): i64 {
    # Fields read in place (load64; range: lo 0, lo_incl 8, hi 16, hi_incl 24).
    var hi = load64(rg + 16);
    if (hi == 0) { return 1; }
    var lo = load64(rg);
    var fM = 0;
    var fm = 0;
    var fp = 0;
    if (lo != 0) {
        fM = load64(lo);
        fm = load64(lo + 8);
        fp = load64(lo + 16);
        if (load64(lo + 24) == 0 && load64(rg + 8) == 0) { fp = fp + 1; }
    }
    if (fM != load64(hi)) { return fM < load64(hi); }
    if (fm != load64(hi + 8)) { return fm < load64(hi + 8); }
    if (fp != load64(hi + 16)) { return fp < load64(hi + 16); }
    # Same M.m.p: a release is above every pre-release of it.
    if (load64(hi + 24) != 0) { return 0; }
    return load64(rg + 24);
}

# 1 when Constraint c opts in to pre-releases of M.m.p: its own version has a
# pre-release on that same major.minor.patch (the npm / Cargo rule). 1.7.0.
fn _nous_ct_pre_on(c, M, m, p): i64 {
    var w = ct_ver(c);
    if (w == 0 || nous_sv_pre(w) == 0) { return 0; }
    if (sv_major(w) != M || sv_minor(w) != m || sv_patch(w) != p) { return 0; }
    return 1;
}

# ---- compound ranges (1.7.1) ------------------------------------------
# A compound constraint is an OR of comparator sets, each an AND of simple
# comparators. Each set is one interval (an intersection of intervals), so the
# versions a constraint takes are a union of intervals: its range set, a vec
# of ranges sorted by lower bound and merged. The npm / Cargo pre-release rule
# applies per set (node-semver: "at least one comparator with the same
# [major, minor, patch] tuple" in that set).

# 1 when SemVer v (not 0) satisfies comparator set `set`: every comparator's
# range holds it, and a pre-release needs one comparator to opt in.
fn _nous_set_admits(set, v): i64 {
    var n = vec_len(set);
    var i = 0;
    while (i < n) {
        var cmp = vec_get(set, i);
        if (load64(cmp) != OP_ANY) {
            if (_nous_range_contains(_nous_range_of(cmp), v) == 0) { return 0; }
        }
        i = i + 1;
    }
    if (load64(v + 24) == 0) { return 1; }
    i = 0;
    while (i < n) {
        if (_nous_ct_pre_on(vec_get(set, i), load64(v), load64(v + 8), load64(v + 16)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when SemVer v satisfies some comparator set of OP_SET constraint c.
fn _nous_set_matches(c, v): i64 {
    if (v == 0) { return 0; }
    var sets = load64(c + 40);
    var i = 0;
    while (i < vec_len(sets)) {
        if (_nous_set_admits(vec_get(sets, i), v) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The comparator sets of any Constraint: an OP_SET's own, or [[c]] for a simple one.
fn _nous_ct_sets_of(c): i64 {
    if (load64(c) == OP_SET) { return load64(c + 40); }
    var one = vec_new();
    vec_push(one, c);
    var sets = vec_new();
    vec_push(sets, one);
    return sets;
}

# The interval of one comparator set (the intersection of its comparators'
# ranges), or 0 when it is empty.
fn _nous_set_range(set): i64 {
    var acc = _nous_range_new(0, 1, 0, 1);
    var i = 0;
    while (i < vec_len(set)) {
        acc = _nous_range_intersect(acc, _nous_range_of(vec_get(set, i)));
        if (acc == 0) { return 0; }
        i = i + 1;
    }
    return acc;
}

# -1 / 0 / 1 ordering two ranges by lower bound (unbounded first; at a tie the
# inclusive bound first).
fn _nous_rg_lo_cmp(a, b): i64 {
    var la = _rg_lo(a);
    var lb = _rg_lo(b);
    if (la == 0 && lb == 0) { return 0; }
    if (la == 0) { return 0 - 1; }
    if (lb == 0) { return 1; }
    var c = semver_cmp(la, lb);
    if (c != 0) { return c; }
    if (_rg_lo_incl(a) == _rg_lo_incl(b)) { return 0; }
    if (_rg_lo_incl(a) == 1) { return 0 - 1; }
    return 1;
}

# Sort the ranges of vec v by lower bound and merge overlapping or touching
# ones. Returns a new vec (the input is not changed).
fn _nous_rset_norm(v): i64 {
    var srt = vec_new();
    var i = 0;
    while (i < vec_len(v)) {
        var r = vec_get(v, i);
        var j = vec_len(srt);
        vec_push(srt, r);
        while (j > 0 && _nous_rg_lo_cmp(vec_get(srt, j - 1), r) > 0) {
            vec_set(srt, j, vec_get(srt, j - 1));
            j = j - 1;
        }
        vec_set(srt, j, r);
        i = i + 1;
    }
    var out = vec_new();
    i = 0;
    while (i < vec_len(srt)) {
        var cur = vec_get(srt, i);
        var lo = _rg_lo(cur);
        var lo_i = _rg_lo_incl(cur);
        var hi = _rg_hi(cur);
        var hi_i = _rg_hi_incl(cur);
        var j2 = i + 1;
        var going = 1;
        while (j2 < vec_len(srt) && going == 1) {
            var nx = vec_get(srt, j2);
            # Does nx start at or before cur's end (touching counts when one side is inclusive)?
            var joins = 0;
            if (hi == 0 || _rg_lo(nx) == 0) { joins = 1; }
            else {
                var e = semver_cmp(_rg_lo(nx), hi);
                if (e < 0) { joins = 1; }
                elif (e == 0 && (hi_i == 1 || _rg_lo_incl(nx) == 1)) { joins = 1; }
            }
            if (joins == 1) {
                if (hi != 0) {
                    if (_rg_hi(nx) == 0) { hi = 0; hi_i = 1; }
                    else {
                        var f = semver_cmp(_rg_hi(nx), hi);
                        if (f > 0) { hi = _rg_hi(nx); hi_i = _rg_hi_incl(nx); }
                        elif (f == 0 && _rg_hi_incl(nx) == 1) { hi_i = 1; }
                    }
                }
                j2 = j2 + 1;
            } else {
                going = 0;
            }
        }
        vec_push(out, _nous_range_new(lo, lo_i, hi, hi_i));
        i = j2;
    }
    return out;
}

# The range set of Constraint c: a sorted, merged vec of ranges (empty when it
# takes no version, or has an error). Cached on the constraint.
fn _nous_ct_rset(c): i64 {
    if (load64(c + 48) != 0) { return load64(c + 48); }
    var raw = vec_new();
    if (nous_constraint_error(c) == 0) {
        var sets = _nous_ct_sets_of(c);
        var i = 0;
        while (i < vec_len(sets)) {
            var rg = _nous_set_range(vec_get(sets, i));
            if (rg != 0) { vec_push(raw, rg); }
            i = i + 1;
        }
    }
    var rs = _nous_rset_norm(raw);
    store64(c + 48, rs);
    return rs;
}

# The intersection of two range sets, as a range set.
fn _nous_rset_intersect(a, b): i64 {
    var raw = vec_new();
    var i = 0;
    while (i < vec_len(a)) {
        var j = 0;
        while (j < vec_len(b)) {
            var x = _nous_range_intersect(vec_get(a, i), vec_get(b, j));
            if (x != 0) { vec_push(raw, x); }
            j = j + 1;
        }
        i = i + 1;
    }
    return _nous_rset_norm(raw);
}

# 1 when some range of range set rs holds a release version.
fn _nous_rset_has_release(rs): i64 {
    var i = 0;
    while (i < vec_len(rs)) {
        if (_nous_range_has_release(vec_get(rs, i)) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# 1 when SemVer v lies in some range of range set rs.
fn _nous_rset_contains(rs, v): i64 {
    var i = 0;
    while (i < vec_len(rs)) {
        if (_nous_range_contains(vec_get(rs, i), v) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

# The pre-releases of M.m.p that Constraint c takes, as a range set: the band
# [M.m.p-0, M.m.p) cut by each comparator set that opts in to M.m.p.
fn _nous_ct_pre_band(c, M, m, p): i64 {
    var band = _nous_range_new(nous_semver_new_full(M, m, p, str_from("0"), 0), 1, semver_new(M, m, p), 0);
    var raw = vec_new();
    var sets = _nous_ct_sets_of(c);
    var i = 0;
    while (i < vec_len(sets)) {
        var set = vec_get(sets, i);
        var opt = 0;
        var j = 0;
        while (j < vec_len(set)) {
            if (_nous_ct_pre_on(vec_get(set, j), M, m, p) == 1) { opt = 1; }
            j = j + 1;
        }
        if (opt == 1) {
            var rg = _nous_set_range(set);
            if (rg != 0) {
                var x = _nous_range_intersect(rg, band);
                if (x != 0) { vec_push(raw, x); }
            }
        }
        i = i + 1;
    }
    return _nous_rset_norm(raw);
}

# Check if version v satisfies constraint c. 1.5.3: through the constraint's
# range, so partials and zero-major carets are right and an unsupported
# constraint never matches. 1.7.0: the npm / Cargo pre-release rule. A
# pre-release version matches only when the constraint names a pre-release of
# the same M.m.p, so ">=1.0.0" and "*" do not match 1.1.0-rc.1, while
# ">=1.1.0-rc.1" does. A release version is checked by range alone.
#
# 1 when SemVer v satisfies Constraint c (range, plus the pre-release rule), else 0.
fn constraint_matches(c, v): i64 {
    # Fields read in place (load64): this is the hot path of every check.
    if (load64(c + 24) != 0) { return 0; }
    var op = load64(c);
    if (op == OP_SET) { return _nous_set_matches(c, v); }
    if (v == 0) {
        if (op == OP_ANY) { return 1; }
        return 0;
    }
    if (load64(v + 24) != 0) {
        if (_nous_ct_pre_on(c, load64(v), load64(v + 8), load64(v + 16)) == 0) { return 0; }
    }
    if (op == OP_ANY) { return 1; }
    return _nous_range_contains(_nous_range_of(c), v);
}

# ---- Debian version comparison (1.5.3, decision D2) -------------------
# deb-version(7) / Debian Policy §5.6.12, following dpkg's
# lib/dpkg/version.c (`verrevcmp`). [epoch:]upstream[-revision]: the epoch is
# compared numerically, then upstream, then revision, each by alternating
# non-digit runs (ordered: '~' before everything, even the end; then the end;
# then letters; then other characters) and digit runs (numerically).

fn _nous_isdig(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn _nous_deb_order(c): i64 {
    if (c >= 48 && c <= 57) { return 0; }
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return c; }
    if (c == 126) { return 0 - 1; }
    if (c != 0) { return c + 256; }
    return 0;
}

# dpkg's verrevcmp over byte ranges [a, a+al) and [b, b+bl).
fn _nous_verrevcmp(a, al, b, bl): i64 {
    var i = 0;
    var j = 0;
    while (i < al || j < bl) {
        var first_diff = 0;
        while ((i < al && _nous_isdig(load8(a + i)) == 0) || (j < bl && _nous_isdig(load8(b + j)) == 0)) {
            var ac = 0;
            if (i < al) { ac = _nous_deb_order(load8(a + i)); }
            var bc = 0;
            if (j < bl) { bc = _nous_deb_order(load8(b + j)); }
            if (ac != bc) { return ac - bc; }
            i = i + 1;
            j = j + 1;
        }
        while (i < al && load8(a + i) == 48) { i = i + 1; }
        while (j < bl && load8(b + j) == 48) { j = j + 1; }
        while (i < al && j < bl && _nous_isdig(load8(a + i)) == 1 && _nous_isdig(load8(b + j)) == 1) {
            if (first_diff == 0) { first_diff = load8(a + i) - load8(b + j); }
            i = i + 1;
            j = j + 1;
        }
        if (i < al && load8(a + i) >= 48 && load8(a + i) <= 57) { return 1; }
        if (j < bl && load8(b + j) >= 48 && load8(b + j) <= 57) { return 0 - 1; }
        if (first_diff != 0) { return first_diff; }
    }
    return 0;
}

# Split a Debian version Str: out+0 epoch (number), out+8/16 upstream
# start/length, out+24/32 revision start/length (0 length when absent).
fn _nous_deb_split(s, out): i64 {
    var d = str_data(s);
    var n = str_len(s);
    var colon = str_index_of(s, 58);
    var epoch = 0;
    var us = 0;
    if (colon > 0) {
        var k = 0;
        while (k < colon && load8(d + k) >= 48 && load8(d + k) <= 57) {
            if (epoch < 92233720368547758) { epoch = epoch * 10 + load8(d + k) - 48; }
            k = k + 1;
        }
        us = colon + 1;
    }
    var dash = 0 - 1;
    var k2 = n - 1;
    while (k2 >= us && dash < 0) {
        if (load8(d + k2) == 45) { dash = k2; }
        k2 = k2 - 1;
    }
    store64(out, epoch);
    store64(out + 8, d + us);
    if (dash >= 0) {
        store64(out + 16, dash - us);
        store64(out + 24, d + dash + 1);
        store64(out + 32, n - dash - 1);
    } else {
        store64(out + 16, n - us);
        store64(out + 24, d);
        store64(out + 32, 0);
    }
    return 0;
}

# 1.5.3: nous compared these as SemVer, missing revision-only security updates
# (7.81.0-1ubuntu1.16 vs .15), '~' pre-releases and letter suffixes (0.9.8zh),
# and offering an epoch downgrade (2.0-1 over 1:1.0-1).
#
# Compare two Debian version strings: negative / 0 / positive (deb-version(7)).
fn nous_deb_version_cmp(a, b): i64 {
    var pa = alloc(40);
    var pb = alloc(40);
    _nous_deb_split(a, pa);
    _nous_deb_split(b, pb);
    if (load64(pa) != load64(pb)) {
        if (load64(pa) < load64(pb)) { return 0 - 1; }
        return 1;
    }
    var u = _nous_verrevcmp(load64(pa + 8), load64(pa + 16), load64(pb + 8), load64(pb + 16));
    if (u != 0) { return u; }
    return _nous_verrevcmp(load64(pa + 24), load64(pa + 32), load64(pb + 24), load64(pb + 32));
}

# A SemVer bound as a Debian-comparable string: trailing zero parts dropped
# ("2.36.0" -> "2.36", "3.0.0" -> "3"), so "2.36-9" >= bound 2.36.0 holds.
fn _nous_bound_deb_str(v): i64 {
    var sb = str_builder_new();
    str_builder_add_int(sb, sv_major(v));
    if (sv_minor(v) != 0 || sv_patch(v) != 0) {
        str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, sv_minor(v));
    }
    if (sv_patch(v) != 0) {
        str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, sv_patch(v));
    }
    # 1.7.0: a SemVer pre-release bound is written the Debian way, after '~',
    # which sorts before the release (deb-version(7)): 1.0.0-rc.1 -> "1~rc.1".
    if (nous_sv_pre(v) != 0) {
        str_builder_add_cstr(sb, "~");
        str_builder_add(sb, nous_sv_pre(v));
    }
    return str_builder_build(sb);
}

# 1 when version STRING `ver` of a package from `src` lies in range `rg`: apt
# and community versions compare as Debian versions, the rest as SemVer.
fn _nous_range_contains_ver(rg, ver, src): i64 {
    if (rg == 0) { return 0; }
    if (src == SOURCE_SYSTEM || src == SOURCE_COMMUNITY) {
        if (_rg_lo(rg) != 0) {
            var a = nous_deb_version_cmp(ver, _nous_bound_deb_str(_rg_lo(rg)));
            if (a < 0 || (a == 0 && _rg_lo_incl(rg) == 0)) { return 0; }
        }
        if (_rg_hi(rg) != 0) {
            var b = nous_deb_version_cmp(ver, _nous_bound_deb_str(_rg_hi(rg)));
            if (b > 0 || (b == 0 && _rg_hi_incl(rg) == 0)) { return 0; }
        }
        return 1;
    }
    return _nous_range_contains(rg, semver_parse(ver));
}

# 1 when version Str ver satisfies Constraint ct for a package from src: by
# range in Debian order for apt and community, and by constraint_matches
# (SemVer, with the pre-release rule) otherwise. 1.7.0.
fn _nous_ct_admits_ver(ct, ver, src): i64 {
    if (src == SOURCE_SYSTEM || src == SOURCE_COMMUNITY) {
        # 1.7.1: any range of the constraint's range set (one for a simple one).
        if (nous_constraint_error(ct) != 0) { return 0; }
        var rs = _nous_ct_rset(ct);
        var i = 0;
        while (i < vec_len(rs)) {
            if (_nous_range_contains_ver(vec_get(rs, i), ver, src) == 1) { return 1; }
            i = i + 1;
        }
        return 0;
    }
    return constraint_matches(ct, semver_parse(ver));
}
