[package]
name = "nous"
version = "${file:VERSION}"
description = "nous — package resolver for AGNOS (system, marketplace, Flutter)"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/nous"
language = "cyrius"
cyrius = "6.7.18"

[build]
entry = "src/main.cyr"
output = "build/nous"

# `cyrius distlib` reads this section to build dist/nous.cyr — nous's
# single-file, consumer-facing artifact (ark consumes it; see roadmap
# 1.2.3). Order matches src/nous.cyr's barrel includes; each module may
# reference symbols defined earlier. The bundle concatenates these src
# files behind a compile-verified `# Requires` block of
# `include "lib/<leaf>.cyr"` lines (cyrius 6.6.18+). Stdlib CONTENT is
# still NOT bundled; the consumer vendors those leaves (`cyrius deps`
# reads dist/nous.deps). The leaves are whatever distlib's compile-verify
# proves the bundle needs, NOT the `[deps] stdlib` list below, which also
# carries the tests'/smoke binary's leaves (assert, bench, args, ...).
#
# IMPORTANT: keep `modules` under `[lib]`, NOT `[build]`. 5.7.x+ treats
# `[build].modules` as an auto-prepend list and inlines every src file
# ahead of the entry source, which then re-includes them via its own
# include directives — producing duplicate-fn warnings and a ~38% larger
# binary. nous removed `[build] modules` at 1.1.2 for exactly this reason.
[lib]
modules = [
    "src/types.cyr",
    "src/util.cyr",
    "src/error.cyr",
    "src/strategy.cyr",
    "src/source.cyr",
    "src/command.cyr",
    "src/sort.cyr",
    "src/registry.cyr",
    "src/sysdb.cyr",
    "src/resolver.cyr",
    "src/json.cyr",
    "src/version.cyr",
    "src/graph.cyr",
    "src/recipe.cyr",
    "src/updates.cyr",
]

[deps]
stdlib = [
    "string",
    "fmt",
    "alloc",
    "vec",
    "str",
    "syscalls",
    "io",
    "args",
    "assert",
    "hashmap",
    "fs",
    "tagged",
    "process",
    "bench",
    "fnptr",
    "mmap",     # 1.5.3: tests/fz_driver.cyr's shared page (cyr_mmap); test-only in practice
]

# bayan's flat-TOML profile alone, not the whole stdlib `bayan` fold. nous
# uses only bayan's section/pair records (`bayan_toml_section_*`,
# `bayan_toml_pair_*`), which nous's own CYML parser builds. The full fold
# (bayan 1.11.1, folded into cyrius 6.7.18) carries every format plus ~330 KB
# of Unicode tables that DCE cannot drop, taking the release binary from
# 58,504 to 406,296 B (1.5.1). bayan-toml needs only alloc/str/vec/hashseed/
# string/io/result/syscalls (its dist/bayan-toml.deps). Same shape as
# samay/shravan/mihi pulling `dist/bayan-json.cyr`.
#
# 1.5.3 (decision D7): plus the JSON profile, `dist/bayan-json.cyr`. Manifests
# and nous's own *_from_json now go through bayan's real parser, not nous's
# hand-rolled field scanners. Those took the first `"name"` anywhere, including
# inside a nested object, so `{"author":{"name":"mallory"},"name":"real"}` read
# as mallory. They never decoded escapes, and they read past a trailing `\`.
# The two profiles declare no name in common.
[deps.bayan]
git = "https://github.com/MacCracken/bayan.git"
tag = "1.11.1"
modules = ["dist/bayan-toml.cyr", "dist/bayan-json.cyr"]

# Distribution manifest. Single binary today (`nous`); release.yml
# packages the x86_64 build. Kept declarative so future tooling
# (`cyrius package`, ark) reads from one source instead of
# release.yml.
[release]
bins = ["nous"]
