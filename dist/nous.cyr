# nous/error — error constructors, display, validation
# ===================================================================
# Error constructors
# ===================================================================

# Err(NousError{kind, msg, detail}): the one way nous builds an error Result.
fn nous_err(kind, msg, detail): Result {
    return Err(nous_error_new(kind, msg, detail));
}
# Err(NOUS_ERR_REGISTRY_IO) for registry path `path` (Str) with detail Str.
fn err_registry_io(path, detail): Result { return nous_err(NOUS_ERR_REGISTRY_IO, path, detail); }
# Err(NOUS_ERR_INVALID_PACKAGE_NAME) for `name` (Str) with reason Str.
fn err_invalid_name(name, reason): Result { return nous_err(NOUS_ERR_INVALID_PACKAGE_NAME, name, reason); }

# Join a vec of Str names with " -> " (the cycle report text).
fn format_cycle(cycle): i64 {
    var sb = str_builder_new();
    var i = 0;
    while (i < vec_len(cycle)) {
        if (i > 0) { str_builder_add_cstr(sb, " -> "); }
        str_builder_add(sb, vec_get(cycle, i));
        i = i + 1;
    }
    return str_builder_build(sb);
}

# Human-readable, actionable message (Str) for a NousError, one branch per ErrKind.
fn nous_error_msg(e): i64 {
    var kind = ne_kind(e);
    var msg = ne_msg(e);
    var detail = ne_detail(e);
    var sb = str_builder_new();
    if (kind == NOUS_ERR_COMMAND_EXEC) {
        str_builder_add_cstr(sb, "failed to run `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "`: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_REGISTRY_IO) {
        str_builder_add_cstr(sb, "registry I/O error at `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "`: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_INVALID_MANIFEST) {
        str_builder_add_cstr(sb, "invalid manifest at `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "`: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_INVALID_PACKAGE_NAME) {
        str_builder_add_cstr(sb, "invalid package name `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "`: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_INVALID_VERSION_CONSTRAINT) {
        str_builder_add_cstr(sb, "invalid version constraint `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "`: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_DEPENDENCY_CYCLE) {
        str_builder_add_cstr(sb, "dependency cycle detected: ");
        str_builder_add(sb, msg);
    } elif (kind == NOUS_ERR_VERSION_CONFLICT) {
        str_builder_add_cstr(sb, "version conflict for `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "`: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_NOT_FOUND) {
        str_builder_add_cstr(sb, "package `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "` not found: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    } elif (kind == NOUS_ERR_AMBIGUOUS_SOURCE) {
        str_builder_add_cstr(sb, "package `");
        str_builder_add(sb, msg);
        str_builder_add_cstr(sb, "` exists in more than one source: ");
        if (detail != 0) { str_builder_add(sb, detail); }
    }
    return str_builder_build(sb);
}

# A copy of NousError e (kind, msg, detail), the record error_kind_to_json writes.
fn nous_error_to_kind(e): i64 {
    return nous_error_new(ne_kind(e), ne_msg(e), ne_detail(e));
}

# ===================================================================
# Package name validation
# ===================================================================

# 1 when byte c may appear in a package name: [A-Za-z0-9] or one of - _ . / @ +.
fn is_valid_name_char(c): i64 {
    if (c >= 97 && c <= 122) { return 1; }
    if (c >= 65 && c <= 90) { return 1; }
    if (c >= 48 && c <= 57) { return 1; }
    if (c == 45 || c == 95 || c == 46 || c == 47 || c == 64 || c == 43) { return 1; }
    return 0;
}

# Ok when Str name is a valid package name, else Err(NOUS_ERR_INVALID_PACKAGE_NAME) saying why.
fn validate_package_name(name): Result {
    if (str_len(name) == 0) {
        return err_invalid_name(name, str_from("package name cannot be empty"));
    }
    var trimmed = str_trim(name);
    if (str_len(trimmed) != str_len(name)) {
        return err_invalid_name(name, str_from("package name cannot have leading or trailing whitespace"));
    }
    # 1.5.3 (P1, security): a leading '-' would reach apt-cache / dpkg-query as an
    # OPTION. Proven on Debian 12: `apt-cache show -c/tmp/evil.conf` loads the
    # file as apt config (forged Dir::State::lists), so an installed marketplace
    # package could ship one and name it as a dependency. No real package name
    # starts with '-' (Debian Policy §5.6.1: names start with an alphanumeric).
    if (load8(str_data(name)) == 45) {
        return err_invalid_name(name, str_from("package name cannot start with '-'"));
    }
    var d = str_data(name);
    var len = str_len(name);
    var i = 0;
    while (i < len) {
        var c = load8(d + i);
        if (is_valid_name_char(c) == 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "invalid character '");
            var ch = alloc(2);
            store8(ch, c);
            store8(ch + 1, 0);
            str_builder_add_cstr(sb, ch);
            str_builder_add_cstr(sb, "'");
            return err_invalid_name(name, str_builder_build(sb));
        }
        i = i + 1;
    }
    return Ok(1);
}

# --- strategy.cyr ---

# nous/strategy — resolution strategy constructors
# ===================================================================
# Strategy
# ===================================================================

# Strategy: marketplace first, then system (STRAT_MARKETPLACE_FIRST).
fn strategy_default(): i64 { return strategy_new(STRAT_MARKETPLACE_FIRST, 0); }
# Strategy: system (apt) first, then marketplace (STRAT_SYSTEM_FIRST).
fn strategy_system_first(): i64 { return strategy_new(STRAT_SYSTEM_FIRST, 0); }
# Strategy: resolve from PackageSource src only (STRAT_ONLY_SOURCE).
fn strategy_only(src): i64 { return strategy_new(STRAT_ONLY_SOURCE, src); }
# Strategy: query every source; a name found in two is NOUS_ERR_AMBIGUOUS_SOURCE.
fn strategy_search_all(): i64 { return strategy_new(STRAT_SEARCH_ALL, 0); }

# 1 when Strategies a and b are equal (kind, plus the source for STRAT_ONLY_SOURCE).
fn strategy_eq(a, b): i64 {
    if (st_kind(a) != st_kind(b)) { return 0; }
    if (st_kind(a) == STRAT_ONLY_SOURCE) { return st_only(a) == st_only(b); }
    return 1;
}

# --- source.cyr ---

# nous/source — source display, detection, typo suggestions
# ===================================================================
# Source display
# ===================================================================

# Display name (Str) of a PackageSource: system, marketplace, flutter-app, community, unknown.
fn source_to_str(src): i64 {
    if (src == SOURCE_SYSTEM) { return str_from("system"); }
    if (src == SOURCE_MARKETPLACE) { return str_from("marketplace"); }
    if (src == SOURCE_FLUTTER_APP) { return str_from("flutter-app"); }
    if (src == SOURCE_COMMUNITY) { return str_from("community"); }
    return str_from("unknown");
}

# ===================================================================
# Source detection
# ===================================================================

# 1 when the `n` bytes at `d` are exactly the `ln`-byte literal `lit`.
fn _nous_seg_is(d, n, lit, ln): i64 {
    if (n != ln) { return 0; }
    return memeq(d, lit, ln);
}

# Heuristic source from the name's shape. Precedence: a '/' anywhere means
# marketplace ("publisher/name"); a ".flutter" suffix, or a reverse-DNS name
# with 2+ dots and a known first label (com., org., net., io., dev., app., me.),
# means a Flutter app; anything else is unknown.
#
# 1.5.3: no allocation. It used to build a Str for every literal it compared
# against (8 `str_from` calls plus a `str_sub` per call). Now it makes one pass
# over the bytes and compares in place with `memeq`. Same results (test
# `detect_source`, the smoke checks, `fuzz_detect`).
#
# Heuristic PackageSource from the shape of Str name: marketplace, Flutter app, or unknown.
fn detect_source(name): i64 {
    var len = str_len(name);
    if (len == 0) { return SOURCE_UNKNOWN; }
    var d = str_data(name);
    var dots = 0;
    var first_dot = 0 - 1;
    var i = 0;
    while (i < len) {
        var c = load8(d + i);
        if (c == 47) { return SOURCE_MARKETPLACE; }
        if (c == 46) {
            if (first_dot < 0) { first_dot = i; }
            dots = dots + 1;
        }
        i = i + 1;
    }
    if (len >= 8 && memeq(d + len - 8, ".flutter", 8) == 1) { return SOURCE_FLUTTER_APP; }
    if (dots >= 2 && first_dot > 0) {
        if (_nous_seg_is(d, first_dot, "com", 3) == 1) { return SOURCE_FLUTTER_APP; }
        if (_nous_seg_is(d, first_dot, "org", 3) == 1) { return SOURCE_FLUTTER_APP; }
        if (_nous_seg_is(d, first_dot, "net", 3) == 1) { return SOURCE_FLUTTER_APP; }
        if (_nous_seg_is(d, first_dot, "io", 2) == 1) { return SOURCE_FLUTTER_APP; }
        if (_nous_seg_is(d, first_dot, "dev", 3) == 1) { return SOURCE_FLUTTER_APP; }
        if (_nous_seg_is(d, first_dot, "app", 3) == 1) { return SOURCE_FLUTTER_APP; }
        if (_nous_seg_is(d, first_dot, "me", 2) == 1) { return SOURCE_FLUTTER_APP; }
    }
    return SOURCE_UNKNOWN;
}

# ===================================================================
# Typo suggestion engine (Levenshtein distance)
# ===================================================================

# Unit-cost byte-wise edit distance between Strs a and b (Wagner-Fischer, two rows).
fn levenshtein(a, b): i64 {
    var al = str_len(a);
    var bl = str_len(b);
    var ad = str_data(a);
    var bd = str_data(b);
    if (al == 0) { return bl; }
    if (bl == 0) { return al; }
    # Two-row approach: prev_row and curr_row, each (bl+1) entries
    var prev = alloc((bl + 1) * 8);
    var curr = alloc((bl + 1) * 8);
    var j = 0;
    while (j <= bl) { store64(prev + j * 8, j); j = j + 1; }
    var i = 0;
    while (i < al) {
        store64(curr, i + 1);
        j = 0;
        while (j < bl) {
            var cost = 1;
            if (load8(ad + i) == load8(bd + j)) { cost = 0; }
            var del = load64(prev + (j + 1) * 8) + 1;
            var ins = load64(curr + j * 8) + 1;
            var sub = load64(prev + j * 8) + cost;
            var best = del;
            if (ins < best) { best = ins; }
            if (sub < best) { best = sub; }
            store64(curr + (j + 1) * 8, best);
            j = j + 1;
        }
        # Swap prev and curr
        var tmp = prev;
        prev = curr;
        curr = tmp;
        i = i + 1;
    }
    return load64(prev + bl * 8);
}

# Find the closest matching package name from a list.
# Returns the best match Str, or 0 if nothing is close enough (distance > 3).
fn suggest_package(name, known_names): i64 {
    var best = 0;
    var best_dist = 4;
    var i = 0;
    while (i < vec_len(known_names)) {
        var candidate = vec_get(known_names, i);
        var dist = levenshtein(name, candidate);
        if (dist < best_dist) {
            best_dist = dist;
            best = candidate;
        }
        i = i + 1;
    }
    return best;
}

# Build suggestion message: "Package 'ngins' not found. Did you mean 'nginx'?"
fn build_suggestion(name, suggestion): i64 {
    if (suggestion == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "package '");
    str_builder_add(sb, name);
    str_builder_add_cstr(sb, "' not found. Did you mean '");
    str_builder_add(sb, suggestion);
    str_builder_add_cstr(sb, "'?");
    return str_builder_build(sb);
}

# Collect all known package names from resolver sources.
fn collect_known_names(r): i64 {
    var names = vec_new();
    # From marketplace registry
    var pkgs = rg_pkgs(rs_reg(r));
    var i = 0;
    while (i < vec_len(pkgs)) {
        var pk = vec_get(pkgs, i);
        vec_push(names, mpkg_name(pk));
        i = i + 1;
    }
    # From recipe DB if attached
    if (rs_rdb(r) != 0) {
        var rkeys = _nous_sorted_keys(rdb_recipes(rs_rdb(r)));
        i = 0;
        while (i < vec_len(rkeys)) {
            var rk = vec_get(rkeys, i);
            vec_push(names, str_from(rk));
            i = i + 1;
        }
    }
    return names;
}

# --- command.cyr ---

# nous/command — command execution, PATH scanning
# ===================================================================
# Command execution
# ===================================================================

# Child-output capture (1.5.1). The pre-1.5.1 capture had two defects, both
# reproduced before this fix:
#
#   TRUNCATION. Every capture read into one fixed 65,536-byte buffer. The
#   stdlib's `exec_capture` stops at its buffer length, and a full buffer reads
#   the same as EOF, so longer output was cut with no error: a 200,000-byte
#   output came back as 65,536 bytes. `sysdb_list` runs `dpkg-query -W` over
#   the whole system, which passes 64 KiB at roughly 1,500 packages.
#
#   ALIASING. The result was `str_new(cmd_buf, n)`, and `str_new` / `str_sub` /
#   `str_trim` / `str_split` make VIEWS, not copies. So every Str a capture
#   returned (package names, versions, descriptions) pointed into the one
#   shared buffer, and the next capture overwrote it: after
#   `a = cmd_run("echo hello"); b = cmd_run("echo WORLD");`, `a` read "WORLD".
#
# Now each run reads up to `cap + 1` bytes. Reading more than `cap` means the
# output did not fit, so the command re-runs with double the room, up to
# `max`. Output that still does not fit, or a run the stdlib's idle deadline
# cut short (`proc_set_timeout_ms`), is an `Err` and never a partial result.
# A complete capture is copied out (`str_clone`), so later captures cannot
# change it. A re-run is safe because nous captures read-only queries only
# (apt-cache, dpkg-query, `apt list`).

var NOUS_CAPTURE_INIT = 65536;
var NOUS_CAPTURE_MAX = 16777216;
# Idle deadline nous applies when the caller set none (1.5.3); 0 disables it.
var NOUS_CAPTURE_IDLE_MS = 60000;

# Scratch buffer, shared by every capture. Grown, never shrunk. Results are
# copied out of it, so reusing it is safe.
var _nous_cap_buf = 0;
var _nous_cap_size = 0;

fn _nous_cap_reserve(n): i64 {
    if (_nous_cap_size < n) {
        var b = alloc(n);
        if (b == 0) { return 0; }
        _nous_cap_buf = b;
        _nous_cap_size = n;
    }
    return _nous_cap_buf;
}

# The command as one line ("apt-cache search --names-only foo") for the error.
fn _nous_cap_cmdline(args): i64 {
    var sb = str_builder_new();
    var i = 0;
    while (i < vec_len(args)) {
        if (i > 0) { str_builder_add_cstr(sb, " "); }
        str_builder_add_cstr(sb, vec_get(args, i));
        i = i + 1;
    }
    return str_builder_build(sb);
}

fn _nous_cap_fail(args, detail): Result {
    return nous_err(NOUS_ERR_COMMAND_EXEC, _nous_cap_cmdline(args), str_from(detail));
}

fn _nous_cap_overflow(args, max): Result {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "output exceeds the ");
    str_builder_add_int(sb, max);
    str_builder_add_cstr(sb, "-byte capture limit");
    return nous_err(NOUS_ERR_COMMAND_EXEC, _nous_cap_cmdline(args), str_builder_build(sb));
}

# Run `args` (a vec of cstr; args[0] an absolute path, since the child gets an
# empty environment) and capture all of stdout. The buffer starts at `init`
# bytes and doubles up to `max`.
#   Ok(Str)  the complete output, an owned copy
#   Ok(0)    no output (including a command that could not start: the
#            pre-1.5.1 contract, which callers read as "nothing found")
#   Err(e)   NOUS_ERR_COMMAND_EXEC: the output did not fit in `max` bytes, or
#            the idle deadline cut the run short
#
# Idle deadline (1.5.3): when the caller has set none (proc_timeout_ms() == 0,
# the stdlib default, which waits forever), nous applies NOUS_CAPTURE_IDLE_MS
# around its own runs and then restores 0. A hung apt-cache / dpkg-query used to
# block the caller indefinitely. A caller's own non-zero deadline always wins.
# Set NOUS_CAPTURE_IDLE_MS = 0 to turn the default off.
#
# Ok(Str) all stdout of argv `args` (init..max byte buffer), Ok(0) for none; Err past max or on a deadline cut.
fn nous_capture_n(args, init, max): Result {
    var prev = proc_timeout_ms();
    var applied = 0;
    if (prev == 0 && NOUS_CAPTURE_IDLE_MS > 0) {
        proc_set_timeout_ms(NOUS_CAPTURE_IDLE_MS);
        applied = 1;
    }
    var t, v = _nous_capture_run(args, init, max);
    if (applied == 1) { proc_set_timeout_ms(prev); }
    if (is_err_result(t) == 1) { return Err(v); }
    return Ok(v);
}

fn _nous_capture_run(args, init, max): Result {
    var st[16];
    var cap = init;
    if (cap > max) { cap = max; }
    if (cap < 1) { cap = 1; }
    while (cap <= max) {
        var buf = _nous_cap_reserve(cap + 1);
        if (buf == 0) { return _nous_cap_fail(args, "out of memory for the capture buffer"); }
        var n = exec_capture_status(args, buf, cap + 1, &st);
        if (load64(&st) == 0 - 2) {
            return _nous_cap_fail(args, "cut short by the idle deadline (proc_set_timeout_ms)");
        }
        if (n <= cap) {
            if (n <= 0) { return Ok(0); }
            return Ok(str_clone(str_new(buf, n)));
        }
        if (cap >= max) { return _nous_cap_overflow(args, max); }
        cap = cap * 2;
        if (cap > max) { cap = max; }
    }
    return _nous_cap_overflow(args, max);
}

# nous_capture_n with the default limits. It starts from the scratch buffer's
# current size, so a command that once needed more room does not re-run next
# time.
#
# Ok(Str) all stdout of argv `args`, Ok(0) for none; nous_capture_n with the default limits.
fn nous_capture(args): Result {
    var init = NOUS_CAPTURE_INIT;
    if (_nous_cap_size - 1 > init) { init = _nous_cap_size - 1; }
    return nous_capture_n(args, init, NOUS_CAPTURE_MAX);
}

# Run a shell command line (`/bin/sh -c`) and capture all of stdout: same
# results as `nous_capture`.
#
# Ok(Str) all stdout of `/bin/sh -c cmd_str`, Ok(0) for none; Err as nous_capture.
fn nous_cmd_capture(cmd_str): Result {
    var args = vec_new();
    vec_push(args, "/bin/sh");
    vec_push(args, "-c");
    vec_push(args, _nous_cstr(cmd_str));
    return nous_capture(args);
}

# Deprecated (1.5.2), removed in 2.0.0: the output Str, or 0 for no output OR
# any failure. Since 1.5.1 it never truncates and the Str is an owned copy, but
# it still cannot tell "failed" from "said nothing". Its bare name also collides
# with thoth's one-argument `cmd_run(line)` in the flat namespace.
#
# Deprecated: stdout Str of shell line cmd_str, 0 for no output or any failure. Use nous_cmd_capture.
#deprecated("use nous_cmd_capture; cmd_run hides failures and collides with thoth (removed in 2.0.0)")
fn cmd_run(cmd_str): i64 {
    var r_t, r = nous_cmd_capture(cmd_str);
    if (is_err_result(r_t) == 1) { return 0; }
    return r;
}

# 1 if `name` resolves to an existing file on PATH, else 0.
fn nous_which_exists(name): i64 {
    return which_path(name) != 0;
}

# Deprecated (1.5.2), removed in 2.0.0. kavach defines its own one-argument
# `which_exists(name)` with a different lookup, and the flat namespace keeps
# only one of them ("last definition wins").
#
# Deprecated alias of nous_which_exists.
#deprecated("use nous_which_exists; which_exists collides with kavach (removed in 2.0.0)")
fn which_exists(name): i64 {
    return nous_which_exists(name);
}

# sysdb passes the result to exec_capture: its child execve's argv[0]
# directly with an empty envp, so it cannot search PATH itself — a bare
# command name like "dpkg-query" silently fails to launch (child exits
# 127, no output, integration_apt asserts fail in CI). Resolving in the
# parent (which has PATH) and handing the child a full path is the fix.
# See docs/development/issues/0002-sysdb-exec-bare-name-path.md.
#
# 1.5.3 (security): only ABSOLUTE PATH entries are searched, and only a regular
# file the caller may execute is accepted. A relative entry (`.`, an empty
# segment, `bin`) let a binary in the current directory stand in for
# apt-cache. A directory named `apt-cache` was also accepted; it then failed
# to run and read as "no output".
#
# Resolve `name` to its absolute path on PATH (cstr), or 0 if not found.
fn which_path(name): i64 {
    var pe = getenv("PATH");
    if (pe == 0) { return 0; }
    var dirs = str_split(str_from(pe), 58);
    var i = 0;
    while (i < vec_len(dirs)) {
        var dir = vec_get(dirs, i);
        if (str_len(dir) > 0 && load8(str_data(dir)) == 47) {
            var full = _nous_cstr(path_join(dir, str_from(name)));
            if (_nous_is_exec_file(full) == 1) { return full; }
        }
        i = i + 1;
    }
    return 0;
}

# 1 when `cpath` is a regular file the caller may execute (stat + access X_OK).
fn _nous_is_exec_file(cpath): i64 {
    var st[144];
    if (syscall(SYS_STAT, cpath, &st) < 0) { return 0; }
    if ((load32(&st + 24) & 61440) != 32768) { return 0; }   # S_IFREG
    if (sys_access(cpath, 1) != 0) { return 0; }              # X_OK
    return 1;
}

# Absolute path (cstr) of system tool `name` (which_path), or the bare name when it is not on PATH.
fn tool_path(name): i64 {
    var p = which_path(name);
    if (p != 0) { return p; }
    return name;
}

# --- sort.cyr ---

# nous/sort — stable sort of package vecs by name
# ===================================================================
# Sorting
# ===================================================================
#
# 1.5.3: one stable NATURAL merge sort (Knuth, TAOCP Vol. 3 §5.2.4, "Sorting by
# merging", Algorithm N's idea of merging the input's own ascending runs; see
# docs/sources.md) replaces three copies of an O(n²) insertion sort.
#
# Natural, not plain bottom-up, because nous's real inputs are mostly
# pre-sorted. `dpkg-query -W` prints in byte order, and `resolver_list` is a
# sorted marketplace run followed by a sorted system run. A plain merge sort
# lost on those shapes (sorted 2,000: 149 → 532 µs). This one is O(n) on sorted
# input, one merge for two runs, and O(n log n) for random order (the
# registry's directory scan). Measured on 2,000 packages:
#
#   input shape          insertion (≤1.5.2)   natural merge (1.5.3)
#   already sorted       146 µs               127 µs
#   two sorted runs      445 µs               191 µs
#   random order         32 ms                0.74 ms
#
# The order is unchanged, element for element, including ties. Both sorts are
# stable under the same comparator (`str_compare`, byte order). A run boundary
# is a strict descent and the left run wins a tie, so equal names keep their
# input order. `sort_order_identical` in tests/nous.tcyr pins that against a
# reference insertion sort.
#
# Each key is read once into a side array, so `key_fn` runs n times rather
# than O(n log n) times.

fn _nous_sort_by_key(v, key_fn): i64 {
    var n = vec_len(v);
    if (n < 2) { return 0; }
    # Already sorted (dpkg-query output, a registry already sorted on scan):
    # one comparison pass, no allocation.
    var prev = fncall1(key_fn, vec_get(v, 0));
    var i = 1;
    var sorted = 1;
    while (i < n && sorted == 1) {
        var cur = fncall1(key_fn, vec_get(v, i));
        if (str_compare(prev, cur) > 0) { sorted = 0; }
        prev = cur;
        i = i + 1;
    }
    if (sorted == 1) { return 0; }
    var a_it = alloc(n * 8);
    var a_k = alloc(n * 8);
    var b_it = alloc(n * 8);
    var b_k = alloc(n * 8);
    var runs = alloc((n + 1) * 8);
    var nruns_buf = alloc((n + 1) * 8);
    # Out of memory: leave `v` in its (deterministic) input order.
    if (a_it == 0 || a_k == 0 || b_it == 0 || b_k == 0 || runs == 0 || nruns_buf == 0) { return 0 - 1; }
    i = 0;
    while (i < n) {
        var it = vec_get(v, i);
        store64(a_it + i * 8, it);
        store64(a_k + i * 8, fncall1(key_fn, it));
        i = i + 1;
    }
    # Natural runs: maximal non-decreasing stretches. A run boundary is a
    # strict descent, so equal keys stay in one run in input order.
    var nr = 0;
    store64(runs, 0);
    nr = 1;
    i = 1;
    while (i < n) {
        if (str_compare(load64(a_k + (i - 1) * 8), load64(a_k + i * 8)) > 0) {
            store64(runs + nr * 8, i);
            nr = nr + 1;
        }
        i = i + 1;
    }
    store64(runs + nr * 8, n);
    # Merge adjacent runs pairwise until one is left. The left run wins a
    # tie, so the sort is stable.
    while (nr > 1) {
        var out_nr = 0;
        var ri = 0;
        while (ri < nr) {
            var lo = load64(runs + ri * 8);
            var mid = load64(runs + (ri + 1) * 8);
            var hi = mid;
            if (ri + 1 < nr) { hi = load64(runs + (ri + 2) * 8); }
            store64(nruns_buf + out_nr * 8, lo);
            out_nr = out_nr + 1;
            var l = lo;
            var r = mid;
            var o = lo;
            while (o < hi) {
                var take_left = 0;
                if (l < mid) {
                    if (r >= hi) { take_left = 1; }
                    elif (str_compare(load64(a_k + l * 8), load64(a_k + r * 8)) <= 0) { take_left = 1; }
                }
                if (take_left == 1) {
                    store64(b_it + o * 8, load64(a_it + l * 8));
                    store64(b_k + o * 8, load64(a_k + l * 8));
                    l = l + 1;
                } else {
                    store64(b_it + o * 8, load64(a_it + r * 8));
                    store64(b_k + o * 8, load64(a_k + r * 8));
                    r = r + 1;
                }
                o = o + 1;
            }
            ri = ri + 2;
        }
        store64(nruns_buf + out_nr * 8, n);
        var t = a_it;
        a_it = b_it;
        b_it = t;
        t = a_k;
        a_k = b_k;
        b_k = t;
        t = runs;
        runs = nruns_buf;
        nruns_buf = t;
        nr = out_nr;
    }
    i = 0;
    while (i < n) {
        vec_set(v, i, load64(a_it + i * 8));
        i = i + 1;
    }
    return 0;
}

# Stable in-place byte-order sort of a vec of ResolvedPkg by name.
fn sort_resolved(v): i64 { return _nous_sort_by_key(v, &rp_name); }
# Stable in-place byte-order sort of a vec of InstalledPkg by name.
fn sort_installed(v): i64 { return _nous_sort_by_key(v, &ip_name); }
# Stable in-place byte-order sort of a vec of InstalledMPkg by manifest name.
fn sort_mpkg(v): i64 { return _nous_sort_by_key(v, &mpkg_name); }

# The keys of hashmap `m` (cstrs) in byte order. Use this, never raw `map_keys`,
# for anything whose order reaches output.
#
# 1.5.3 (P0-1, determinism): `map_keys` returns keys in hash-slot order, and
# the stdlib seeds the hash from getrandom once per process
# (lib/hashseed.cyr). So the install order, the dependency order, the reported
# cycle, conflict detection and the typo-suggestion tie-break all changed from
# run to run on identical inputs. Measured before the fix: 6 runs gave 6
# different install orders for one graph.
fn _nous_sorted_keys(m): i64 {
    var k = map_keys(m);
    _nous_sort_by_key(k, &str_from);
    return k;
}

fn _nous_str_id(s): i64 { return s; }

# Sort a vec of Strs in byte order, stably (e.g. dir_list entries, whose order
# is the filesystem's).
fn _nous_sort_strs(v): i64 { return _nous_sort_by_key(v, &_nous_str_id); }

# Sort a (small) vec of integers ascending, in place: insertion sort, for
# Tarjan component members, which are a handful of indexes.
fn _nous_sort_ints(v): i64 {
    var n = vec_len(v);
    var i = 1;
    while (i < n) {
        var key = vec_get(v, i);
        var j = i - 1;
        while (j >= 0 && vec_get(v, j) > key) {
            vec_set(v, j + 1, vec_get(v, j));
            j = j - 1;
        }
        vec_set(v, j + 1, key);
        i = i + 1;
    }
    return 0;
}

# --- registry.cyr ---

# nous/registry — marketplace package registry
# ===================================================================
# LocalRegistry
# ===================================================================

# Extract the "dependencies":{...} object from raw JSON into a hashmap.
# Keys are dep names (C strings in map), values are version constraint Strs.
#
# Map cstr name -> constraint Str from the "dependencies" object of raw JSON Str data.
fn json_extract_deps(data): i64 {
    var deps = map_new();
    var d = str_data(data);
    var dl = str_len(data);
    # Find "dependencies"
    var marker = "dependencies";
    var mlen = 12;
    var i = 0;
    while (i < dl) {
        if (load8(d + i) == 34 && i + 1 + mlen + 1 <= dl) {
            if (memeq(d + i + 1, marker, mlen) == 1 && load8(d + i + 1 + mlen) == 34) {
                # Found "dependencies", skip to opening {
                var j = i + 1 + mlen + 1;
                while (j < dl && load8(d + j) != 123) { j = j + 1; }
                if (j >= dl) { return deps; }
                j = j + 1;
                # Parse key:value pairs until }
                while (j < dl && load8(d + j) != 125) {
                    # Skip whitespace/commas
                    while (j < dl) {
                        var c = load8(d + j);
                        if (c != 32 && c != 9 && c != 10 && c != 13 && c != 44) { break; }
                        j = j + 1;
                    }
                    if (j >= dl || load8(d + j) == 125) { break; }
                    # Expect "key"
                    if (load8(d + j) != 34) { break; }
                    j = j + 1;
                    var ks = j;
                    while (j < dl && load8(d + j) != 34) { j = j + 1; }
                    var key_str = str_new(d + ks, j - ks);
                    j = j + 1;
                    # Skip : and whitespace
                    while (j < dl) {
                        var c2 = load8(d + j);
                        if (c2 != 32 && c2 != 9 && c2 != 10 && c2 != 13 && c2 != 58) { break; }
                        j = j + 1;
                    }
                    # Expect "value"
                    if (j < dl && load8(d + j) == 34) {
                        j = j + 1;
                        var vs = j;
                        while (j < dl && load8(d + j) != 34) { j = j + 1; }
                        var val_str = str_new(d + vs, j - vs);
                        j = j + 1;
                        map_set(deps, _nous_cstr(key_str), val_str);
                    }
                }
                return deps;
            }
        }
        i = i + 1;
    }
    return deps;
}

# 1.5.3 (decision D7): parsed with bayan's JSON parser (`manifest_from_json`),
# by structure. nous's scanners took the first `"name"` anywhere, so
# `{"author":{"name":"mallory"},"name":"real"}` read as mallory. A string
# value "dependencies" hijacked the deps scan. Escapes were never decoded. A
# file that is not one JSON object is not a manifest (0).
#
# Manifest from the JSON file at Str file_path (at most NOUS_FILE_MAX bytes), or 0.
fn parse_manifest_file(file_path): i64 {
    # Whole file or nothing (1.5.3): never a half-read prefix.
    var content = _nous_read_file(file_path, NOUS_FILE_MAX);
    if (content == 0) { return 0; }
    return manifest_from_json(content);
}

# Read every <base_dir>/installed/<pkg>/manifest.json; a byte-sorted vec of InstalledMPkg.
fn scan_installed(base_dir): i64 {
    var pkgs = vec_new();
    var idir = path_join(base_dir, str_from("installed"));
    var cd = _nous_cstr(idir);
    if (our_is_dir(cd) == 0) { return pkgs; }
    var entries = dir_list(idir);
    # Byte order (1.5.3), not the filesystem's listing order. With two
    # directories carrying the same manifest name, the first is the one
    # registry_get returns, on every machine.
    _nous_sort_strs(entries);
    var i = 0;
    while (i < vec_len(entries)) {
        var entry = vec_get(entries, i);
        # Reject path traversal: no ".." or "/" in entry names
        if (str_contains(entry, str_from("..")) == 1 ||
          str_index_of(entry, 47) >= 0) {
            i = i + 1;
            continue;
        }
        var pdir = path_join(idir, entry);
        var mpath = path_join(pdir, str_from("manifest.json"));
        var cm = _nous_cstr(mpath);
        # Read directly — no TOCTOU gap from file_exists+read
        var manifest = parse_manifest_file(mpath);
        if (manifest != 0) {
            var sz = dir_size_recursive(pdir);
            var mt = file_mtime(cm);
            vec_push(pkgs, installed_mpkg_new(manifest, sz, pdir, mt));
        }
        i = i + 1;
    }
    sort_mpkg(pkgs);
    return pkgs;
}

# Ok(Registry) over Str base_dir; a missing directory gives an empty registry, not an Err.
fn registry_new(base_dir): Result {
    # A missing marketplace directory is not an error: on a fresh system the
    # marketplace may simply not be provisioned yet. Treat it as an empty
    # registry so resolution can still fall through to the system layer and
    # the recipe DB. (Previously this hard-errored, which forced callers to
    # return a sentinel resolver and then deref a non-error payload — a
    # SIGSEGV on any host without the marketplace dir.)
    if (our_is_dir(_nous_cstr(base_dir)) == 0) {
        return Ok(registry_make(base_dir, vec_new()));
    }
    return Ok(registry_make(base_dir, scan_installed(base_dir)));
}

# InstalledMPkgs whose name or description contains Str query (substring), in byte order.
fn registry_search(reg, query): i64 {
    var results = vec_new();
    var pkgs = rg_pkgs(reg);
    var i = 0;
    while (i < vec_len(pkgs)) {
        var pkg = vec_get(pkgs, i);
        if (str_contains(mpkg_name(pkg), query) == 1 ||
          str_contains(mpkg_desc(pkg), query) == 1) {
            vec_push(results, pkg);
        }
        i = i + 1;
    }
    return results;
}

# The InstalledMPkg named Str name, or 0 when the registry has no such package.
fn nous_registry_get(reg, name): i64 {
    var pkgs = rg_pkgs(reg);
    var i = 0;
    while (i < vec_len(pkgs)) {
        var pkg = vec_get(pkgs, i);
        if (str_eq(mpkg_name(pkg), name) == 1) { return pkg; }
        i = i + 1;
    }
    return 0;
}

# Deprecated (1.5.3), removed in 2.0.0: bote, hoosh, szal and thoth define
# `registry_get` too.
#
# Deprecated alias of nous_registry_get.
#deprecated("use nous_registry_get; registry_get collides with bote/hoosh/szal/thoth (removed in 2.0.0)")
fn registry_get(reg, name): i64 { return nous_registry_get(reg, name); }

# Every InstalledMPkg in the registry, a byte-sorted vec (the registry's own; do not mutate).
fn nous_registry_list(reg): i64 { return rg_pkgs(reg); }
# Deprecated alias of nous_registry_list.
#deprecated("use nous_registry_list; registry_list collides with bote/hoosh/szal/thoth (removed in 2.0.0)")
fn registry_list(reg): i64 { return nous_registry_list(reg); }

# Rescan the registry directory in place, replacing its package list.
fn registry_reload(reg): i64 {
    var dir = rg_dir(reg);
    var new_pkgs = scan_installed(dir);
    store64(reg + 8, new_pkgs);
}

# Stub — real implementation lives in mela. Kept for interface parity.
fn registry_install_package(reg, tarball, dest): Result {
    return Ok(0);
}

# --- sysdb.cyr ---

# nous/sysdb — apt/dpkg system package database
# ===================================================================
# SystemPackageDb
# ===================================================================
#
# 1.5.3 split: each query is now a command (`sysdb_*`) plus a PURE parser
# (`_sysdb_parse_*`) that turns the tool's output into nous records, so parsing
# is unit-tested and fuzzed without apt. Fixed while splitting (each one checked
# on Debian 12):
#
#   - `apt-cache show` prints EVERY available version (2 for libc6), and the
#     loop kept the last, i.e. the oldest, version with the deps of all of them.
#     Now `--no-all-versions` and the first stanza only.
#   - `Pre-Depends` counted for nothing; now it is a dependency like `Depends`.
#   - `python3:any` / `<pkg>:<arch>` deps failed name validation and aborted
#     the whole resolve (most python3-* packages). The qualifier is stripped.
#   - "installed" was a substring test on `${Status}`, so a held package
#     (`hold ok installed`) read as NOT installed and a removed-with-config one
#     (`deinstall ok config-files`) slipped into `get_installed`. Now dpkg's
#     own `${db:Status-Status}` must be `installed`.
#   - Updates came from `apt list --upgradable`. apt(8) says that is not a
#     script interface, and an admin's `APT::Cmd::format` changes its output.
#     Now `apt-get -s dist-upgrade` `Inst` lines (works unprivileged).
#   - The search query is a POSIX regex to apt-cache: `g++` matched 22,782
#     packages, `g\+\+` 114. Metacharacters are escaped.
#   - Only names in Debian Policy §5.6.1 syntax reach apt (see
#     `_sysdb_debian_name`); anything else is not an apt package.
#   - `Installed-Size` (KiB) × 1024 is bounded; it could overflow.
#
# Tools run array-form (no shell) with absolute paths, an empty environment
# (so the C locale), and nous's capture limits and idle deadline.

# SysDb for this host; apt is available when both apt-cache and dpkg-query are on PATH.
fn sysdb_new(): i64 {
    var ok = 0;
    if (nous_which_exists("apt-cache") == 1 && nous_which_exists("dpkg-query") == 1) { ok = 1; }
    return sysdb_make(ok);
}

# 1 when SysDb db can query apt/dpkg; every query returns empty when it is 0.
fn sysdb_available(db): i64 { return sd_apt(db); }

# ---- helpers --------------------------------------------------------

# 1 when `name` is a Debian package name (Policy §5.6.1): at least 2 chars,
# lowercase alphanumeric first, then [a-z0-9+.-]. Anything else (marketplace
# "publisher/x", uppercase, "_", "@", ":") is not an apt package, so it is
# never passed to apt at all.
fn _sysdb_debian_name(name): i64 {
    var n = str_len(name);
    if (n < 2) { return 0; }
    var d = str_data(name);
    var c0 = load8(d);
    if ((c0 < 97 || c0 > 122) && (c0 < 48 || c0 > 57)) { return 0; }
    var i = 1;
    while (i < n) {
        var c = load8(d + i);
        var ok = 0;
        if (c >= 97 && c <= 122) { ok = 1; }
        if (c >= 48 && c <= 57) { ok = 1; }
        if (c == 43 || c == 45 || c == 46) { ok = 1; }
        if (ok == 0) { return 0; }
        i = i + 1;
    }
    return 1;
}

# `q` with POSIX regex metacharacters backslash-escaped, as a cstr.
fn _sysdb_regex_escape(q): i64 {
    var sb = str_builder_new();
    var d = str_data(q);
    var n = str_len(q);
    var i = 0;
    while (i < n) {
        var c = load8(d + i);
        # . + * ? [ ] ( ) { } ^ $ | backslash
        if (c == 46 || c == 43 || c == 42 || c == 63 || c == 91 || c == 93 || c == 40 ||
          c == 41 || c == 123 || c == 125 || c == 94 || c == 36 || c == 124 || c == 92) {
            str_builder_putc(sb, 92);
        }
        str_builder_putc(sb, c);
        i = i + 1;
    }
    return _nous_cstr(str_builder_build(sb));
}

# Installed-Size is KiB. Bytes, saturating instead of overflowing.
fn _sysdb_kib_bytes(skb): i64 {
    if (skb <= 0) { return 0; }
    if (skb > 9007199254740991) { return 9223372036854775807; }   # > (2^63-1)/1024
    return skb * 1024;
}

# Append the package names in a Depends / Pre-Depends value to `deps`. For
# each comma item, keep the first `|` alternative, cut the version relation
# "(>= 2.0)" and an arch qualifier "python3:any", and skip empties.
fn _sysdb_dep_names(value, deps): i64 {
    var items = str_split(value, 44);
    var i = 0;
    while (i < vec_len(items)) {
        var it = vec_get(items, i);
        var bar = str_index_of(it, 124);
        if (bar >= 0) { it = str_sub(it, 0, bar); }
        it = str_trim(it);
        # Cut at the FIRST space / '(' / ':' even at position 0, so a malformed
        # item yields an empty name, which is skipped, never a name holding one
        # (found by tests/fuzz_apt.fcyr, case 2096: ":athon3pyny").
        var sp = str_index_of(it, 32);
        if (sp >= 0) { it = str_sub(it, 0, sp); }
        var par = str_index_of(it, 40);
        if (par >= 0) { it = str_sub(it, 0, par); }
        var colon = str_index_of(it, 58);
        if (colon >= 0) { it = str_sub(it, 0, colon); }
        if (str_len(it) > 0) { vec_push(deps, it); }
        i = i + 1;
    }
    return 0;
}

# The value of "Field: value" when `line` starts with `field` (a cstr ending
# in ": "), else 0.
fn _sysdb_field(line, field): i64 {
    var fl = strlen(field);
    if (str_len(line) < fl) { return 0; }
    if (memeq(str_data(line), field, fl) == 0) { return 0; }
    return str_trim(str_sub(line, fl, str_len(line) - fl));
}

# ---- pure parsers ---------------------------------------------------

# `apt-cache search --names-only` lines: "name - description".
fn _sysdb_parse_search(output): i64 {
    var results = vec_new();
    if (output == 0) { return results; }
    var lines = str_split(output, 10);
    var i = 0;
    while (i < vec_len(lines)) {
        var line = str_trim(vec_get(lines, i));
        if (str_len(line) > 0) {
            var sp = str_find(line, str_from(" - "));
            if (sp > 0) {
                var n = str_trim(str_sub(line, 0, sp));
                var d = str_trim(str_sub(line, sp + 3, str_len(line) - sp - 3));
                vec_push(results, resolved_pkg_new(n, str_from(""), SOURCE_SYSTEM, d, 0, vec_new(), 1));
            }
        }
        i = i + 1;
    }
    return results;
}

# `dpkg-query -W -f '${Package}\t${Version}\t${Installed-Size}\t${db:Status-Status}\n'`
# lines → InstalledPkgs whose status is exactly "installed". A multi-arch
# package prints one line per architecture; only the first is kept.
fn _sysdb_parse_installed(output): i64 {
    var pkgs = vec_new();
    if (output == 0) { return pkgs; }
    var seen = map_new();
    var lines = str_split(output, 10);
    var i = 0;
    while (i < vec_len(lines)) {
        var f = str_split(vec_get(lines, i), 9);
        if (vec_len(f) >= 4) {
            var name = str_trim(vec_get(f, 0));
            var status = str_trim(vec_get(f, 3));
            if (str_len(name) > 0 && str_eq_cstr(status, "installed") == 1) {
                var cn = _nous_cstr(name);
                if (map_has(seen, cn) == 0) {
                    map_set(seen, cn, 1);
                    var skb = str_to_int(str_trim(vec_get(f, 2)));
                    vec_push(pkgs, installed_pkg_new(name, str_trim(vec_get(f, 1)),
                        SOURCE_SYSTEM, 0, _sysdb_kib_bytes(skb), 0));
                }
            }
        }
        i = i + 1;
    }
    return pkgs;
}

# `apt-get -s dist-upgrade` → AvailUpdates from the
# "Inst NAME [OLD] (NEW ARCHIVE [ARCH])" lines. A new install has no "[OLD]",
# is not an update of an installed package, and is skipped.
fn _sysdb_parse_upgrades(output): i64 {
    var upd = vec_new();
    if (output == 0) { return upd; }
    var lines = str_split(output, 10);
    var i = 0;
    while (i < vec_len(lines)) {
        var line = vec_get(lines, i);
        if (str_starts_with(line, str_from("Inst ")) == 1) {
            var rest = str_sub(line, 5, str_len(line) - 5);
            var sp = str_index_of(rest, 32);
            var lb = str_index_of(rest, 91);
            var lp = str_index_of(rest, 40);
            if (sp > 0 && lb == sp + 1 && lp > lb) {
                var name = str_sub(rest, 0, sp);
                var rb = str_index_of(rest, 93);
                if (rb > lb && rb < lp) {
                    var old = str_sub(rest, lb + 1, rb - lb - 1);
                    var after = str_sub(rest, lp + 1, str_len(rest) - lp - 1);
                    var sp2 = str_index_of(after, 32);
                    var nv = after;
                    if (sp2 > 0) { nv = str_sub(after, 0, sp2); }
                    var colon = str_index_of(name, 58);
                    if (colon > 0) { name = str_sub(name, 0, colon); }
                    vec_push(upd, avail_update_new(name, SOURCE_SYSTEM, old, nv, 0));
                }
            }
        }
        i = i + 1;
    }
    return upd;
}

# `apt-cache show --no-all-versions NAME` → a ResolvedPkg from the FIRST
# stanza, or 0 when there is no Version (a purely virtual name).
fn _sysdb_parse_info(name, output): i64 {
    if (output == 0) { return 0; }
    # version / desc hold _sysdb_field's i64 (a Str or 0) until the end, as in
    # recipe_parse_file; initialising them from str_from("") would type them
    # Str and warn on every assignment.
    var version = 0;
    var desc = 0;
    var sz = 0;
    var deps = vec_new();
    var lines = str_split(output, 10);
    var li = 0;
    var go = 1;
    while (li < vec_len(lines) && go == 1) {
        var line = vec_get(lines, li);
        if (str_len(str_trim(line)) == 0) {
            if (version != 0) { go = 0; }                      # end of the first stanza
        } else {
            var v = _sysdb_field(line, "Version: ");
            if (v != 0) { version = v; }
            var dsc = _sysdb_field(line, "Description: ");
            if (dsc == 0 && str_starts_with(line, str_from("Description-")) == 1) {
                var colon = str_index_of(line, 58);
                if (colon > 0) { dsc = str_trim(str_sub(line, colon + 1, str_len(line) - colon - 1)); }
            }
            if (dsc != 0) { desc = dsc; }
            var s = _sysdb_field(line, "Size: ");
            if (s != 0) { sz = str_to_int(s); }
            var dv = _sysdb_field(line, "Depends: ");
            if (dv != 0) { _sysdb_dep_names(dv, deps); }
            var pv = _sysdb_field(line, "Pre-Depends: ");
            if (pv != 0) { _sysdb_dep_names(pv, deps); }
        }
        li = li + 1;
    }
    if (version == 0 || str_len(version) == 0) { return 0; }
    if (desc == 0) { desc = str_from(""); }
    return resolved_pkg_new(name, version, SOURCE_SYSTEM, desc, sz, deps, 1);
}

# `apt-cache show --no-all-versions N1 N2 ...` (one stanza per name apt
# knows; unknown or purely virtual names are simply absent) → a map from
# Package name (cstr) to ResolvedPkg.
fn _sysdb_parse_info_many(output): i64 {
    var out = map_new();
    if (output == 0) { return out; }
    var d = str_data(output);
    var n = str_len(output);
    var start = 0;
    var i = 0;
    while (i <= n) {
        # A stanza ends at a blank line ("\n\n") or at the end of the output.
        var at_end = 0;
        if (i == n) { at_end = 1; }
        elif (load8(d + i) == 10 && i + 1 < n && load8(d + i + 1) == 10) { at_end = 1; }
        if (at_end == 1) {
            if (i > start) {
                var stanza = str_new(d + start, i - start);
                var lines = str_split(stanza, 10);
                var name = 0;
                var li = 0;
                while (li < vec_len(lines) && name == 0) {
                    name = _sysdb_field(vec_get(lines, li), "Package: ");
                    li = li + 1;
                }
                if (name != 0) {
                    var pkg = _sysdb_parse_info(name, stanza);
                    if (pkg != 0) { map_set(out, _nous_cstr(name), pkg); }
                }
            }
            start = i + 2;
            i = i + 2;
        } else {
            i = i + 1;
        }
    }
    return out;
}

# ---- queries --------------------------------------------------------

# Ok(vec of ResolvedPkg): apt packages whose name contains Str query (regex-escaped); Err on capture failure.
fn sysdb_search(db, query): Result {
    if (sd_apt(db) == 0) { return Ok(vec_new()); }
    var vr_t, vr = validate_package_name(query);
    if (is_err_result(vr_t) == 1) { return Ok(vec_new()); }
    var args = vec_new();
    vec_push(args, tool_path("apt-cache"));
    vec_push(args, "search");
    vec_push(args, "--names-only");
    vec_push(args, _sysdb_regex_escape(query));
    var out_t, output = nous_capture(args);
    if (is_err_result(out_t) == 1) { return Err(output); }
    return Ok(_sysdb_parse_search(output));
}

fn _sysdb_dpkg_fmt(): i64 { return "${Package}\t${Version}\t${Installed-Size}\t${db:Status-Status}\n"; }

# Ok(1) when apt package Str name is installed, Ok(0) when not; Err on capture failure.
fn sysdb_is_installed(db, name): Result {
    var t, p = sysdb_get_installed(db, name);
    if (is_err_result(t) == 1) { return Err(p); }
    if (p == 0) { return Ok(0); }
    return Ok(1);
}

# Ok(InstalledPkg) for installed apt package Str name, Ok(0) when not installed; Err on capture failure.
fn sysdb_get_installed(db, name): Result {
    if (sd_apt(db) == 0) { return Ok(0); }
    if (_sysdb_debian_name(name) == 0) { return Ok(0); }
    var args = vec_new();
    vec_push(args, tool_path("dpkg-query"));
    vec_push(args, "-W");
    vec_push(args, "-f");
    vec_push(args, _sysdb_dpkg_fmt());
    vec_push(args, _nous_cstr(name));
    var out_t, output = nous_capture(args);
    if (is_err_result(out_t) == 1) { return Err(output); }
    var pkgs = _sysdb_parse_installed(output);
    if (vec_len(pkgs) == 0) { return Ok(0); }
    return Ok(vec_get(pkgs, 0));
}

# Ok(vec of InstalledPkg): every installed dpkg package, in dpkg-query's order; Err on capture failure.
fn sysdb_list(db): Result {
    if (sd_apt(db) == 0) { return Ok(vec_new()); }
    var args = vec_new();
    vec_push(args, tool_path("dpkg-query"));
    vec_push(args, "-W");
    vec_push(args, "-f");
    vec_push(args, _sysdb_dpkg_fmt());
    var out_t, output = nous_capture(args);
    if (is_err_result(out_t) == 1) { return Err(output); }
    return Ok(_sysdb_parse_installed(output));
}

# Ok(vec of AvailUpdate) from a simulated apt-get dist-upgrade; Err on capture failure.
fn sysdb_updates(db): Result {
    if (sd_apt(db) == 0) { return Ok(vec_new()); }
    var args = vec_new();
    vec_push(args, tool_path("apt-get"));
    vec_push(args, "-s");
    vec_push(args, "-o");
    vec_push(args, "Debug::NoLocking=1");
    vec_push(args, "dist-upgrade");
    var out_t, output = nous_capture(args);
    if (is_err_result(out_t) == 1) { return Err(output); }
    return Ok(_sysdb_parse_upgrades(output));
}

# Most names one `apt-cache show` call is given (1.5.3).
var NOUS_SYSDB_BATCH = 256;

# `sysdb_info` for many names in ONE apt-cache call (1.5.3, perf). apt spends
# ~430 ms loading its cache on every call, and 8 names cost the same as 1
# (measured on Debian 12). Returns Ok(map: cstr name -> ResolvedPkg) holding
# only the names apt knows. A name that is not Debian syntax is never passed.
#
# Ok(map cstr name -> ResolvedPkg) for a vec of apt names in one apt-cache call; Err on capture failure.
fn sysdb_info_many(db, names): Result {
    var out = map_new();
    if (sd_apt(db) == 0) { return Ok(out); }
    var i = 0;
    while (i < vec_len(names)) {
        var args = vec_new();
        vec_push(args, tool_path("apt-cache"));
        vec_push(args, "show");
        vec_push(args, "--no-all-versions");
        var count = 0;
        while (i < vec_len(names) && count < NOUS_SYSDB_BATCH) {
            var nm = vec_get(names, i);
            if (_sysdb_debian_name(nm) == 1) {
                vec_push(args, _nous_cstr(nm));
                count = count + 1;
            }
            i = i + 1;
        }
        if (count > 0) {
            var t, output = nous_capture(args);
            if (is_err_result(t) == 1) { return Err(output); }
            var got = _sysdb_parse_info_many(output);
            var keys = _nous_sorted_keys(got);
            var k = 0;
            while (k < vec_len(keys)) {
                map_set(out, vec_get(keys, k), map_get(got, vec_get(keys, k)));
                k = k + 1;
            }
        }
    }
    return Ok(out);
}

# Ok(ResolvedPkg) for apt package Str name (candidate version), Ok(0) when unknown; Err on capture failure.
fn sysdb_info(db, name): Result {
    if (sd_apt(db) == 0) { return Ok(0); }
    if (_sysdb_debian_name(name) == 0) { return Ok(0); }
    var args = vec_new();
    vec_push(args, tool_path("apt-cache"));
    vec_push(args, "show");
    vec_push(args, "--no-all-versions");
    vec_push(args, _nous_cstr(name));
    var out_t, output = nous_capture(args);
    if (is_err_result(out_t) == 1) { return Err(output); }
    return Ok(_sysdb_parse_info(name, output));
}

# --- resolver.cyr ---

# nous/resolver — main resolver engine
# ===================================================================
# NousResolver
# ===================================================================

# Ok(Resolver) over marketplace dir mkt_dir and cache_dir (Strs), MarketplaceFirst; Err if the registry fails.
fn resolver_new(mkt_dir, cache_dir): Result {
    var rr_t, rr = registry_new(mkt_dir);
    if (is_err_result(rr_t) == 1) { return Err(rr); }
    return Ok(resolver_make(strategy_default(), cache_dir, rr, sysdb_new()));
}

# Set Resolver r's Strategy to strat; returns r.
fn resolver_with_strategy(r, strat): i64 { rs_set_strat(r, strat); return r; }

# ResolvedPkg for InstalledMPkg pkg labelled src: deps byte-sorted, trust 0 (unverified).
fn mpkg_to_resolved(pkg, src): i64 {
    var dk = _nous_sorted_keys(mpkg_deps(pkg));
    var ds = vec_new();
    var i = 0;
    while (i < vec_len(dk)) {
        vec_push(ds, str_from(vec_get(dk, i)));
        i = i + 1;
    }
    # trusted = 0 (1.5.3, decision D9): nothing verifies a marketplace package's
    # signature yet (sigil integration is roadmap 1.9.x), so nous no longer
    # claims it. It was hard-coded to 1, which the 2026-04-16 audit already
    # flagged ("never hard-code trust"). apt packages stay 1: apt verifies its
    # archives.
    return resolved_pkg_new(mpkg_name(pkg), mpkg_version(pkg), src, mpkg_desc(pkg), mp_size(pkg), ds, 0);
}

# The source a registry package reports: SOURCE_FLUTTER_APP when its manifest
# runtime is "flutter", else SOURCE_MARKETPLACE. 1.6.1: the one rule for
# resolve, search and list. `resolver_search` and `resolver_list` used to label
# every registry package marketplace, so a Flutter app that `resolver_resolve`
# called flutter-app showed up as marketplace in search and list.
fn _nous_mkt_src(pkg): i64 {
    var rt = mpkg_runtime(pkg);
    if (rt == 0) { return SOURCE_MARKETPLACE; }
    # Length first, so the common "native" is rejected without str_eq_cstr's
    # strlen of the literal on every package.
    if (str_len(rt) != 7) { return SOURCE_MARKETPLACE; }
    if (memeq(str_data(rt), "flutter", 7) == 1) { return SOURCE_FLUTTER_APP; }
    return SOURCE_MARKETPLACE;
}

# ResolvedPkg for `name` from the registry, labelled by _nous_mkt_src (marketplace / FlutterApp), or 0.
fn resolve_mkt(r, name): i64 {
    var pkg = nous_registry_get(rs_reg(r), name);
    if (pkg == 0) {
        trace_msg(r, "marketplace: ", name, "miss");
        return 0;
    }
    trace_msg(r, "marketplace: ", name, "hit");
    # 1.5.3 (P2): label by runtime. A Flutter app found in the registry was
    # returned as SOURCE_MARKETPLACE, so under MarketplaceFirst, SystemFirst and
    # SearchAll `resolve_flutter` was unreachable, and ark used the marketplace
    # install step for a Flutter app.
    return mpkg_to_resolved(pkg, _nous_mkt_src(pkg));
}

# Ok(ResolvedPkg) for `name` from apt, Ok(0) when apt has none; Err on capture failure.
fn resolve_sys(r, name): Result {
    var result_t, result = sysdb_info(rs_sys(r), name);
    if (is_ok(result_t) == 1 && result != 0) {
        trace_msg(r, "system: ", name, "hit");
    } else {
        trace_msg(r, "system: ", name, "miss");
    }
    # Re-emit BOTH halves: a bare `return result;` would hand the caller the
    # payload as its TAG, so a propagated Err would read as Ok.
    if (is_err_result(result_t) == 1) { return Err(result); }
    return Ok(result);
}

# ResolvedPkg (FlutterApp) for a Flutter-runtime marketplace package `name`, or 0.
fn resolve_flutter(r, name): i64 {
    var pkg = nous_registry_get(rs_reg(r), name);
    if (pkg == 0) {
        trace_msg(r, "flutter: ", name, "miss");
        return 0;
    }
    if (_nous_mkt_src(pkg) == SOURCE_FLUTTER_APP) {
        trace_msg(r, "flutter: ", name, "hit");
        return mpkg_to_resolved(pkg, SOURCE_FLUTTER_APP);
    }
    trace_msg(r, "flutter: ", name, "miss (not flutter runtime)");
    return 0;
}

# Ok(ResolvedPkg) for one name by the Strategy, Ok(0) when no source has it; Err if invalid/ambiguous.
fn resolver_resolve(r, name): Result {
    var v_t, v = validate_package_name(name);
    if (is_err_result(v_t) == 1) { return Err(v); }
    var k = st_kind(rs_strat(r));

    # resolve_mkt labels a Flutter-runtime package SOURCE_FLUTTER_APP itself
    # (1.5.3), so the old resolve_flutter fallbacks after it were unreachable.
    if (k == STRAT_MARKETPLACE_FIRST) {
        var mp = resolve_mkt(r, name);
        if (mp != 0) { return Ok(mp); }
        return resolve_sys(r, name);
    }
    if (k == STRAT_SYSTEM_FIRST) {
        var sr_t, sr = resolve_sys(r, name);
        if (is_err_result(sr_t) == 1) { return Err(sr); }
        if (sr != 0) { return Ok(sr); }
        return Ok(resolve_mkt(r, name));
    }
    if (k == STRAT_ONLY_SOURCE) {
        var s = st_only(rs_strat(r));
        if (s == SOURCE_SYSTEM) { return resolve_sys(r, name); }
        if (s == SOURCE_MARKETPLACE || s == SOURCE_COMMUNITY) { return Ok(resolve_mkt(r, name)); }
        if (s == SOURCE_FLUTTER_APP) { return Ok(resolve_flutter(r, name)); }
        return Ok(0);
    }
    # SearchAll (1.5.3, decision D5) asks EVERY source, and a name found in more
    # than one is Err(NOUS_ERR_AMBIGUOUS_SOURCE), never a silent pick. It used to
    # be identical to MarketplaceFirst, so a marketplace package named like a
    # system one won without a word.
    if (k == STRAT_SEARCH_ALL) {
        var mp = resolve_mkt(r, name);
        var ss_t, ss = resolve_sys(r, name);
        if (is_err_result(ss_t) == 1) { return Err(ss); }
        if (mp != 0 && ss != 0) {
            var sb = str_builder_new();
            str_builder_add_cstr(sb, "found in ");
            str_builder_add(sb, source_to_str(rp_src(mp)));
            str_builder_add_cstr(sb, " and in system; pick a source with strategy_only()");
            return nous_err(NOUS_ERR_AMBIGUOUS_SOURCE, name, str_builder_build(sb));
        }
        if (mp != 0) { return Ok(mp); }
        return Ok(ss);
    }
    return Ok(0);
}

# Ok(SearchResult): registry then apt matches for Str query, deduped by name, byte-sorted.
fn resolver_search(r, query): Result {
    var results = vec_new();
    var sources = vec_new();
    var seen = map_new();
    # The registry holds marketplace packages and Flutter apps, so both are
    # searched sources (1.6.1): every result's source is in `sr_sources`.
    vec_push(sources, SOURCE_MARKETPLACE);
    vec_push(sources, SOURCE_FLUTTER_APP);
    var mr = registry_search(rs_reg(r), query);
    var i = 0;
    while (i < vec_len(mr)) {
        var mpkg = vec_get(mr, i);
        map_set(seen, _nous_cstr(mpkg_name(mpkg)), 1);
        vec_push(results, mpkg_to_resolved(mpkg, _nous_mkt_src(mpkg)));
        i = i + 1;
    }
    vec_push(sources, SOURCE_SYSTEM);
    var sres_t, sres = sysdb_search(rs_sys(r), query);
    # 1.5.1: a system-leg Err (a capture past NOUS_CAPTURE_MAX, or cut by the
    # idle deadline) is surfaced, not skipped. Skipping returned Ok with the
    # system results silently missing.
    if (is_err_result(sres_t) == 1) { return Err(sres); }
    var sp = sres;
    var j = 0;
    while (j < vec_len(sp)) {
        var pkg = vec_get(sp, j);
        if (map_has(seen, _nous_cstr(rp_name(pkg))) == 0) {
            map_set(seen, _nous_cstr(rp_name(pkg)), 1);
            vec_push(results, pkg);
        }
        j = j + 1;
    }
    sort_resolved(results);
    return Ok(nous_search_result_new(results, sources, vec_len(results)));
}

# Ok(vec of InstalledPkg): registry plus dpkg packages, byte-sorted; Err on capture failure.
fn resolver_list(r): Result {
    var pkgs = vec_new();
    var ml = nous_registry_list(rs_reg(r));
    var i = 0;
    while (i < vec_len(ml)) {
        var mpkg = vec_get(ml, i);
        vec_push(pkgs, installed_pkg_new(mpkg_name(mpkg), mpkg_version(mpkg),
            _nous_mkt_src(mpkg), mp_at(mpkg), mp_size(mpkg), 0));
        i = i + 1;
    }
    var sres_t, sres = sysdb_list(rs_sys(r));
    # 1.5.1: surfaced, not skipped (see resolver_search).
    if (is_err_result(sres_t) == 1) { return Err(sres); }
    var sp = sres;
    var j = 0;
    while (j < vec_len(sp)) { vec_push(pkgs, vec_get(sp, j)); j = j + 1; }
    sort_installed(pkgs);
    return Ok(pkgs);
}

# Ok(vec of AvailUpdate) for apt only (sysdb_updates). See resolver_check_updates for all sources.
fn resolver_updates(r): Result { return sysdb_updates(rs_sys(r)); }
# 1 when the marketplace registry has a package named `name`, else 0.
fn resolver_is_mkt(r, name): i64 { if (nous_registry_get(rs_reg(r), name) != 0) { return 1; } return 0; }

# --- json.cyr ---

# nous/json — JSON serialization and deserialization
# ===================================================================
#
# 1.5.3 (P2 + decision D7):
#   - Every string is written through the stdlib's escaper
#     (`str_builder_add_json_str`): `"`, `\` and control characters. Names,
#     versions, descriptions and dependency keys used to go out raw, so a recipe
#     description `x","trusted":true,"z":"` injected keys and a key ending in
#     `\` made invalid JSON.
#   - Every `*_from_json` parses with bayan's JSON tree parser
#     (`dist/bayan-json.cyr`) and reads EVERY field the matching `*_to_json`
#     writes: numbers, booleans, arrays, null. Before, it pulled a few strings
#     with a scanner that never decoded escapes (`say "hi"` read back as `say `),
#     dropped size / deps / trust / dates, and read past a trailing `\`.
#   - The four public types that had no `*_from_json` now have one: AvailUpdate,
#     SearchResult, AgentInfo, Manifest. That is the CLAUDE.md rule "every public
#     type has JSON serialize + deserialize".
# The wire format is unchanged except for escaping (now valid JSON) and
# SearchResult's new "sources" field.

# JSON string literal (cstr, quotes included) for a PackageSource, e.g. "\"system\"".
fn source_json(src): i64 {
    if (src == SOURCE_SYSTEM) { return "\"system\""; }
    if (src == SOURCE_MARKETPLACE) { return "\"marketplace\""; }
    if (src == SOURCE_FLUTTER_APP) { return "\"flutter-app\""; }
    if (src == SOURCE_COMMUNITY) { return "\"community\""; }
    return "\"unknown\"";
}

# PackageSource for its JSON name (Str, unquoted); SOURCE_UNKNOWN for 0 or an unknown name.
fn source_from_json(s): i64 {
    if (s == 0) { return SOURCE_UNKNOWN; }
    if (str_eq_cstr(s, "system") == 1) { return SOURCE_SYSTEM; }
    if (str_eq_cstr(s, "marketplace") == 1) { return SOURCE_MARKETPLACE; }
    if (str_eq_cstr(s, "flutter-app") == 1) { return SOURCE_FLUTTER_APP; }
    if (str_eq_cstr(s, "community") == 1) { return SOURCE_COMMUNITY; }
    return SOURCE_UNKNOWN;
}

# "true" when v is 1, else "false" (cstr).
fn bool_json(v): i64 {
    if (v == 1) { return "true"; }
    return "false";
}

# ---- writing ----------------------------------------------------------

# A JSON string for Str `s`, escaped; `null` for 0.
fn _nj_put_str(sb, s): i64 {
    if (s == 0) { return str_builder_add_cstr(sb, "null"); }
    return str_builder_add_json_str(sb, s);
}

# `"key":` then the escaped string value.
fn _nj_field_str(sb, key, s): i64 {
    str_builder_add_cstr(sb, key);
    return _nj_put_str(sb, s);
}

# JSON array (Str) of a vec of Str, each element escaped; a 0 (NULL) element is written as null.
fn json_str_vec(v): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[");
    var i = 0;
    while (i < vec_len(v)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        _nj_put_str(sb, vec_get(v, i));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "]");
    return str_builder_build(sb);
}

# ---- reading ----------------------------------------------------------

# The parsed object for `data`, or 0 when it is not a JSON object.
fn _nj_obj(data): i64 {
    if (data == 0) { return 0; }
    var v = bayan_json_v_parse(data);
    if (v == 0 || bayan_json_v_is_obj(v) == 0) { return 0; }
    return v;
}
fn _nj_str(o, key): i64 { return bayan_json_v_str(bayan_json_v_obj_get_by_cstr(o, key)); }
fn _nj_int(o, key): i64 { return bayan_json_v_int(bayan_json_v_obj_get_by_cstr(o, key)); }
fn _nj_bool(o, key): i64 {
    if (bayan_json_v_bool(bayan_json_v_obj_get_by_cstr(o, key)) != 0) { return 1; }
    return 0;
}
fn _nj_or_empty(s): i64 {
    if (s == 0) { return str_from(""); }
    return s;
}
# A vec of the string elements of array `key` (non-strings skipped).
fn _nj_str_vec(o, key): i64 {
    var out = vec_new();
    var a = bayan_json_v_obj_get_by_cstr(o, key);
    if (a == 0 || bayan_json_v_is_arr(a) == 0) { return out; }
    var i = 0;
    while (i < bayan_json_v_arr_len(a)) {
        var s = bayan_json_v_str(bayan_json_v_arr_get(a, i));
        if (s != 0) { vec_push(out, s); }
        i = i + 1;
    }
    return out;
}

# --- ResolvedPkg ---

# JSON object (Str) for a ResolvedPkg; inverse of resolved_from_json.
fn resolved_to_json(pkg): i64 {
    var sb = str_builder_new();
    _nj_field_str(sb, "{\"name\":", rp_name(pkg));
    _nj_field_str(sb, ",\"version\":", rp_ver(pkg));
    str_builder_add_cstr(sb, ",\"source\":");
    str_builder_add_cstr(sb, source_json(rp_src(pkg)));
    _nj_field_str(sb, ",\"description\":", rp_desc(pkg));
    str_builder_add_cstr(sb, ",\"size_bytes\":");
    str_builder_add_int(sb, rp_size(pkg));
    str_builder_add_cstr(sb, ",\"dependencies\":");
    str_builder_add(sb, json_str_vec(rp_deps(pkg)));
    str_builder_add_cstr(sb, ",\"trusted\":");
    str_builder_add_cstr(sb, bool_json(rp_trust(pkg)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn _nj_resolved(o): i64 {
    var name = _nj_str(o, "name");
    if (name == 0) { return 0; }
    return resolved_pkg_new(name, _nj_or_empty(_nj_str(o, "version")),
      source_from_json(_nj_str(o, "source")), _nj_or_empty(_nj_str(o, "description")),
      _nj_int(o, "size_bytes"), _nj_str_vec(o, "dependencies"), _nj_bool(o, "trusted"));
}

# ResolvedPkg from JSON Str data (as resolved_to_json writes); 0 when not a valid object.
fn resolved_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return 0; }
    return _nj_resolved(o);
}

# --- InstalledPkg ---

# JSON object (Str) for an InstalledPkg; inverse of installed_from_json.
fn installed_to_json(pkg): i64 {
    var sb = str_builder_new();
    _nj_field_str(sb, "{\"name\":", ip_name(pkg));
    _nj_field_str(sb, ",\"version\":", ip_ver(pkg));
    str_builder_add_cstr(sb, ",\"source\":");
    str_builder_add_cstr(sb, source_json(ip_src(pkg)));
    str_builder_add_cstr(sb, ",\"install_date\":");
    str_builder_add_int(sb, ip_date(pkg));
    str_builder_add_cstr(sb, ",\"size_bytes\":");
    str_builder_add_int(sb, ip_size(pkg));
    str_builder_add_cstr(sb, ",\"auto_installed\":");
    str_builder_add_cstr(sb, bool_json(ip_auto(pkg)));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# InstalledPkg from JSON Str data (as installed_to_json writes); 0 when invalid or unnamed.
fn installed_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return 0; }
    var name = _nj_str(o, "name");
    if (name == 0) { return 0; }
    return installed_pkg_new(name, _nj_or_empty(_nj_str(o, "version")),
      source_from_json(_nj_str(o, "source")), _nj_int(o, "install_date"),
      _nj_int(o, "size_bytes"), _nj_bool(o, "auto_installed"));
}

# --- AvailUpdate ---

# JSON object (Str) for an AvailUpdate; inverse of update_from_json.
fn update_to_json(u): i64 {
    var sb = str_builder_new();
    _nj_field_str(sb, "{\"name\":", load64(u));
    str_builder_add_cstr(sb, ",\"source\":");
    str_builder_add_cstr(sb, source_json(load64(u + 8)));
    _nj_field_str(sb, ",\"installed_version\":", load64(u + 16));
    _nj_field_str(sb, ",\"available_version\":", load64(u + 24));
    _nj_field_str(sb, ",\"changelog\":", load64(u + 32));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# AvailUpdate from JSON Str data (as update_to_json writes); 0 when invalid or unnamed. 1.5.3.
fn update_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return 0; }
    var name = _nj_str(o, "name");
    if (name == 0) { return 0; }
    return avail_update_new(name, source_from_json(_nj_str(o, "source")),
      _nj_or_empty(_nj_str(o, "installed_version")), _nj_or_empty(_nj_str(o, "available_version")),
      _nj_str(o, "changelog"));
}

# --- Strategy ---

# JSON object (Str) for a Strategy; inverse of strategy_from_json.
fn strategy_to_json(s): i64 {
    var k = st_kind(s);
    if (k == STRAT_MARKETPLACE_FIRST) { return str_from("\"MarketplaceFirst\""); }
    if (k == STRAT_SYSTEM_FIRST) { return str_from("\"SystemFirst\""); }
    if (k == STRAT_SEARCH_ALL) { return str_from("\"SearchAll\""); }
    if (k == STRAT_ONLY_SOURCE) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "{\"OnlySource\":");
        str_builder_add_cstr(sb, source_json(st_only(s)));
        str_builder_add_cstr(sb, "}");
        return str_builder_build(sb);
    }
    return str_from("\"MarketplaceFirst\"");
}

# A JSON string ("SystemFirst", ...) or {"OnlySource": "<source>"}. 1.5.3:
# parsed, not substring-matched. Anything unrecognised is still the default
# strategy, as documented.
#
# Strategy from JSON Str data (as strategy_to_json writes); strategy_default() when unrecognised.
fn strategy_from_json(data): i64 {
    if (data == 0) { return strategy_default(); }
    var v = bayan_json_v_parse(data);
    var s = bayan_json_v_str(v);
    if (s != 0) {
        if (str_eq_cstr(s, "SystemFirst") == 1) { return strategy_system_first(); }
        if (str_eq_cstr(s, "SearchAll") == 1) { return strategy_search_all(); }
        return strategy_default();
    }
    if (v != 0 && bayan_json_v_is_obj(v) == 1) {
        var src_s = _nj_str(v, "OnlySource");
        if (src_s != 0) { return strategy_only(source_from_json(src_s)); }
    }
    return strategy_default();
}

# --- SearchResult ---

# JSON object (Str) for a SearchResult, with results and sources; inverse of search_result_from_json.
fn search_result_to_json(sr): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"results\":[");
    var res = sr_results(sr);
    var i = 0;
    while (i < vec_len(res)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add(sb, resolved_to_json(vec_get(res, i)));
        i = i + 1;
    }
    # 1.5.3: the sources searched are written too, so the record roundtrips.
    str_builder_add_cstr(sb, "],\"sources\":[");
    var srcs = sr_sources(sr);
    i = 0;
    while (i < vec_len(srcs)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        str_builder_add_cstr(sb, source_json(vec_get(srcs, i)));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "],\"total_matches\":");
    str_builder_add_int(sb, sr_total(sr));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# SearchResult from JSON Str data (as search_result_to_json writes); 0 when invalid. 1.5.3.
fn search_result_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return 0; }
    var results = vec_new();
    var ra = bayan_json_v_obj_get_by_cstr(o, "results");
    if (ra != 0 && bayan_json_v_is_arr(ra) == 1) {
        var i = 0;
        while (i < bayan_json_v_arr_len(ra)) {
            var e = bayan_json_v_arr_get(ra, i);
            if (bayan_json_v_is_obj(e) == 1) {
                var p = _nj_resolved(e);
                if (p != 0) { vec_push(results, p); }
            }
            i = i + 1;
        }
    }
    var sources = vec_new();
    var names = _nj_str_vec(o, "sources");
    var j = 0;
    while (j < vec_len(names)) { vec_push(sources, source_from_json(vec_get(names, j))); j = j + 1; }
    return nous_search_result_new(results, sources, _nj_int(o, "total_matches"));
}

# --- NousErrorKind ---

# JSON object (Str) for a NousError: kind, message, detail; inverse of error_kind_from_json.
fn error_kind_to_json(e): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"kind\":");
    str_builder_add_int(sb, ne_kind(e));
    _nj_field_str(sb, ",\"message\":", ne_msg(e));
    _nj_field_str(sb, ",\"detail\":", ne_detail(e));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# NousError from JSON Str data; an empty kind-0 error when data is not a valid object.
fn error_kind_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return nous_error_new(0, str_from(""), 0); }
    return nous_error_new(_nj_int(o, "kind"), _nj_or_empty(_nj_str(o, "message")), _nj_str(o, "detail"));
}

# --- AgentInfo ---

# JSON object (Str) for an AgentInfo; inverse of agent_info_from_json.
fn agent_info_to_json(a): i64 {
    var sb = str_builder_new();
    _nj_field_str(sb, "{\"name\":", ai_name(a));
    _nj_field_str(sb, ",\"version\":", ai_version(a));
    _nj_field_str(sb, ",\"description\":", ai_desc(a));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

fn _nj_agent(o): i64 {
    return nous_agent_info_new(_nj_or_empty(_nj_str(o, "name")),
      _nj_or_empty(_nj_str(o, "version")), _nj_or_empty(_nj_str(o, "description")));
}

# AgentInfo from JSON Str data (as agent_info_to_json writes); 0 when not an object. 1.5.3.
fn agent_info_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return 0; }
    return _nj_agent(o);
}

# --- Manifest ---

# JSON object (Str) for a Manifest; inverse of manifest_from_json.
fn manifest_to_json(m): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"agent\":");
    str_builder_add(sb, agent_info_to_json(mf_agent(m)));
    str_builder_add_cstr(sb, ",\"dependencies\":{");
    var keys = _nous_sorted_keys(mf_deps(m));
    var i = 0;
    while (i < vec_len(keys)) {
        if (i > 0) { str_builder_add_cstr(sb, ","); }
        var k = vec_get(keys, i);
        str_builder_add_json_cstr(sb, k);
        str_builder_add_cstr(sb, ":");
        _nj_put_str(sb, map_get(mf_deps(m), k));
        i = i + 1;
    }
    str_builder_add_cstr(sb, "}");
    _nj_field_str(sb, ",\"runtime\":", mf_runtime(m));
    str_builder_add_cstr(sb, "}");
    return str_builder_build(sb);
}

# A Manifest from a parsed manifest object: {"agent": {name, version,
# description}, "dependencies": {name: constraint}, "runtime": "..."}. A
# top-level name / version / description is accepted when there is no
# "agent". Only string constraints are kept, and runtime defaults to "native".
fn _nj_manifest(o): i64 {
    var a = bayan_json_v_obj_get_by_cstr(o, "agent");
    var agent = 0;
    if (a != 0 && bayan_json_v_is_obj(a) == 1) { agent = _nj_agent(a); }
    else { agent = _nj_agent(o); }
    var deps = map_new();
    var dobj = bayan_json_v_obj_get_by_cstr(o, "dependencies");
    if (dobj != 0 && bayan_json_v_is_obj(dobj) == 1) {
        var i = 0;
        while (i < bayan_json_v_obj_len(dobj)) {
            var key = bayan_json_v_obj_key(dobj, i);
            var val = bayan_json_v_str(bayan_json_v_obj_val(dobj, i));
            if (key != 0 && val != 0) { map_set(deps, _nous_cstr(key), val); }
            i = i + 1;
        }
    }
    var runtime = _nj_str(o, "runtime");
    if (runtime == 0) { runtime = str_from("native"); }
    return manifest_new(agent, deps, runtime);
}

# Manifest from JSON Str data (as manifest_to_json writes; the registry reads these); 0 when invalid.
fn manifest_from_json(data): i64 {
    var o = _nj_obj(data);
    if (o == 0) { return 0; }
    return _nj_manifest(o);
}

# --- version.cyr ---

# nous/version — SemVer parsing, constraint matching
# ===================================================================
# P1: Version Constraints
# ===================================================================

# Constraint operators
enum ConstraintOp {
    OP_EQ = 0;
    OP_GTE = 1;
    OP_GT = 2;
    OP_LTE = 3;
    OP_LT = 4;
    OP_CARET = 5;
    OP_TILDE = 6;
    OP_ANY = 7;
}

# SemVer constructor: major, minor, patch (i64). Layout sv_major(0) sv_minor(8) sv_patch(16).
fn semver_new(major, minor, patch): i64 {
    var p = alloc(24);
    store64(p, major); store64(p + 8, minor); store64(p + 16, patch);
    return p;
}
# SemVer field: major component.
fn sv_major(v): i64 { return load64(v); }
# SemVer field: minor component.
fn sv_minor(v): i64 { return load64(v + 8); }
# SemVer field: patch component.
fn sv_patch(v): i64 { return load64(v + 16); }

# Constraint: ct_op(0) ct_ver(8) ct_prec(16) ct_err(24) ct_range(32) = 40 bytes (1.5.3: +prec,
# the number of version components written, "1.2" = 2; +err, a Str reason
# when the text is not a supported constraint, else 0).
#
# Constraint constructor: op (ConstraintOp), ver (SemVer); precision 3, no error.
fn constraint_new(op, ver): i64 {
    var p = alloc(40);
    store64(p, op); store64(p + 8, ver); store64(p + 16, 3); store64(p + 24, 0);
    store64(p + 32, 0);     # cached range (see _nous_range_of)
    return p;
}
# Constraint field: the ConstraintOp.
fn ct_op(c): i64 { return load64(c); }
# Constraint field: the SemVer bound (0.0.0 for OP_ANY; 0 for a refused constraint).
fn ct_ver(c): i64 { return load64(c + 8); }
# Constraint field: how many version components were written ("1.2" = 2), 1 to 3.
fn ct_prec(c): i64 { return load64(c + 16); }
# 0 for a supported constraint, else why it is not (a Str). 1.5.3.
fn nous_constraint_error(c): i64 { return load64(c + 24); }
fn _nous_ct_fail(op, why): i64 {
    var c = constraint_new(op, 0);
    store64(c + 24, str_from(why));
    return c;
}

# Parse "1.2.3" into SemVer. Returns 0 on failure.
fn semver_parse(s): i64 {
    var d = str_data(s);
    var len = str_len(s);
    var pos = 0;
    # 1.5.3: a leading 'v' / 'V' is accepted ("v2.0.0"), as npm does. It parsed
    # as 0.0.0, so update_is_newer("v2.0.0", "1.0.0") missed a real update
    # and update_is_newer("1.0.0", "v2.0.0") reported a downgrade as one.
    if (len > 0 && (load8(d) == 118 || load8(d) == 86)) { pos = 1; }
    # Overflow guard (1.5.3: exact). `x * 10 + d` fits in i64 iff
    # x <= (INT64_MAX - d) / 10. The old `x > INT64_MAX / 10` test ran before
    # the multiply-add, so 9223372036854775808 wrapped to INT64_MIN and
    # compared below 0.0.1.
    var I64MAX = 9223372036854775807;
    # Parse major
    var major = 0;
    while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
        var dg_major = load8(d + pos) - 48;
        if (major > (I64MAX - dg_major) / 10) { return 0; }
        major = major * 10 + dg_major;
        pos = pos + 1;
    }
    if (pos >= len || load8(d + pos) != 46) {
        return semver_new(major, 0, 0);
    }
    pos = pos + 1;
    # Parse minor
    var minor = 0;
    while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
        var dg_minor = load8(d + pos) - 48;
        if (minor > (I64MAX - dg_minor) / 10) { return 0; }
        minor = minor * 10 + dg_minor;
        pos = pos + 1;
    }
    if (pos >= len || load8(d + pos) != 46) {
        return semver_new(major, minor, 0);
    }
    pos = pos + 1;
    # Parse patch
    var patch = 0;
    while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
        var dg_patch = load8(d + pos) - 48;
        if (patch > (I64MAX - dg_patch) / 10) { return 0; }
        patch = patch * 10 + dg_patch;
        pos = pos + 1;
    }
    return semver_new(major, minor, patch);
}

# Compare two SemVers. Returns -1, 0, or 1.
fn semver_cmp(a, b): i64 {
    if (sv_major(a) < sv_major(b)) { return (0 - 1); }
    if (sv_major(a) > sv_major(b)) { return 1; }
    if (sv_minor(a) < sv_minor(b)) { return (0 - 1); }
    if (sv_minor(a) > sv_minor(b)) { return 1; }
    if (sv_patch(a) < sv_patch(b)) { return (0 - 1); }
    if (sv_patch(a) > sv_patch(b)) { return 1; }
    return 0;
}

# 1 when SemVers a and b are equal (major, minor, patch).
fn semver_eq(a, b): i64 { return semver_cmp(a, b) == 0; }

# "major.minor.patch" text (Str) of SemVer v.
fn semver_to_str(v): i64 {
    var sb = str_builder_new();
    str_builder_add_int(sb, sv_major(v));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, sv_minor(v));
    str_builder_add_cstr(sb, ".");
    str_builder_add_int(sb, sv_patch(v));
    return str_builder_build(sb);
}

# A version at d[pos..len): "M[.m[.p]]", optionally "v"-prefixed, where a part
# may be a wildcard x / X / *. Writes the SemVer (missing and wildcard parts 0)
# to out+0, the PRECISION (numeric parts before the first wildcard or the end)
# to out+8, and the end position to out+16. Returns 1, or 0 when there is no
# number at pos or a part overflows i64.
fn _nous_ver_parse_p(d, len, pos, out): i64 {
    var I64MAX = 9223372036854775807;
    if (pos < len && (load8(d + pos) == 118 || load8(d + pos) == 86)) { pos = pos + 1; }
    var parts = alloc(24);
    store64(parts, 0); store64(parts + 8, 0); store64(parts + 16, 0);
    var prec = 0;
    var wild = 0;
    var k = 0;
    while (k < 3) {
        if (pos < len && (load8(d + pos) == 120 || load8(d + pos) == 88 || load8(d + pos) == 42)) {
            wild = 1;
            pos = pos + 1;
        } else {
            var start = pos;
            var x = 0;
            while (pos < len && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
                var dg = load8(d + pos) - 48;
                if (x > (I64MAX - dg) / 10) { return 0; }
                x = x * 10 + dg;
                pos = pos + 1;
            }
            if (pos == start) {
                if (k == 0) { return 0; }
                k = 3;
            } else {
                store64(parts + k * 8, x);
                if (wild == 0) { prec = prec + 1; }
            }
        }
        if (k < 3) {
            k = k + 1;
            if (k < 3) {
                if (pos < len && load8(d + pos) == 46) { pos = pos + 1; }
                else { k = 3; }
            }
        }
    }
    store64(out, semver_new(load64(parts), load64(parts + 8), load64(parts + 16)));
    store64(out + 8, prec);
    store64(out + 16, pos);
    return 1;
}

# Parse a version constraint (1.5.3, decision D1).
#   *  x  ""            any version
#   =V  or bare V        exactly V; a partial is an X-range ("1.2" = >=1.2.0 <1.3.0)
#   >=V  >V  <=V  <V     comparators (partials as Cargo: ">1.2" = >=1.3.0)
#   ^V   ~V              caret / tilde with npm/Cargo zero-major rules; partials
#                        "^0" = <1.0.0, "^0.0" = <0.1.0, "~1" = <2.0.0
# A leading "v" is accepted. Anything else sets nous_constraint_error() and
# never matches: unknown or doubled operators ("!=", "==", "~>", ">>"),
# pre-release / build tags in a constraint and compound ranges (">=1 <2", ",",
# "||"; both are roadmap 1.7.x), and trailing text. Before 1.5.3 these were
# accepted silently: "!=1.0.0" became "=0.0.0", and ">=1.0, <2.0" matched 3.0.0.
#
# Parse Str s into a Constraint; a refused one never matches and nous_constraint_error says why.
fn constraint_parse(s): i64 {
    var d = str_data(s);
    var len = str_len(s);
    var pos = 0;
    while (pos < len && (load8(d + pos) == 32 || load8(d + pos) == 9)) { pos = pos + 1; }
    var end = len;
    while (end > pos && (load8(d + end - 1) == 32 || load8(d + end - 1) == 9)) { end = end - 1; }
    if (pos >= end) { return constraint_new(OP_ANY, semver_new(0, 0, 0)); }
    if (end - pos == 1) {
        var only = load8(d + pos);
        if (only == 42 || only == 120 || only == 88) { return constraint_new(OP_ANY, semver_new(0, 0, 0)); }
    }
    var op = OP_EQ;
    var c = load8(d + pos);
    if (c == 94) { op = OP_CARET; pos = pos + 1; }
    elif (c == 126) { op = OP_TILDE; pos = pos + 1; }
    elif (c == 62) {
        pos = pos + 1;
        if (pos < end && load8(d + pos) == 61) { op = OP_GTE; pos = pos + 1; } else { op = OP_GT; }
    }
    elif (c == 60) {
        pos = pos + 1;
        if (pos < end && load8(d + pos) == 61) { op = OP_LTE; pos = pos + 1; } else { op = OP_LT; }
    }
    elif (c == 61) { op = OP_EQ; pos = pos + 1; }
    elif (c == 33) { return _nous_ct_fail(OP_EQ, "'!=' is not supported"); }
    while (pos < end && load8(d + pos) == 32) { pos = pos + 1; }
    if (pos < end) {
        var c2 = load8(d + pos);
        if (c2 == 61 || c2 == 62 || c2 == 60 || c2 == 126 || c2 == 94 || c2 == 33) {
            return _nous_ct_fail(op, "doubled or unknown operator");
        }
    }
    var out = alloc(24);
    if (_nous_ver_parse_p(d, end, pos, out) == 0) {
        if (pos < end && load8(d + pos) >= 48 && load8(d + pos) <= 57) {
            return _nous_ct_fail(op, "version number too large");
        }
        return _nous_ct_fail(op, "missing or malformed version");
    }
    var vend = load64(out + 16);
    if (vend < end) {
        var t = load8(d + vend);
        var pre_msg = "pre-release / build tags in a constraint are not supported yet (roadmap 1.7.x)";
        if (t == 45 || t == 43) { return _nous_ct_fail(op, pre_msg); }
        var cmp_msg = "compound ranges are not supported yet (roadmap 1.7.x)";
        if (t == 44 || t == 32 || t == 124) { return _nous_ct_fail(op, cmp_msg); }
        return _nous_ct_fail(op, "unexpected text after the version");
    }
    var prec = load64(out + 8);
    if (prec == 0) { return constraint_new(OP_ANY, semver_new(0, 0, 0)); }
    var ct = constraint_new(op, load64(out));
    store64(ct + 16, prec);
    return ct;
}

# ---- version ranges (1.5.3) -------------------------------------------
# Range: lo(0) lo_incl(8) hi(16) hi_incl(24); lo / hi are SemVers, or 0 for
# unbounded.
fn _nous_range_new(lo, lo_incl, hi, hi_incl): i64 {
    var p = alloc(32);
    store64(p, lo); store64(p + 8, lo_incl); store64(p + 16, hi); store64(p + 24, hi_incl);
    return p;
}
fn _rg_lo(r): i64 { return load64(r); }
fn _rg_lo_incl(r): i64 { return load64(r + 8); }
fn _rg_hi(r): i64 { return load64(r + 16); }
fn _rg_hi_incl(r): i64 { return load64(r + 24); }

# The range a supported constraint denotes (npm / Cargo desugaring; see
# docs/sources.md). 0 for a constraint with an error.
fn _nous_range_of(c): i64 {
    if (nous_constraint_error(c) != 0 || ct_ver(c) == 0) { return 0; }
    # Computed once per constraint (1.5.3, perf): matching against the same
    # constraint must not allocate a range on every call.
    if (load64(c + 32) != 0) { return load64(c + 32); }
    var rg = _nous_range_build(c);
    store64(c + 32, rg);
    return rg;
}

fn _nous_range_build(c): i64 {
    var op = ct_op(c);
    if (op == OP_ANY) { return _nous_range_new(0, 1, 0, 1); }
    var v = ct_ver(c);
    var M = sv_major(v);
    var m = sv_minor(v);
    var pt = sv_patch(v);
    var P = ct_prec(c);
    if (op == OP_EQ) {
        if (P >= 3) { return _nous_range_new(v, 1, v, 1); }
        if (P == 2) { return _nous_range_new(semver_new(M, m, 0), 1, semver_new(M, m + 1, 0), 0); }
        return _nous_range_new(semver_new(M, 0, 0), 1, semver_new(M + 1, 0, 0), 0);
    }
    if (op == OP_GTE) { return _nous_range_new(v, 1, 0, 1); }
    if (op == OP_GT) {
        if (P >= 3) { return _nous_range_new(v, 0, 0, 1); }
        if (P == 2) { return _nous_range_new(semver_new(M, m + 1, 0), 1, 0, 1); }
        return _nous_range_new(semver_new(M + 1, 0, 0), 1, 0, 1);
    }
    if (op == OP_LT) { return _nous_range_new(0, 1, v, 0); }
    if (op == OP_LTE) {
        if (P >= 3) { return _nous_range_new(0, 1, v, 1); }
        if (P == 2) { return _nous_range_new(0, 1, semver_new(M, m + 1, 0), 0); }
        return _nous_range_new(0, 1, semver_new(M + 1, 0, 0), 0);
    }
    if (op == OP_CARET) {
        if (P == 1) { return _nous_range_new(v, 1, semver_new(M + 1, 0, 0), 0); }
        if (M > 0) { return _nous_range_new(v, 1, semver_new(M + 1, 0, 0), 0); }
        if (P == 2 || m > 0) { return _nous_range_new(v, 1, semver_new(0, m + 1, 0), 0); }
        return _nous_range_new(v, 1, semver_new(0, 0, pt + 1), 0);
    }
    if (op == OP_TILDE) {
        if (P == 1) { return _nous_range_new(v, 1, semver_new(M + 1, 0, 0), 0); }
        return _nous_range_new(v, 1, semver_new(M, m + 1, 0), 0);
    }
    return 0;
}

# 1 when SemVer `v` lies in range `rg`.
fn _nous_range_contains(rg, v): i64 {
    if (rg == 0 || v == 0) { return 0; }
    if (_rg_lo(rg) != 0) {
        var a = semver_cmp(v, _rg_lo(rg));
        if (a < 0 || (a == 0 && _rg_lo_incl(rg) == 0)) { return 0; }
    }
    if (_rg_hi(rg) != 0) {
        var b = semver_cmp(v, _rg_hi(rg));
        if (b > 0 || (b == 0 && _rg_hi_incl(rg) == 0)) { return 0; }
    }
    return 1;
}

# The intersection of two ranges, or 0 when it is empty.
fn _nous_range_intersect(a, b): i64 {
    if (a == 0 || b == 0) { return 0; }
    var lo = _rg_lo(a);
    var lo_i = _rg_lo_incl(a);
    if (_rg_lo(b) != 0) {
        if (lo == 0) { lo = _rg_lo(b); lo_i = _rg_lo_incl(b); }
        else {
            var c = semver_cmp(_rg_lo(b), lo);
            if (c > 0) { lo = _rg_lo(b); lo_i = _rg_lo_incl(b); }
            elif (c == 0 && _rg_lo_incl(b) == 0) { lo_i = 0; }
        }
    }
    var hi = _rg_hi(a);
    var hi_i = _rg_hi_incl(a);
    if (_rg_hi(b) != 0) {
        if (hi == 0) { hi = _rg_hi(b); hi_i = _rg_hi_incl(b); }
        else {
            var c2 = semver_cmp(_rg_hi(b), hi);
            if (c2 < 0) { hi = _rg_hi(b); hi_i = _rg_hi_incl(b); }
            elif (c2 == 0 && _rg_hi_incl(b) == 0) { hi_i = 0; }
        }
    }
    if (lo != 0 && hi != 0) {
        var e = semver_cmp(lo, hi);
        if (e > 0) { return 0; }
        if (e == 0 && (lo_i == 0 || hi_i == 0)) { return 0; }
    }
    return _nous_range_new(lo, lo_i, hi, hi_i);
}

# Check if version v satisfies constraint c. 1.5.3: through the constraint's
# range, so partials and zero-major carets are right and an unsupported
# constraint never matches.
#
# 1 when SemVer v satisfies Constraint c, else 0.
fn constraint_matches(c, v): i64 {
    if (ct_op(c) == OP_ANY && nous_constraint_error(c) == 0) { return 1; }
    if (v == 0) { return 0; }
    return _nous_range_contains(_nous_range_of(c), v);
}

# ---- Debian version comparison (1.5.3, decision D2) -------------------
# deb-version(7) / Debian Policy §5.6.12, following dpkg's
# lib/dpkg/version.c (`verrevcmp`). [epoch:]upstream[-revision]: the epoch is
# compared numerically, then upstream, then revision, each by alternating
# non-digit runs (ordered: '~' before everything, even the end; then the end;
# then letters; then other characters) and digit runs (numerically).

fn _nous_isdig(c): i64 {
    if (c >= 48 && c <= 57) { return 1; }
    return 0;
}

fn _nous_deb_order(c): i64 {
    if (c >= 48 && c <= 57) { return 0; }
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122)) { return c; }
    if (c == 126) { return 0 - 1; }
    if (c != 0) { return c + 256; }
    return 0;
}

# dpkg's verrevcmp over byte ranges [a, a+al) and [b, b+bl).
fn _nous_verrevcmp(a, al, b, bl): i64 {
    var i = 0;
    var j = 0;
    while (i < al || j < bl) {
        var first_diff = 0;
        while ((i < al && _nous_isdig(load8(a + i)) == 0) || (j < bl && _nous_isdig(load8(b + j)) == 0)) {
            var ac = 0;
            if (i < al) { ac = _nous_deb_order(load8(a + i)); }
            var bc = 0;
            if (j < bl) { bc = _nous_deb_order(load8(b + j)); }
            if (ac != bc) { return ac - bc; }
            i = i + 1;
            j = j + 1;
        }
        while (i < al && load8(a + i) == 48) { i = i + 1; }
        while (j < bl && load8(b + j) == 48) { j = j + 1; }
        while (i < al && j < bl && _nous_isdig(load8(a + i)) == 1 && _nous_isdig(load8(b + j)) == 1) {
            if (first_diff == 0) { first_diff = load8(a + i) - load8(b + j); }
            i = i + 1;
            j = j + 1;
        }
        if (i < al && load8(a + i) >= 48 && load8(a + i) <= 57) { return 1; }
        if (j < bl && load8(b + j) >= 48 && load8(b + j) <= 57) { return 0 - 1; }
        if (first_diff != 0) { return first_diff; }
    }
    return 0;
}

# Split a Debian version Str: out+0 epoch (number), out+8/16 upstream
# start/length, out+24/32 revision start/length (0 length when absent).
fn _nous_deb_split(s, out): i64 {
    var d = str_data(s);
    var n = str_len(s);
    var colon = str_index_of(s, 58);
    var epoch = 0;
    var us = 0;
    if (colon > 0) {
        var k = 0;
        while (k < colon && load8(d + k) >= 48 && load8(d + k) <= 57) {
            if (epoch < 92233720368547758) { epoch = epoch * 10 + load8(d + k) - 48; }
            k = k + 1;
        }
        us = colon + 1;
    }
    var dash = 0 - 1;
    var k2 = n - 1;
    while (k2 >= us && dash < 0) {
        if (load8(d + k2) == 45) { dash = k2; }
        k2 = k2 - 1;
    }
    store64(out, epoch);
    store64(out + 8, d + us);
    if (dash >= 0) {
        store64(out + 16, dash - us);
        store64(out + 24, d + dash + 1);
        store64(out + 32, n - dash - 1);
    } else {
        store64(out + 16, n - us);
        store64(out + 24, d);
        store64(out + 32, 0);
    }
    return 0;
}

# 1.5.3: nous compared these as SemVer, missing revision-only security updates
# (7.81.0-1ubuntu1.16 vs .15), '~' pre-releases and letter suffixes (0.9.8zh),
# and offering an epoch downgrade (2.0-1 over 1:1.0-1).
#
# Compare two Debian version strings: negative / 0 / positive (deb-version(7)).
fn nous_deb_version_cmp(a, b): i64 {
    var pa = alloc(40);
    var pb = alloc(40);
    _nous_deb_split(a, pa);
    _nous_deb_split(b, pb);
    if (load64(pa) != load64(pb)) {
        if (load64(pa) < load64(pb)) { return 0 - 1; }
        return 1;
    }
    var u = _nous_verrevcmp(load64(pa + 8), load64(pa + 16), load64(pb + 8), load64(pb + 16));
    if (u != 0) { return u; }
    return _nous_verrevcmp(load64(pa + 24), load64(pa + 32), load64(pb + 24), load64(pb + 32));
}

# A SemVer bound as a Debian-comparable string: trailing zero parts dropped
# ("2.36.0" -> "2.36", "3.0.0" -> "3"), so "2.36-9" >= bound 2.36.0 holds.
fn _nous_bound_deb_str(v): i64 {
    var sb = str_builder_new();
    str_builder_add_int(sb, sv_major(v));
    if (sv_minor(v) != 0 || sv_patch(v) != 0) {
        str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, sv_minor(v));
    }
    if (sv_patch(v) != 0) {
        str_builder_add_cstr(sb, ".");
        str_builder_add_int(sb, sv_patch(v));
    }
    return str_builder_build(sb);
}

# 1 when version STRING `ver` of a package from `src` lies in range `rg`: apt
# and community versions compare as Debian versions, the rest as SemVer.
fn _nous_range_contains_ver(rg, ver, src): i64 {
    if (rg == 0) { return 0; }
    if (src == SOURCE_SYSTEM || src == SOURCE_COMMUNITY) {
        if (_rg_lo(rg) != 0) {
            var a = nous_deb_version_cmp(ver, _nous_bound_deb_str(_rg_lo(rg)));
            if (a < 0 || (a == 0 && _rg_lo_incl(rg) == 0)) { return 0; }
        }
        if (_rg_hi(rg) != 0) {
            var b = nous_deb_version_cmp(ver, _nous_bound_deb_str(_rg_hi(rg)));
            if (b > 0 || (b == 0 && _rg_hi_incl(rg) == 0)) { return 0; }
        }
        return 1;
    }
    return _nous_range_contains(rg, semver_parse(ver));
}

# --- graph.cyr ---

# nous/graph — dependency graph, cycle detection, topological sort
# ===================================================================
# P1: Dependency Graph
# ===================================================================

# DepGraph: dg_nodes(0) dg_edges(8) dg_versions(16)
# nodes = hashmap: pkg_name -> ResolvedPkg
# edges = hashmap: pkg_name -> vec of dep_name Strs
# versions = hashmap: pkg_name -> vec of Constraint
#
# Empty DepGraph.
fn dep_graph_new(): i64 {
    var p = alloc(24);
    store64(p, map_new());
    store64(p + 8, map_new());
    store64(p + 16, map_new());
    return p;
}
# DepGraph field: map cstr name -> ResolvedPkg.
fn dg_nodes(g): i64 { return load64(g); }
# DepGraph field: map cstr name -> vec of dependency-name Strs.
fn dg_edges(g): i64 { return load64(g + 8); }

# Add ResolvedPkg pkg to DepGraph g as a node, with an edge to each of its rp_deps names.
fn dep_graph_add(g, pkg): i64 {
    var cname = _nous_cstr(rp_name(pkg));
    map_set(dg_nodes(g), cname, pkg);
    # Add edges from this pkg's deps
    var deps = rp_deps(pkg);
    var edge_list = vec_new();
    var i = 0;
    while (i < vec_len(deps)) {
        vec_push(edge_list, vec_get(deps, i));
        i = i + 1;
    }
    map_set(dg_edges(g), cname, edge_list);
}

# ===================================================================
# Cycle detection and install order (iterative Tarjan SCC)
# ===================================================================

# 1.5.3: cycles and install order come from one ITERATIVE Tarjan pass
# (R. E. Tarjan, "Depth-first search and linear graph algorithms", SIAM J.
# Comput. 1(2), 1972; see docs/sources.md). It replaces the recursive DFS colour
# walk, which crashed on 50k+ chains (stack depth) and misreported a self-loop
# reached through another node as [xx, aa, aa]. Tarjan emits each strongly
# connected component after every component reachable from it, so with edges
# pointing package -> dependency the emission order is install order
# (dependencies first). Nodes are visited in byte order and edges in dep-list
# order, so the result is deterministic.

# Tarjan over `g`. Returns a vec of components in emission (install) order;
# each component is a vec of node indexes. *names_out gets the node names (cstr,
# byte order), *adj_out the adjacency (vec of index vecs, graph nodes only).
fn _nous_tarjan(g, names_out, adj_out): i64 {
    var names = _nous_sorted_keys(dg_nodes(g));
    var n = vec_len(names);
    var idx = map_new();
    var i = 0;
    while (i < n) { map_set(idx, vec_get(names, i), i + 1); i = i + 1; }
    var adj = vec_new();
    i = 0;
    while (i < n) {
        var out = vec_new();
        var cn = vec_get(names, i);
        if (map_has(dg_edges(g), cn) == 1) {
            var deps = map_get(dg_edges(g), cn);
            var j = 0;
            while (j < vec_len(deps)) {
                var t = map_get(idx, _nous_cstr(vec_get(deps, j)));
                if (t > 0) { vec_push(out, t - 1); }
                j = j + 1;
            }
        }
        vec_push(adj, out);
        i = i + 1;
    }
    store64(names_out, names);
    store64(adj_out, adj);
    var comps = vec_new();
    if (n == 0) { return comps; }
    var index = alloc(n * 8);
    var low = alloc(n * 8);
    var onst = alloc(n * 8);
    i = 0;
    while (i < n) { store64(index + i * 8, 0 - 1); store64(onst + i * 8, 0); i = i + 1; }
    var tstack = vec_new();
    var fr_v = vec_new();          # call frames: node, next edge position
    var fr_e = vec_new();
    var counter = 0;
    var root = 0;
    while (root < n) {
        if (load64(index + root * 8) < 0) {
            store64(index + root * 8, counter); store64(low + root * 8, counter);
            counter = counter + 1;
            vec_push(tstack, root); store64(onst + root * 8, 1);
            vec_push(fr_v, root); vec_push(fr_e, 0);
            while (vec_len(fr_v) > 0) {
                var top = vec_len(fr_v) - 1;
                var v = vec_get(fr_v, top);
                var ei = vec_get(fr_e, top);
                var av = vec_get(adj, v);
                if (ei < vec_len(av)) {
                    vec_set(fr_e, top, ei + 1);
                    var w = vec_get(av, ei);
                    if (load64(index + w * 8) < 0) {
                        store64(index + w * 8, counter); store64(low + w * 8, counter);
                        counter = counter + 1;
                        vec_push(tstack, w); store64(onst + w * 8, 1);
                        vec_push(fr_v, w); vec_push(fr_e, 0);
                    } elif (load64(onst + w * 8) == 1) {
                        var wi = load64(index + w * 8);
                        if (wi < load64(low + v * 8)) { store64(low + v * 8, wi); }
                    }
                } else {
                    vec_pop(fr_v);
                    vec_pop(fr_e);
                    if (vec_len(fr_v) > 0) {
                        var pv = vec_get(fr_v, vec_len(fr_v) - 1);
                        if (load64(low + v * 8) < load64(low + pv * 8)) { store64(low + pv * 8, load64(low + v * 8)); }
                    }
                    if (load64(low + v * 8) == load64(index + v * 8)) {
                        var comp = vec_new();
                        var go = 1;
                        while (go == 1) {
                            var x = vec_pop(tstack);
                            store64(onst + x * 8, 0);
                            vec_push(comp, x);
                            if (x == v) { go = 0; }
                        }
                        vec_push(comps, comp);
                    }
                }
            }
        }
        root = root + 1;
    }
    return comps;
}

# 1 when component `comp` is a cycle: 2+ nodes, or one node with a self-edge.
fn _nous_comp_cyclic(comp, adj): i64 {
    if (vec_len(comp) > 1) { return 1; }
    var v = vec_get(comp, 0);
    var av = vec_get(adj, v);
    var i = 0;
    while (i < vec_len(av)) {
        if (vec_get(av, i) == v) { return 1; }
        i = i + 1;
    }
    return 0;
}

# A concrete cycle through the component's byte-first member s, as Strs
# [s, ..., s]: a breadth-first search inside the component back to s.
fn _nous_comp_cycle_path(comp, adj, names): i64 {
    var s = vec_get(comp, 0);
    var i = 1;
    while (i < vec_len(comp)) {
        if (vec_get(comp, i) < s) { s = vec_get(comp, i); }
        i = i + 1;
    }
    var inc = map_new();
    i = 0;
    while (i < vec_len(comp)) { map_set(inc, vec_get(names, vec_get(comp, i)), 1); i = i + 1; }
    var parent = map_new();
    var q = vec_new();
    vec_push(q, s);
    var qh = 0;
    var last = 0 - 1;
    while (qh < vec_len(q) && last < 0) {
        var u = vec_get(q, qh);
        qh = qh + 1;
        var au = vec_get(adj, u);
        var j = 0;
        while (j < vec_len(au) && last < 0) {
            var w = vec_get(au, j);
            if (w == s) { last = u; }
            elif (map_has(inc, vec_get(names, w)) == 1 && map_has(parent, vec_get(names, w)) == 0) {
                map_set(parent, vec_get(names, w), u + 1);
                vec_push(q, w);
            }
            j = j + 1;
        }
    }
    var rev = vec_new();
    var cur = last;
    while (cur >= 0 && cur != s) {
        vec_push(rev, cur);
        cur = map_get(parent, vec_get(names, cur)) - 1;
    }
    var path = vec_new();
    vec_push(path, str_from(vec_get(names, s)));
    var k = vec_len(rev) - 1;
    while (k >= 0) { vec_push(path, str_from(vec_get(names, vec_get(rev, k)))); k = k - 1; }
    vec_push(path, str_from(vec_get(names, s)));
    return path;
}

# The first cycle in `g` (byte order), as a vec of Str names [a, ..., a], or 0.
fn dep_graph_detect_cycle(g): i64 {
    var nb = alloc(8);
    var ab = alloc(8);
    var comps = _nous_tarjan(g, nb, ab);
    var i = 0;
    while (i < vec_len(comps)) {
        var comp = vec_get(comps, i);
        if (_nous_comp_cyclic(comp, load64(ab)) == 1) {
            return _nous_comp_cycle_path(comp, load64(ab), load64(nb));
        }
        i = i + 1;
    }
    return 0;
}

# ===================================================================
# P1: Topological Sort (Kahn's Algorithm)
# ===================================================================

# Kahn order of g's node names (Strs), dependents first; partial on a cyclic graph.
fn dep_graph_topo_sort(g): i64 {
    var nodes = _nous_sorted_keys(dg_nodes(g));
    var in_degree = map_new();
    # Initialize in-degree to 0
    var i = 0;
    while (i < vec_len(nodes)) {
        map_set(in_degree, vec_get(nodes, i), 0);
        i = i + 1;
    }
    # Count in-degrees
    i = 0;
    while (i < vec_len(nodes)) {
        var cname = vec_get(nodes, i);
        if (map_has(dg_edges(g), cname) == 1) {
            var deps = map_get(dg_edges(g), cname);
            var j = 0;
            while (j < vec_len(deps)) {
                var dep = _nous_cstr(vec_get(deps, j));
                if (map_has(in_degree, dep) == 1) {
                    map_set(in_degree, dep, map_get(in_degree, dep) + 1);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    # Queue nodes with in-degree 0
    var queue = vec_new();
    i = 0;
    while (i < vec_len(nodes)) {
        if (map_get(in_degree, vec_get(nodes, i)) == 0) {
            vec_push(queue, vec_get(nodes, i));
        }
        i = i + 1;
    }
    var order = vec_new();
    # FIFO through a head index: vec_remove(queue, 0) shifted the whole queue on
    # every pop, which is O(n²) on a wide graph (1.5.3; same order).
    var qh = 0;
    while (qh < vec_len(queue)) {
        var cname = vec_get(queue, qh);
        qh = qh + 1;
        vec_push(order, str_from(cname));
        if (map_has(dg_edges(g), cname) == 1) {
            var deps = map_get(dg_edges(g), cname);
            var j = 0;
            while (j < vec_len(deps)) {
                var dep = _nous_cstr(vec_get(deps, j));
                if (map_has(in_degree, dep) == 1) {
                    var nd = map_get(in_degree, dep) - 1;
                    map_set(in_degree, dep, nd);
                    if (nd == 0) { vec_push(queue, dep); }
                }
                j = j + 1;
            }
        }
    }
    # If order is shorter than nodes, there's a cycle (shouldn't happen if cycle detected first)
    return order;
}

# ===================================================================
# P1: Conflict Detection
# ===================================================================

# 1 if some version satisfies both constraints, else 0. 1.5.3: a true range
# intersection. It used to try about five sample versions, so ">1.2.0" with
# "<1.3.0" read as a conflict (1.2.1 satisfies both), and swapping the
# arguments changed the answer.
#
# 1 when some version satisfies both Constraints c1 and c2 (range intersection), else 0.
fn constraints_compatible(c1, c2): i64 {
    if (_nous_range_intersect(_nous_range_of(c1), _nous_range_of(c2)) == 0) { return 0; }
    return 1;
}

# ===================================================================
# P1: Full Resolution — resolver_resolve_all
# ===================================================================

# ResPlan constructor: packages (vec of ResolvedPkg), order (vec of Str); no unresolved names.
fn res_plan_new(packages, order): i64 {
    var p = alloc(24);
    store64(p, packages); store64(p + 8, order); store64(p + 16, vec_new());
    return p;
}
# ResPlan field: the ResolvedPkgs in install order (dependencies first).
fn pl_packages(p): i64 { return load64(p); }
# ResPlan field: the package names (Strs) in install order, matching pl_packages.
fn pl_order(p): i64 { return load64(p + 8); }

# Names an apt package depends on that apt itself could not show: virtual
# packages, alternatives (1.5.3, decision D4). They are listed, not fatal,
# because apt resolves them. Each entry: nous_unres_name / nous_unres_requirer.
#
# ResPlan field: a vec of unresolved entries (nous_unres_name / nous_unres_requirer).
fn nous_pl_unresolved(p): i64 { return load64(p + 16); }
fn _nous_unres_new(name, requirer): i64 {
    var u = alloc(16);
    store64(u, name); store64(u + 8, requirer);
    return u;
}
# Unresolved entry: the dependency name apt could not show (Str).
fn nous_unres_name(u): i64 { return load64(u); }
# Unresolved entry: the package that depends on it (Str).
fn nous_unres_requirer(u): i64 { return load64(u + 8); }

# Resolve a list of package names transitively; see `_nous_resolve_closure`.
# Ok(ResPlan) for the transitive closure of a vec of Str names, or Err(NousError).
fn resolver_resolve_all(r, names): Result { return _nous_resolve_closure(r, names, 0); }

# --- recipe.cyr ---

# nous/recipe — zugot recipe parsing, recipe DB, recipe-based resolution
# ===================================================================
# P2: Zugot Recipe Integration
# ===================================================================

# Empty Recipe (96 bytes); fill it with the recipe_set_* setters (each takes at most 6 arguments).
fn recipe_alloc(): i64 { return alloc(96); }
# Recipe setter: name, ver, desc, license, arch (Str each), from [package].
fn recipe_set_pkg(r, name, ver, desc, license, arch): i64 {
    store64(r, name); store64(r + 8, ver); store64(r + 16, desc);
    store64(r + 24, license); store64(r + 32, arch);
}
# Recipe setter: groups (vec of Str), release (i64), url, sha256 (Str), patches (vec of Str).
fn recipe_set_meta(r, groups, release, url, sha256, patches): i64 {
    store64(r + 40, groups); store64(r + 48, release);
    store64(r + 56, url); store64(r + 64, sha256); store64(r + 72, patches);
}
# Recipe setter: rt_deps, bd_deps (vec of Str each), from [depends] runtime / build.
fn recipe_set_deps(r, rt_deps, bd_deps): i64 {
    store64(r + 80, rt_deps); store64(r + 88, bd_deps);
}

# Recipe field: package name (Str).
fn rc_name(r): i64 { return load64(r); }
# Recipe field: version (Str; "" when the recipe has none).
fn rc_ver(r): i64 { return load64(r + 8); }
# Recipe field: description (Str).
fn rc_desc(r): i64 { return load64(r + 16); }
# Recipe field: license (Str).
fn rc_license(r): i64 { return load64(r + 24); }
# Recipe field: architecture (Str; "x86_64" by default).
fn rc_arch(r): i64 { return load64(r + 32); }
# Recipe field: groups, a vec of Str.
fn rc_groups(r): i64 { return load64(r + 40); }
# Recipe field: release number (i64; 1 by default).
fn rc_release(r): i64 { return load64(r + 48); }
# Recipe field: source URL (Str; a github_release recipe gets a .../releases placeholder).
fn rc_url(r): i64 { return load64(r + 56); }
# Recipe field: source SHA-256 (Str). nous carries it; the installer verifies it.
fn rc_sha256(r): i64 { return load64(r + 64); }
# Recipe field: patch file names, a vec of Str.
fn rc_patches(r): i64 { return load64(r + 72); }
# Recipe field: runtime dependency names, a vec of Str.
fn rc_rt_deps(r): i64 { return load64(r + 80); }
# Recipe field: build dependency names, a vec of Str.
fn rc_bd_deps(r): i64 { return load64(r + 88); }

# RecipeDb constructor: path (Str), recipes (map), order (vec of Str); no duplicates. 32 bytes.
fn recipe_db_new(path, recipes, order): i64 {
    var p = alloc(32);
    store64(p, path); store64(p + 8, recipes); store64(p + 16, order);
    store64(p + 24, vec_new());
    return p;
}
# RecipeDb field: the zugot directory (Str).
fn rdb_path(d): i64 { return load64(d); }
# RecipeDb field: map cstr name -> Recipe (the first recipe with each name).
fn rdb_recipes(d): i64 { return load64(d + 8); }
# RecipeDb field: build-order.txt entries, a vec of Str ("category/name").
fn rdb_order(d): i64 { return load64(d + 16); }

# Parse a TOML inline array: ["a", "b", "c"] -> vec of Str
fn parse_toml_array(s): i64 {
    var result = vec_new();
    if (s == 0) { return result; }
    var d = str_data(s);
    var len = str_len(s);
    var i = 0;
    while (i < len) {
        if (load8(d + i) == 34) {
            # Start of quoted string
            i = i + 1;
            var start = i;
            while (i < len && load8(d + i) != 34) { i = i + 1; }
            if (i > start) {
                vec_push(result, str_new(d + start, i - start));
            }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return result;
}

# CYML parser — handles single-bracket [section] and [[array]] headers. nous
# keeps its own rather than bayan's `cyml_parse` (a different doc/entry model)
# or the old stdlib `toml_parse` (missed [section]). The section/pair records
# it builds are bayan's (`bayan_toml_section_*` / `bayan_toml_pair_*`), from
# the slim `dist/bayan-toml.cyr` profile (`[deps.bayan]`). The unprefixed
# `toml_*` compat aliases exist only in the full bayan fold (1.5.1).
#
# Parse CYML text (Str) into a vec of bayan TOML sections; a key before any header gets section "".
fn nous_cyml_parse(src): i64 {
    var sections = vec_new();
    var d = str_data(src);
    var len = str_len(src);
    var pos = 0;
    var cur_name = str_from("");
    var cur_pairs = vec_new();

    while (pos < len) {
        var c = load8(d + pos);
        if (c == 10 || c == 13 || c == 32 || c == 9) { pos = pos + 1; }
        elif (c == 35) {
            while (pos < len && load8(d + pos) != 10) { pos = pos + 1; }
        }
        elif (c == 91) {
            # Save current section
            if (vec_len(cur_pairs) > 0 || str_len(cur_name) > 0) {
                vec_push(sections, bayan_toml_section_new(cur_name, cur_pairs));
            }
            pos = pos + 1;
            # Skip second [ for [[array]]
            if (pos < len && load8(d + pos) == 91) { pos = pos + 1; }
            # Read section name (may contain dots: marketplace.sandbox)
            while (pos < len && load8(d + pos) == 32) { pos = pos + 1; }
            var nstart = pos;
            while (pos < len && load8(d + pos) != 93) { pos = pos + 1; }
            cur_name = str_new(d + nstart, pos - nstart);
            # Skip ] and optional second ]
            if (pos < len && load8(d + pos) == 93) { pos = pos + 1; }
            if (pos < len && load8(d + pos) == 93) { pos = pos + 1; }
            cur_pairs = vec_new();
            while (pos < len && load8(d + pos) != 10) { pos = pos + 1; }
        } else {
            # key = value
            var kstart = pos;
            while (pos < len) {
                var kc = load8(d + pos);
                if (kc == 61 || kc == 32 || kc == 9 || kc == 10) { break; }
                pos = pos + 1;
            }
            # Guard: if key loop didn't advance, force progress to prevent infinite loop
            if (pos == kstart) { pos = pos + 1; continue; }
            var key = str_new(d + kstart, pos - kstart);
            # Skip to =
            while (pos < len && (load8(d + pos) == 32 || load8(d + pos) == 9)) { pos = pos + 1; }
            if (pos < len && load8(d + pos) == 61) {
                pos = pos + 1;
                while (pos < len && (load8(d + pos) == 32 || load8(d + pos) == 9)) { pos = pos + 1; }
                var value = str_from("");
                if (pos < len) {
                    var vc = load8(d + pos);
                    # Triple-quoted """..."""
                    if (vc == 34 && pos + 2 < len && load8(d + pos + 1) == 34 && load8(d + pos + 2) == 34) {
                        pos = pos + 3;
                        # Skip leading newline
                        if (pos < len && load8(d + pos) == 10) { pos = pos + 1; }
                        var vs = pos;
                        while (pos + 2 < len) {
                            if (load8(d + pos) == 34 && load8(d + pos + 1) == 34 && load8(d + pos + 2) == 34) { break; }
                            pos = pos + 1;
                        }
                        # Trim trailing newline
                        var ve = pos;
                        if (ve > vs && load8(d + ve - 1) == 10) { ve = ve - 1; }
                        value = str_new(d + vs, ve - vs);
                        pos = pos + 3;
                    }
                    # Double-quoted "..."
                    elif (vc == 34) {
                        pos = pos + 1;
                        var vs = pos;
                        while (pos < len && load8(d + pos) != 34) { pos = pos + 1; }
                        value = str_new(d + vs, pos - vs);
                        if (pos < len) { pos = pos + 1; }
                    }
                    # Array [...]: may span lines (1.5.3, P1). It used to be read to the
                    # end of its first line, so `runtime = [` + one dep per line (47
                    # zugot recipes, e.g. firefox's ~20 deps) gave ZERO deps. Read up to
                    # the matching ']', string- and escape-aware, dropping `#` comments
                    # outside quotes, which used to add a dep from `# "openssl"`.
                    elif (vc == 91) {
                        # Fast path (1.5.3, perf): with no `#` comment inside, the
                        # value is a view of the source (zero copy). Otherwise it
                        # is copied with the comments dropped.
                        var sp2 = pos;
                        var sdepth = 0;
                        var sinstr = 0;
                        var has_comment = 0;
                        var sdone = 0;
                        while (sp2 < len && sdone == 0) {
                            var sc = load8(d + sp2);
                            if (sinstr == 1) {
                                if (sc == 92) { sp2 = sp2 + 1; } elif (sc == 34) { sinstr = 0; }
                            } elif (sc == 35) { has_comment = 1; sdone = 1; }
                            elif (sc == 34) { sinstr = 1; }
                            elif (sc == 91) { sdepth = sdepth + 1; }
                            elif (sc == 93) {
                                sdepth = sdepth - 1;
                                if (sdepth == 0) { sdone = 1; }
                            }
                            sp2 = sp2 + 1;
                        }
                        if (has_comment == 0) {
                            if (sp2 > len) { sp2 = len; }
                            value = str_new(d + pos, sp2 - pos);
                            pos = sp2;
                        } else {
                            var asb = str_builder_new();
                            var depth = 0;
                            var instr = 0;
                            var adone = 0;
                            while (pos < len && adone == 0) {
                                var ac = load8(d + pos);
                                if (instr == 1) {
                                    str_builder_putc(asb, ac);
                                    if (ac == 92 && pos + 1 < len) {
                                        pos = pos + 1;
                                        str_builder_putc(asb, load8(d + pos));
                                    } elif (ac == 34) { instr = 0; }
                                    pos = pos + 1;
                                } elif (ac == 35) {
                                    while (pos < len && load8(d + pos) != 10) { pos = pos + 1; }
                                } else {
                                    str_builder_putc(asb, ac);
                                    if (ac == 34) { instr = 1; }
                                    if (ac == 91) { depth = depth + 1; }
                                    if (ac == 93) {
                                        depth = depth - 1;
                                        if (depth == 0) { adone = 1; }
                                    }
                                    pos = pos + 1;
                                }
                            }
                            value = str_builder_build(asb);
                        }
                    }
                    # Other unquoted values (numbers, booleans): to the end of the line
                    # or to a `#` comment (TOML strings are always quoted).
                    else {
                        var ustart = pos;
                        while (pos < len && load8(d + pos) != 10 && load8(d + pos) != 35) { pos = pos + 1; }
                        var uend = pos;
                        while (uend > ustart) {
                            var tc = load8(d + uend - 1);
                            if (tc != 32 && tc != 13) { break; }
                            uend = uend - 1;
                        }
                        value = str_new(d + ustart, uend - ustart);
                    }
                }
                vec_push(cur_pairs, bayan_toml_pair_new(key, value));
            }
            while (pos < len && load8(d + pos) != 10) { pos = pos + 1; }
        }
    }
    if (vec_len(cur_pairs) > 0 || str_len(cur_name) > 0) {
        vec_push(sections, bayan_toml_section_new(cur_name, cur_pairs));
    }
    return sections;
}

# Sections (vec of bayan TOML sections) of the CYML file at Str path; empty when unreadable.
fn cyml_parse_file(path): i64 {
    # Whole file or nothing (1.5.3): never a half-read prefix.
    var content = _nous_read_file(path, NOUS_FILE_MAX);
    if (content == 0) { return vec_new(); }
    return nous_cyml_parse(content);
}

# Get a section's pairs by name from parsed sections
fn cyml_section_by_name(sections, name): i64 {
    var i = 0;
    while (i < vec_len(sections)) {
        var sec = vec_get(sections, i);
        if (str_eq(bayan_toml_section_name(sec), str_from(name)) == 1) {
            return bayan_toml_section_pairs(sec);
        }
        i = i + 1;
    }
    return 0;
}

# Value (Str) of `key` (cstr) in a section's pairs, or 0 when absent.
fn cyml_get(pairs, key): i64 {
    var skey = str_from(key);
    var i = 0;
    while (i < vec_len(pairs)) {
        var p = vec_get(pairs, i);
        if (str_eq(bayan_toml_pair_key(p), skey) == 1) {
            return bayan_toml_pair_value(p);
        }
        i = i + 1;
    }
    return 0;
}

# Parse a .cyml recipe file into a Recipe struct.
# Returns 0 on failure (unreadable, or no [package] section).
fn nous_recipe_parse_file(path): i64 {
    var sections = cyml_parse_file(path);
    if (vec_len(sections) == 0) { return 0; }

    # [package] section
    var pkg = cyml_section_by_name(sections, "package");
    if (pkg == 0) { return 0; }
    var name = cyml_get(pkg, "name");
    var ver = cyml_get(pkg, "version");
    var desc = cyml_get(pkg, "description");
    var license = cyml_get(pkg, "license");
    var arch = cyml_get(pkg, "arch");
    var groups_raw = cyml_get(pkg, "groups");
    var release_str = cyml_get(pkg, "release");
    if (name == 0) { name = str_from(""); }
    if (ver == 0) { ver = str_from(""); }
    if (desc == 0) { desc = str_from(""); }
    if (license == 0) { license = str_from(""); }
    if (arch == 0) { arch = str_from("x86_64"); }
    var groups = parse_toml_array(groups_raw);
    var release = 1;
    if (release_str != 0) { release = str_to_int(release_str); }

    # [source] section
    var src = cyml_section_by_name(sections, "source");
    # url/sha256 hold cyml_get's i64 (a Str or 0) and default to "" — the same
    # idiom as name/ver/desc above. Initialising them from str_from("") typed
    # the locals `Str`, and cyrius 6.6.20 warns "assigning non-pointer to typed
    # pointer" on each cyml_get assignment. Same values on every path.
    var url = 0;
    var sha256 = 0;
    var patches = vec_new();
    if (src != 0) {
        url = cyml_get(src, "url");
        if (url == 0) { url = str_from(""); }
        # github_release fallback
        if (str_len(url) == 0) {
            var gh = cyml_get(src, "github_release");
            if (gh != 0) {
                var asset = cyml_get(src, "release_asset");
                if (asset == 0) { asset = str_from(""); }
                # Build URL placeholder: github.com/owner/repo/releases
                var sb = str_builder_new();
                str_builder_add_cstr(sb, "https://github.com/");
                str_builder_add(sb, gh);
                str_builder_add_cstr(sb, "/releases");
                url = str_builder_build(sb);
            }
        }
        sha256 = cyml_get(src, "sha256");
        var pa = cyml_get(src, "patches");
        if (pa != 0) { patches = parse_toml_array(pa); }
    }
    if (url == 0) { url = str_from(""); }
    if (sha256 == 0) { sha256 = str_from(""); }

    # [depends] section
    var deps = cyml_section_by_name(sections, "depends");
    var rt_deps = vec_new();
    var bd_deps = vec_new();
    if (deps != 0) {
        var rt = cyml_get(deps, "runtime");
        if (rt != 0) { rt_deps = parse_toml_array(rt); }
        var bd = cyml_get(deps, "build");
        if (bd != 0) { bd_deps = parse_toml_array(bd); }
    }

    var r = recipe_alloc();
    recipe_set_pkg(r, name, ver, desc, license, arch);
    recipe_set_meta(r, groups, release, url, sha256, patches);
    recipe_set_deps(r, rt_deps, bd_deps);
    return r;
}

# Deprecated (1.5.3), removed in 2.0.0: takumi defines `recipe_parse_file` too.
# Deprecated alias of nous_recipe_parse_file.
#deprecated("use nous_recipe_parse_file; recipe_parse_file collides with takumi (removed in 2.0.0)")
fn recipe_parse_file(path): i64 { return nous_recipe_parse_file(path); }

# Read build-order.txt: returns vec of Str ("category/name" entries)
fn read_build_order(zugot_path): i64 {
    var order = vec_new();
    var bo_path = path_join(zugot_path, str_from("build-order.txt"));
    var content = _nous_read_file(bo_path, NOUS_FILE_MAX);
    if (content == 0) { return order; }
    var lines = str_split(content, 10);
    var i = 0;
    while (i < vec_len(lines)) {
        var lraw = vec_get(lines, i);
        var line = str_trim(lraw);
        # Skip empty lines and comments
        if (str_len(line) > 0 && load8(str_data(line)) != 35) {
            vec_push(order, line);
        }
        i = i + 1;
    }
    return order;
}

# Scan a zugot directory and load all .cyml recipes into a hashmap.
# Returns a RecipeDb.
#
# 1.5.3 (P1): every category directory is scanned, not a hard-coded list. The
# list named "desktop", but zugot's directory is "desktops" (196 recipes), and
# it named a "bazaar" that does not exist: 342 of 563 recipes loaded. Entries
# are visited in byte order, so the result no longer depends on the
# filesystem's listing order.
#
# Duplicate names (1.5.3, decision D6): zugot has 26 (e.g. base/curl and
# edge/curl, with different deps). The winner used to be whichever loaded
# last, and a crafted bazaar/zz-glibc.cyml replaced glibc's deps. Now the
# precedence is fixed: "base" first, then the other categories in byte order,
# then files in byte order within a category. The FIRST recipe with a name
# wins, and every later one is recorded in `nous_recipe_db_duplicates`.
#
# RecipeDb of every <zugot_path>/<category>/*.cyml plus build-order.txt.
fn recipe_db_load(zugot_path): i64 {
    var recipes = map_new();
    var where = map_new();
    var order = read_build_order(zugot_path);
    var db = recipe_db_new(zugot_path, recipes, order);
    var cats = vec_new();
    var all = dir_list(zugot_path);
    _nous_sort_strs(all);
    var ai = 0;
    while (ai < vec_len(all)) {
        var nm = vec_get(all, ai);
        if (str_eq_cstr(nm, "base") == 1) { vec_push(cats, nm); }
        ai = ai + 1;
    }
    ai = 0;
    while (ai < vec_len(all)) {
        var nm2 = vec_get(all, ai);
        if (str_len(nm2) > 0 && load8(str_data(nm2)) != 46 && str_eq_cstr(nm2, "base") == 0) {
            vec_push(cats, nm2);
        }
        ai = ai + 1;
    }
    var ci = 0;
    while (ci < vec_len(cats)) {
        var cat = vec_get(cats, ci);
        var cat_dir = path_join(zugot_path, cat);
        if (our_is_dir(_nous_cstr(cat_dir)) == 1) {
            var entries = dir_list(cat_dir);
            _nous_sort_strs(entries);
            var ei = 0;
            while (ei < vec_len(entries)) {
                var entry = vec_get(entries, ei);
                if (str_ends_with(entry, str_from(".cyml")) == 1) {
                    var recipe = nous_recipe_parse_file(path_join(cat_dir, entry));
                    if (recipe != 0) {
                        var rel = path_join(cat, entry);
                        var cn = _nous_cstr(rc_name(recipe));
                        if (map_has(recipes, cn) == 1) {
                            vec_push(rdb_duplicates(db), _nous_rdup_new(rc_name(recipe), map_get(where, cn), rel));
                        } else {
                            map_set(recipes, cn, recipe);
                            map_set(where, cn, rel);
                        }
                    }
                }
                ei = ei + 1;
            }
        }
        ci = ci + 1;
    }
    return db;
}

# RecipeDb field: shadowed recipes, a vec of duplicate entries. See nous_recipe_db_duplicates.
fn rdb_duplicates(d): i64 { return load64(d + 24); }

# A shadowed recipe: {name, kept "cat/file.cyml", ignored "cat/file.cyml"}.
fn _nous_rdup_new(name, kept, ignored): i64 {
    var p = alloc(24);
    store64(p, name); store64(p + 8, kept); store64(p + 16, ignored);
    return p;
}
# Duplicate entry: the shared package name (Str).
fn nous_rdup_name(p): i64 { return load64(p); }
# Duplicate entry: the recipe that won, "category/file.cyml" (Str).
fn nous_rdup_kept(p): i64 { return load64(p + 8); }
# Duplicate entry: the recipe it shadowed, "category/file.cyml" (Str).
fn nous_rdup_ignored(p): i64 { return load64(p + 16); }

# Every recipe a same-named earlier one shadowed, in load order (1.5.3, D6).
fn nous_recipe_db_duplicates(db): i64 { return rdb_duplicates(db); }

# The Recipe named Str name, or 0.
fn recipe_db_get(db, name): i64 {
    return map_get(rdb_recipes(db), _nous_cstr(name));
}

# The build order, a vec of Str ("category/name").
fn recipe_db_order(db): i64 {
    return rdb_order(db);
}

# How many distinct recipe names the RecipeDb holds.
fn recipe_db_count(db): i64 {
    return map_count(rdb_recipes(db));
}

# ResolvedPkg (SOURCE_COMMUNITY, size 0, trust 0) for a Recipe; deps are its runtime deps.
fn recipe_to_resolved(recipe): i64 {
    return resolved_pkg_new(
      rc_name(recipe), rc_ver(recipe), SOURCE_COMMUNITY,
      rc_desc(recipe), 0, rc_rt_deps(recipe), 0
      );
}

# --- Wire recipes into resolver ---

# Resolver field: the RecipeDb, or 0 when none is attached.
fn rs_rdb(r): i64 { return load64(r + 32); }
# Resolver: set the RecipeDb in place. See resolver_with_recipes.
fn rs_set_rdb(r, rdb): i64 { store64(r + 32, rdb); }
# Resolver field: the trace, a vec of Str lines.
fn rs_trace(r): i64 { return load64(r + 40); }
# Resolver field: 1 when tracing is on.
fn rs_trace_on(r): i64 { return load64(r + 48); }

# Turn tracing on for Resolver r; returns r.
fn resolver_with_trace(r): i64 { store64(r + 48, 1); return r; }

# Append "<prefix><name> ... <result>" to r's trace when tracing is on; returns 0.
fn trace_msg(r, prefix, name, result): i64 {
    if (rs_trace_on(r) == 0) { return 0; }
    var sb = str_builder_new();
    str_builder_add_cstr(sb, prefix);
    str_builder_add(sb, name);
    str_builder_add_cstr(sb, " ... ");
    str_builder_add_cstr(sb, result);
    vec_push(rs_trace(r), str_builder_build(sb));
    return 0;
}

# Resolver r's trace: a vec of Str lines, one per source lookup.
fn resolver_get_trace(r): i64 { return rs_trace(r); }
# Empty Resolver r's trace (tracing stays as it was).
fn resolver_clear_trace(r): i64 { store64(r + 40, vec_new()); }

# Attach a recipe database to a resolver.
fn resolver_with_recipes(r, rdb): i64 {
    rs_set_rdb(r, rdb);
    return r;
}

# ResolvedPkg for `name` from the attached RecipeDb (the community source), or 0.
fn resolve_from_recipe(r, name): i64 {
    var rdb = rs_rdb(r);
    if (rdb == 0) { return 0; }
    var recipe = recipe_db_get(rdb, name);
    if (recipe == 0) { return 0; }
    return recipe_to_resolved(recipe);
}

# resolver_resolve_all with the recipe DB as a fallback source: Ok(ResPlan) or Err.
fn resolver_resolve_all_with_recipes(r, names): Result { return _nous_resolve_closure(r, names, 1); }

# "not found" detail: who needed it, plus a typo suggestion when one is close.
fn _nous_not_found(r, name, requirer): Result {
    var sb = str_builder_new();
    if (requirer == 0) {
        str_builder_add_cstr(sb, "not in any source");
    } else {
        str_builder_add_cstr(sb, "required by `");
        str_builder_add(sb, requirer);
        str_builder_add_cstr(sb, "`");
    }
    var sug = suggest_package(name, collect_known_names(r));
    if (sug != 0) {
        str_builder_add_cstr(sb, "; did you mean `");
        str_builder_add(sb, sug);
        str_builder_add_cstr(sb, "`?");
    }
    return nous_err(NOUS_ERR_NOT_FOUND, name, str_builder_build(sb));
}

# The transitive closure of `names` (1.5.3: one core for both entry points;
# they were near-duplicates). A breadth-first queue of (name, requirer, is the
# requirer an apt package).
#
#   - A dependency of an APT package resolves from apt only (decision D5). Under
#     MarketplaceFirst, curl's `libssl3` used to be looked up in the marketplace
#     first, so a manifest named "libssl3" was spliced into apt's closure. Every
#     other name follows the resolver's strategy, plus the recipe DB when
#     `use_recipes`.
#   - A name that cannot be found is no longer skipped silently (decision D4).
#     A root, or a dependency of a non-apt package, is
#     Err(NOUS_ERR_NOT_FOUND) naming who needed it. An apt dependency apt cannot
#     show (a virtual package, an alternative) is recorded in
#     `nous_pl_unresolved`, because apt resolves those itself. Before, `a ->
#     ghost` gave Ok [a], and a missing root gave Ok [].
#   - The first time a name is reached decides how it resolves (breadth-first,
#     deterministic).
fn _nous_resolve_closure(r, names, use_recipes): Result {
    var graph = dep_graph_new();
    var q_name = vec_new();
    var q_req = vec_new();
    var q_sys = vec_new();
    var visited = map_new();
    var unresolved = vec_new();
    var fetched = map_new();      # apt-side names fetched: cstr -> pkg (0 = absent)
    var i = 0;
    while (i < vec_len(names)) {
        vec_push(q_name, vec_get(names, i));
        vec_push(q_req, 0);
        vec_push(q_sys, 0);
        i = i + 1;
    }
    var ph = 0;
    while (ph < vec_len(q_name)) {
        var name = vec_get(q_name, ph);
        var requirer = vec_get(q_req, ph);
        var from_sys = vec_get(q_sys, ph);
        ph = ph + 1;
        var cname = _nous_cstr(name);
        if (map_has(visited, cname) == 1) { continue; }
        map_set(visited, cname, 1);

        var pkg = 0;
        if (from_sys == 1) {
            # Batched (1.5.3, perf). The first time an apt-side name is not yet
            # fetched, fetch EVERY apt-side name queued so far in one apt call.
            # curl's 32-package closure took 32 calls (14.7 s); it now takes
            # one per breadth-first wave. Same results, same order.
            if (map_has(fetched, cname) == 0) {
                var want = vec_new();
                var wq = ph - 1;
                while (wq < vec_len(q_name)) {
                    var wn = vec_get(q_name, wq);
                    var wc = _nous_cstr(wn);
                    if (vec_get(q_sys, wq) == 1 && map_has(fetched, wc) == 0 && map_has(visited, wc) == 0) {
                        vec_push(want, wn);
                        map_set(fetched, wc, 0);
                    } elif (wq == ph - 1) {
                        vec_push(want, wn);
                        map_set(fetched, wc, 0);
                    }
                    wq = wq + 1;
                }
                var f_t, got = sysdb_info_many(rs_sys(r), want);
                if (is_err_result(f_t) == 1) { return Err(got); }
                var gk = _nous_sorted_keys(got);
                var gi = 0;
                while (gi < vec_len(gk)) {
                    map_set(fetched, vec_get(gk, gi), map_get(got, vec_get(gk, gi)));
                    gi = gi + 1;
                }
            }
            pkg = map_get(fetched, cname);
            if (pkg != 0) { trace_msg(r, "system: ", name, "hit"); }
            else { trace_msg(r, "system: ", name, "miss"); }
            if (pkg == 0) {
                vec_push(unresolved, _nous_unres_new(name, requirer));
                continue;
            }
        } else {
            var res_t, res = resolver_resolve(r, name);
            if (is_err_result(res_t) == 1) { return Err(res); }
            pkg = res;
            if (pkg == 0 && use_recipes == 1) { pkg = resolve_from_recipe(r, name); }
            if (pkg == 0) { return _nous_not_found(r, name, requirer); }
        }

        dep_graph_add(graph, pkg);
        var is_sys = 0;
        if (rp_src(pkg) == SOURCE_SYSTEM) { is_sys = 1; }
        var deps = rp_deps(pkg);
        var j = 0;
        while (j < vec_len(deps)) {
            var dep = vec_get(deps, j);
            if (map_has(visited, _nous_cstr(dep)) == 0) {
                vec_push(q_name, dep);
                vec_push(q_req, rp_name(pkg));
                vec_push(q_sys, is_sys);
            }
            j = j + 1;
        }
    }
    var p_t, plan = finalize_graph(r, graph);
    if (is_err_result(p_t) == 1) { return Err(plan); }
    store64(plan + 16, unresolved);
    return Ok(plan);
}

# Ok(ResPlan) for a closed DepGraph: cycle policy, conflict check, install order; else Err.
fn finalize_graph(r, graph): Result {
    # Cycles (1.5.3, decision D3; ADR 0005). Debian allows circular dependencies
    # (Policy §7.2), and real ones exist: on Debian 12 libc6 depends on
    # libgcc-s1, which depends on libc6. Rejecting every cycle failed any
    # transitive resolve that reached libc6 through apt. A cycle made ONLY of apt
    # (SOURCE_SYSTEM) packages is accepted, and its members install in byte
    # order (Policy: "the breaking point is arbitrary"). Any cycle that touches a
    # marketplace / community / flutter package is still an error.
    var nb = alloc(8);
    var ab = alloc(8);
    var comps = _nous_tarjan(graph, nb, ab);
    var tnames = load64(nb);
    var tadj = load64(ab);
    var ci = 0;
    while (ci < vec_len(comps)) {
        var comp = vec_get(comps, ci);
        if (_nous_comp_cyclic(comp, tadj) == 1) {
            var all_sys = 1;
            var mi = 0;
            while (mi < vec_len(comp)) {
                var node = map_get(dg_nodes(graph), vec_get(tnames, vec_get(comp, mi)));
                if (rp_src(node) != SOURCE_SYSTEM) { all_sys = 0; }
                mi = mi + 1;
            }
            if (all_sys == 0) {
                return nous_err(NOUS_ERR_DEPENDENCY_CYCLE,
                  format_cycle(_nous_comp_cycle_path(comp, tadj, tnames)), 0);
            }
        }
        ci = ci + 1;
    }

    # Version constraints (1.5.3, decisions D1 + D2). Every constraint on a
    # dependency is kept, with who required it, and they are intersected as
    # version ranges. Before, only the FIRST constraint was stored and each
    # later one was compared with that one alone (`*`, `=1.0.0`, `=2.0.0`
    # passed), and constraints_compatible sampled about five versions. Then
    # the version actually chosen must satisfy every range: `>=2.0.0` used to
    # resolve to 1.0.0 without a word. apt and community versions compare as
    # Debian versions (deb-version(7)), the rest as SemVer.
    var cons = map_new();          # dep cstr -> vec of {range, requirer, text}
    var all_nodes = _nous_sorted_keys(dg_nodes(graph));
    var i = 0;
    while (i < vec_len(all_nodes)) {
        var pkg = map_get(dg_nodes(graph), vec_get(all_nodes, i));
        var deps = rp_deps(pkg);
        var manifest_deps = map_new();
        var mp = nous_registry_get(rs_reg(r), rp_name(pkg));
        if (mp != 0 && rp_src(pkg) != SOURCE_SYSTEM && rp_src(pkg) != SOURCE_COMMUNITY) {
            manifest_deps = mpkg_deps(mp);
        }
        var j = 0;
        while (j < vec_len(deps)) {
            var dep = vec_get(deps, j);
            var cdep = _nous_cstr(dep);
            var text = map_get(manifest_deps, cdep);
            if (text != 0) {
                var ct = constraint_parse(text);
                if (nous_constraint_error(ct) != 0) {
                    var esb = str_builder_new();
                    str_builder_add(esb, rp_name(pkg));
                    str_builder_add_cstr(esb, " requires ");
                    str_builder_add(esb, text);
                    str_builder_add_cstr(esb, ": ");
                    str_builder_add(esb, nous_constraint_error(ct));
                    return nous_err(NOUS_ERR_INVALID_VERSION_CONSTRAINT, dep, str_builder_build(esb));
                }
                if (map_has(cons, cdep) == 0) { map_set(cons, cdep, vec_new()); }
                var ent = alloc(24);
                store64(ent, _nous_range_of(ct)); store64(ent + 8, rp_name(pkg)); store64(ent + 16, text);
                vec_push(map_get(cons, cdep), ent);
            }
            j = j + 1;
        }
        i = i + 1;
    }
    var ckeys = _nous_sorted_keys(cons);
    var ki = 0;
    while (ki < vec_len(ckeys)) {
        var cdep2 = vec_get(ckeys, ki);
        var ents = map_get(cons, cdep2);
        var acc = load64(vec_get(ents, 0));
        var ei = 1;
        while (ei < vec_len(ents)) {
            var cur = vec_get(ents, ei);
            var nxt = _nous_range_intersect(acc, load64(cur));
            if (nxt == 0) {
                # Name a pair that cannot both hold when there is one, else every
                # requirement so far.
                var sb = str_builder_new();
                var pj = 0;
                var found = 0;
                while (pj < ei && found == 0) {
                    var prev = vec_get(ents, pj);
                    if (_nous_range_intersect(load64(prev), load64(cur)) == 0) {
                        str_builder_add(sb, load64(prev + 8));
                        str_builder_add_cstr(sb, " requires ");
                        str_builder_add(sb, load64(prev + 16));
                        found = 1;
                    }
                    pj = pj + 1;
                }
                if (found == 0) {
                    pj = 0;
                    while (pj < ei) {
                        var pv = vec_get(ents, pj);
                        if (pj > 0) { str_builder_add_cstr(sb, " and "); }
                        str_builder_add(sb, load64(pv + 8));
                        str_builder_add_cstr(sb, " requires ");
                        str_builder_add(sb, load64(pv + 16));
                        pj = pj + 1;
                    }
                }
                str_builder_add_cstr(sb, ", but ");
                str_builder_add(sb, load64(cur + 8));
                str_builder_add_cstr(sb, " requires ");
                str_builder_add(sb, load64(cur + 16));
                return nous_err(NOUS_ERR_VERSION_CONFLICT, str_from(cdep2), str_builder_build(sb));
            }
            acc = nxt;
            ei = ei + 1;
        }
        if (map_has(dg_nodes(graph), cdep2) == 1) {
            var node = map_get(dg_nodes(graph), cdep2);
            ei = 0;
            while (ei < vec_len(ents)) {
                var e2 = vec_get(ents, ei);
                if (_nous_range_contains_ver(load64(e2), rp_ver(node), rp_src(node)) == 0) {
                    var vb = str_builder_new();
                    str_builder_add(vb, load64(e2 + 8));
                    str_builder_add_cstr(vb, " requires ");
                    str_builder_add(vb, load64(e2 + 16));
                    str_builder_add_cstr(vb, ", but the version available is ");
                    str_builder_add(vb, rp_ver(node));
                    str_builder_add_cstr(vb, " (");
                    str_builder_add(vb, source_to_str(rp_src(node)));
                    str_builder_add_cstr(vb, ")");
                    return nous_err(NOUS_ERR_VERSION_CONFLICT, str_from(cdep2), str_builder_build(vb));
                }
                ei = ei + 1;
            }
        }
        ki = ki + 1;
    }

    # Install order (1.5.3): Tarjan's emission order, dependencies first, with
    # each component's members in byte order. pl_order is INSTALL order, the
    # same as pl_packages and as docs/api.md says; it used to be Kahn's raw order
    # (dependents first), the reverse, while ark printed it as "deps-first".
    var ordered_pkgs = vec_new();
    var install_order = vec_new();
    ci = 0;
    while (ci < vec_len(comps)) {
        var members = vec_get(comps, ci);
        _nous_sort_ints(members);
        var k = 0;
        while (k < vec_len(members)) {
            var cn = vec_get(tnames, vec_get(members, k));
            vec_push(ordered_pkgs, map_get(dg_nodes(graph), cn));
            vec_push(install_order, str_from(cn));
            k = k + 1;
        }
        ci = ci + 1;
    }

    return Ok(res_plan_new(ordered_pkgs, install_order));
}

# --- updates.cyr ---

# nous/updates — multi-source available-update detection (1.3.0).
#
# resolver_updates (apt-only, legacy) stays for back-compat. resolver_check_updates
# is the unified detector: the apt/system leg comes from sysdb (which knows both
# installed AND available via `apt list --upgradable`), and for every other source
# the caller supplies the available version through a pluggable lookup callback.
# nous owns the semver comparison and normalization into avail_update records and
# stays free of any remote/transport concern — the marketplace caller (ark, via
# mela's /latest endpoint) and a future native index both plug into the same seam.
#
# Bundled AFTER version.cyr (see cyrius.cyml [lib].modules) so it can use
# semver_cmp / semver_parse.

# True (1) when `avail` is a strictly newer version than `installed`. semver_parse
# is lenient (a non-semver suffix compares on its numeric prefix), so e.g.
# "1.4.0" > "1.3.9" and "2.0.0" > "1.9.9"; equal/older return 0.
#
# 1 when Str avail is a strictly newer SemVer than Str installed, else 0 (also for 0 or "").
fn update_is_newer(avail, installed): i64 {
    if (avail == 0) { return 0; }
    if (str_len(avail) == 0) { return 0; }
    if (installed == 0) { return 0; }
    # semver_parse returns 0 on a malformed/oversized component (>i64 range);
    # `avail` is externally-supplied (the marketplace callback), so guard both
    # results — a null SemVer into semver_cmp would deref load64(0).
    var pa = semver_parse(avail);
    if (pa == 0) { return 0; }
    var pi = semver_parse(installed);
    if (pi == 0) { return 0; }
    return semver_cmp(pa, pi) > 0;
}

# Detect available updates across all sources.
#   r         resolver — provides the apt/system leg via sysdb.
#   installed vec of installed_pkg (ip_name/ip_ver/ip_src), the caller's
#             authoritative installed set (e.g. ark's PackageDb). SOURCE_SYSTEM
#             entries are ignored here; the apt leg is swept globally below.
#   avail_fn  fn pointer: avail_fn(name, source) -> available-version Str (or 0/""
#             when unknown). Pass 0 to disable non-apt detection (apt-only, i.e.
#             equivalent to resolver_updates).
# Returns Ok(vec of avail_update).
fn resolver_check_updates(r, installed, avail_fn): Result {
    var out = vec_new();
    # System/apt leg — sysdb knows installed AND available globally.
    var sres_t, sres = sysdb_updates(rs_sys(r));
    # 1.5.1: a system-leg Err is surfaced, not skipped (see resolver_search).
    if (is_err_result(sres_t) == 1) { return Err(sres); }
    if (is_ok(sres_t) == 1) {
        var k = 0;
        while (k < vec_len(sres)) {
            vec_push(out, vec_get(sres, k));
            k = k + 1;
        }
    }
    # Non-apt legs — compare each installed package against the caller-supplied
    # available version via the pluggable lookup.
    if (avail_fn != 0) {
        var i = 0;
        while (i < vec_len(installed)) {
            var pkg = vec_get(installed, i);
            var src = ip_src(pkg);
            if (src != SOURCE_SYSTEM) {
                var av = fncall2(avail_fn, ip_name(pkg), src);
                if (nous_update_is_newer_src(av, ip_ver(pkg), src) == 1) {
                    vec_push(out, avail_update_new(ip_name(pkg), src, ip_ver(pkg), av, 0));
                }
            }
            i = i + 1;
        }
    }
    return Ok(out);
}

# update_is_newer, per source (1.5.3, decision D2). Community (zugot) versions
# are Debian-style ("10.3p1", "1.9.17p2", "149.0.2-2"), so they compare by
# deb-version(7). Marketplace and Flutter versions compare as SemVer. ark sends
# zugot versions through resolver_check_updates, where the SemVer comparison
# missed suffix and revision updates and offered epoch downgrades.
#
# 1 when avail is newer than installed for PackageSource src: Debian order for apt/community, else SemVer.
fn nous_update_is_newer_src(avail, installed, src): i64 {
    if (src == SOURCE_COMMUNITY || src == SOURCE_SYSTEM) {
        if (avail == 0 || installed == 0) { return 0; }
        if (str_len(avail) == 0) { return 0; }
        return nous_deb_version_cmp(avail, installed) > 0;
    }
    return update_is_newer(avail, installed);
}
