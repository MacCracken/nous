fn test_semver_overflow() {
    test_group("semver_overflow");
    # Crafted version with huge numbers should not crash
    var v = semver_parse(
      str_from("99999999999999999999999.0.0"));
    assert_eq(v, 0, "overflow returns 0");
    # Normal large version should work
    var v2 = semver_parse(str_from("999.999.999"));
    assert(v2 != 0, "large but valid");
    # 1.5.3: the guard is exact at the i64 boundary (it used to wrap there).
    assert_eq(semver_parse(str_from("9223372036854775808.0.0")), 0, "INT64_MAX+1 is overflow");
    var vmax = semver_parse(str_from("9223372036854775807.0.0"));
    assert(vmax != 0, "INT64_MAX itself parses");
    assert(sv_major(vmax) > 0, "INT64_MAX stays positive");
    assert_eq(sv_major(v2), 999, "999 major");
}

