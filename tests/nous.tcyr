}

# 1.5.1 renamed ErrKind's bare ERR_* members to NOUS_ERR_*. The values are the
# JSON wire format (`{"kind":N}`), so the rename must leave every one unchanged.
fn test_err_kind_values() {
    test_group("err_kind_values");
    assert_eq(NOUS_ERR_COMMAND_EXEC, 0, "COMMAND_EXEC = 0");
    assert_eq(NOUS_ERR_REGISTRY_IO, 1, "REGISTRY_IO = 1");
    assert_eq(NOUS_ERR_INVALID_MANIFEST, 2, "INVALID_MANIFEST = 2");
    assert_eq(NOUS_ERR_INVALID_PACKAGE_NAME, 3, "INVALID_PACKAGE_NAME = 3");
    assert_eq(NOUS_ERR_INVALID_VERSION_CONSTRAINT, 4,
      "INVALID_VERSION_CONSTRAINT = 4");
    assert_eq(NOUS_ERR_DEPENDENCY_CYCLE, 5, "DEPENDENCY_CYCLE = 5");
    assert_eq(NOUS_ERR_VERSION_CONFLICT, 6, "VERSION_CONFLICT = 6");
    assert_eq(NOUS_ERR_NOT_FOUND, 7, "NOT_FOUND = 7 (1.5.3)");
    assert_eq(NOUS_ERR_AMBIGUOUS_SOURCE, 8, "AMBIGUOUS_SOURCE = 8 (1.5.3)");
}

# A `head -c N /dev/zero` argv: exactly N bytes of output, no shell, no PATH.
fn head_args(nbytes): i64 {
    var a = vec_new();
    vec_push(a, "/usr/bin/head");
    vec_push(a, "-c");
    vec_push(a, _nous_cstr(str_from_int(nbytes)));
    vec_push(a, "/dev/zero");
    return a;
}

# 1.5.1 capture fix. Before it, the 200,000-byte capture came back as 65,536
# bytes, and the first cmd_run result read "WORLD\n" once the second ran.
# (1.5.2: through nous_cmd_capture; cmd_run is deprecated.)
fn test_capture_complete() {
    test_group("capture_complete");
    # Aliasing: each result is an owned copy, not a view of a shared buffer.
    var a_t, a = nous_cmd_capture(str_from("echo hello"));
    var b_t, b = nous_cmd_capture(str_from("echo WORLD"));
    assert_eq(is_ok(a_t), 1, "first capture Ok");
    assert_eq(is_ok(b_t), 1, "second capture Ok");
    assert(str_eq(a, str_from("hello\n")), "first capture survives the second");
    assert(str_eq(b, str_from("WORLD\n")), "second capture intact");
    # Truncation: more than the old 64 KiB, at the default limits.
    var big_t, big = nous_cmd_capture(str_from("/usr/bin/head -c 200000 /dev/zero"));
    assert_eq(is_ok(big_t), 1, "200000-byte capture is Ok");
    assert_eq(str_len(big), 200000, "all 200000 bytes captured");
    # Growth within explicit limits: 1024 -> 2048 -> 4096.
    var g_t, g = nous_capture_n(head_args(3000), 1024, 4096);
    assert_eq(is_ok(g_t), 1, "3000 bytes fit under a 4096 max");
    assert_eq(str_len(g), 3000, "grown capture is complete");
    var x_t, x = nous_capture_n(head_args(4096), 1024, 4096);
    assert_eq(is_ok(x_t), 1, "exactly max bytes is complete, not overflow");
    assert_eq(str_len(x), 4096, "exactly-max capture length");
    # Overflow: an Err naming the command and the limit, never a partial Ok.
    var o_t, o = nous_capture_n(head_args(5000), 1024, 4096);
    assert_eq(is_err_result(o_t), 1, "5000 bytes over a 4096 max is Err");
    assert_eq(ne_kind(o), NOUS_ERR_COMMAND_EXEC, "overflow kind");
    assert(str_contains(ne_msg(o), str_from("/usr/bin/head -c 5000")),
      "overflow names the command");
    assert(str_contains(ne_detail(o), str_from("4096-byte capture limit")),
      "overflow names the limit");
    # No output stays Ok(0), the pre-1.5.1 contract.
    var e_t, e = nous_cmd_capture(str_from("true"));
    assert_eq(is_ok(e_t), 1, "no output is Ok");
    assert_eq(e, 0, "no output is Ok(0)");
}

# A run cut short by the stdlib's idle deadline is an Err, not short output.
fn test_capture_deadline() {
    test_group("capture_deadline");
    var prev = proc_set_timeout_ms(200);
    var a = vec_new();
    vec_push(a, "/usr/bin/sleep");
    vec_push(a, "5");
    var d_t, d = nous_capture(a);
    proc_set_timeout_ms(prev);
    assert_eq(is_err_result(d_t), 1, "deadline cut is Err");
    assert(str_contains(ne_detail(d), str_from("idle deadline")),
      "deadline Err says why");
    # 1.5.3: with no caller deadline, nous applies its own default and
    # restores the caller's 0 afterwards.
    var keep = NOUS_CAPTURE_IDLE_MS;
    NOUS_CAPTURE_IDLE_MS = 150;
    assert_eq(proc_timeout_ms(), 0, "caller has no deadline");
    var e_t, e = nous_capture(a);
    NOUS_CAPTURE_IDLE_MS = keep;
    assert_eq(is_err_result(e_t), 1, "the default deadline cuts a hung child");
    assert_eq(proc_timeout_ms(), 0, "the caller's setting is restored");
}

# 1.5.2: nous_which_exists replaces the deprecated bare which_exists.
fn test_which_exists() {
    test_group("which_exists");
    assert_eq(nous_which_exists("sh"), 1, "sh is on PATH");
    assert_eq(nous_which_exists("nous-no-such-tool-1f3a"), 0,
      "a missing tool is 0");
    # 1.5.3: a directory or a non-executable file is not a tool.
    assert_eq(_nous_is_exec_file("/tmp"), 0, "a directory is not a tool");
    assert_eq(_nous_is_exec_file("/etc/passwd"), 0, "a non-executable file is not a tool");
    assert_eq(_nous_is_exec_file("/bin/sh"), 1, "/bin/sh is a tool");
}

# 1.5.3: the reference for the merge sort, which is the ≤1.5.2 insertion sort
# verbatim (stable: a tie keeps input order).
fn ref_insertion_sort_installed(v): i64 {
    var len = vec_len(v);
    var i = 1;
    while (i < len) {
        var key = vec_get(v, i);
        var kn = ip_name(key);
        var j = i - 1;
        while (j >= 0) {
            var vj = vec_get(v, j);
            if (str_compare(ip_name(vj), kn) <= 0) { break; }
            vec_set(v, j + 1, vj);
            j = j - 1;
        }
        vec_set(v, j + 1, key);
        i = i + 1;
    }
    return 0;
}

# n InstalledPkgs with LCG names drawn from `modv` values (a small modv means
# many ties); ip_size holds the input index, so tie order is visible.
fn mk_sort_case(n, seed, modv): i64 {
    var v = vec_new();
    var i = 0;
    var x = seed;
    while (i < n) {
        x = (x * 1103515245 + 12345) % 2147483648;
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "p");
        str_builder_add_int(sb, x % modv);
        vec_push(v, installed_pkg_new(str_builder_build(sb), str_from("1"), SOURCE_SYSTEM, 0, i, 0));
        i = i + 1;
    }
    return v;
}

# 1.5.3: the merge sort must give the insertion sort's order element for
# element, ties included. That keeps resolution output byte-identical to 1.5.2.
fn test_sort_order_identical() {
    test_group("sort_order_identical");
    var sizes = vec_new();
    vec_push(sizes, 0); vec_push(sizes, 1); vec_push(sizes, 2); vec_push(sizes, 3);
    vec_push(sizes, 7); vec_push(sizes, 64); vec_push(sizes, 1000); vec_push(sizes, 3001);
    var mods = vec_new();
    vec_push(mods, 1); vec_push(mods, 7); vec_push(mods, 100000);
    var mismatched = 0;
    var si = 0;
    while (si < vec_len(sizes)) {
        var mi = 0;
        while (mi < vec_len(mods)) {
            var n = vec_get(sizes, si);
            var base = mk_sort_case(n, 777 + n + mi, vec_get(mods, mi));
            var a = vec_new();
            var b = vec_new();
            var k = 0;
            while (k < n) { vec_push(a, vec_get(base, k)); vec_push(b, vec_get(base, k)); k = k + 1; }
            ref_insertion_sort_installed(a);
            sort_installed(b);
            k = 0;
            while (k < n) {
                if (vec_get(a, k) != vec_get(b, k)) { mismatched = mismatched + 1; }
                k = k + 1;
            }
            mi = mi + 1;
        }
        si = si + 1;
    }
    assert_eq(mismatched, 0, "merge sort order == insertion sort order (24 cases)");
    # The three entry points share the sort; check the other two orders too.
    var rv = vec_new();
    vec_push(rv, resolved_pkg_new(str_from("zlib"), str_from("1"), SOURCE_SYSTEM, str_from(""), 0, vec_new(), 1));
    vec_push(rv, resolved_pkg_new(str_from("acl"), str_from("1"), SOURCE_SYSTEM, str_from(""), 0, vec_new(), 1));
    vec_push(rv, resolved_pkg_new(str_from("bash"), str_from("1"), SOURCE_SYSTEM, str_from(""), 0, vec_new(), 1));
    sort_resolved(rv);
    assert(str_eq(rp_name(vec_get(rv, 0)), str_from("acl")), "sort_resolved first");
    assert(str_eq(rp_name(vec_get(rv, 2)), str_from("zlib")), "sort_resolved last");
}

fn test_semver_eq() {
    test_group("semver_eq");
    var a = semver_parse(str_from("1.2.3"));
    var b = semver_parse(str_from("1.2.3"));
    var c = semver_parse(str_from("1.2.4"));
    assert(semver_eq(a, b), "equal");
    assert(semver_eq(a, c) == 0, "not equal");
}

fn test_caret_zero() {
    test_group("caret_zero");
    # ^0.2.3 means >=0.2.3, <0.3.0
    var c = constraint_parse(str_from("^0.2.3"));
    assert(constraint_matches(c, semver_parse(str_from("0.2.3"))),
      "0.2.3 in ^0.2.3");
    assert(constraint_matches(c, semver_parse(str_from("0.2.9"))),
      "0.2.9 in ^0.2.3");
    assert(constraint_matches(c,
        semver_parse(str_from("0.3.0"))) == 0,
      "0.3.0 not in ^0.2.3");
    assert(constraint_matches(c,
        semver_parse(str_from("1.0.0"))) == 0,
      "1.0.0 not in ^0.2.3");
    # ^0.0.3 means >=0.0.3, <0.0.4
    var c2 = constraint_parse(str_from("^0.0.3"));
    assert(constraint_matches(c2, semver_parse(str_from("0.0.3"))),
      "0.0.3 in ^0.0.3");
    assert(constraint_matches(c2,
        semver_parse(str_from("0.0.4"))) == 0,
      "0.0.4 not in ^0.0.3");
}

fn test_tilde_zero() {
    test_group("tilde_zero");
    # ~0.2.0 means >=0.2.0, <0.3.0 — same major.minor
    var c = constraint_parse(str_from("~0.2.0"));
    assert(constraint_matches(c, semver_parse(str_from("0.2.0"))),
      "0.2.0 in ~0.2");
    assert(constraint_matches(c, semver_parse(str_from("0.2.9"))),
      "0.2.9 in ~0.2");
    assert(constraint_matches(c,
        semver_parse(str_from("0.3.0"))) == 0,
      "0.3.0 not in ~0.2");
}

