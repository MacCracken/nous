fn test_integration_apt() {
    test_group("integration_apt");
    var db = sysdb_new();
    if (sysdb_available(db) == 1) {
        # Test with a package that exists on all Debian/Ubuntu
        var info_t, info = sysdb_info(db, str_from("coreutils"));
        if (info != 0) {
            assert(str_len(rp_name(info)) > 0, "has name");
            assert(str_len(rp_ver(info)) > 0, "has version");
            assert_eq(rp_src(info), SOURCE_SYSTEM, "system source");
            assert_eq(rp_trust(info), 1, "trusted");
        }
        # Search
        var sr_t, sr = sysdb_search(db, str_from("coreutils"));
        assert(vec_len(sr) > 0, "search found results");
        # is_installed
        var inst_t, inst = sysdb_is_installed(db,
          str_from("coreutils"));
        assert_eq(inst, 1, "coreutils installed");
        # 1.5.2: pins 1.5.1's Err propagation. With the capture limit forced to
        # 16 bytes the system leg cannot fit, so the resolver must return Err,
        # not Ok with the system results missing. (`dpkg-query -W` over every
        # package and `apt-cache search coreutils` are both over 16 bytes.
        # `apt list --upgradable` is left out: with nothing to upgrade it can
        # fit.)
        var d = mkdir_test();
        var c = mkdir_test();
        var r_t, r = resolver_new(d, c);
        var prev_max = NOUS_CAPTURE_MAX;
        NOUS_CAPTURE_MAX = 16;
        var l_t, l = resolver_list(r);
        var s_t, s = resolver_search(r, str_from("coreutils"));
        NOUS_CAPTURE_MAX = prev_max;
        assert_eq(is_err_result(l_t), 1, "resolver_list surfaces an overflow");
        assert_eq(ne_kind(l), NOUS_ERR_COMMAND_EXEC, "list overflow kind");
        assert_eq(is_err_result(s_t), 1, "resolver_search surfaces an overflow");
        assert_eq(ne_kind(s), NOUS_ERR_COMMAND_EXEC, "search overflow kind");
        rm_rf(d); rm_rf(c);
        # 1.5.3 on real apt. A marketplace manifest named like an apt package
        # (libc6) must not be spliced into apt's closure (D5), and curl's
        # closure crosses libc6 <-> libgcc-s1, which must not fail (D3). Names
        # chosen to exist on both Debian and Ubuntu.
        var d2 = mkdir_test();
        var c2 = mkdir_test();
        write_manifest(d2, "libc6", "native");
        write_manifest(d2, "coreutils", "native");
        var r2_t, r2 = resolver_new(d2, c2);
        var cn = vec_new();
        vec_push(cn, str_from("curl"));
        var cp_t, cp = resolver_resolve_all(r2, cn);
        assert_eq(is_ok(cp_t), 1, "curl's apt closure resolves despite libc6's cycle");
        var libc_src = 0 - 1;
        if (is_ok(cp_t) == 1) {
            var pk = pl_packages(cp);
            var ki = 0;
            while (ki < vec_len(pk)) {
                if (str_eq(rp_name(vec_get(pk, ki)), str_from("libc6")) == 1) { libc_src = rp_src(vec_get(pk, ki)); }
                ki = ki + 1;
            }
        }
        assert_eq(libc_src, SOURCE_SYSTEM, "an apt dependency resolves from apt, not the marketplace");
        resolver_with_strategy(r2, strategy_search_all());
        var a_t, a = resolver_resolve(r2, str_from("coreutils"));
        assert_eq(is_err_result(a_t), 1, "SearchAll: a name in two sources is an Err");
        assert_eq(ne_kind(a), NOUS_ERR_AMBIGUOUS_SOURCE, "kind AMBIGUOUS_SOURCE");
        rm_rf(d2); rm_rf(c2);
    }
}

fn test_cyml_parse_sections() {
    test_group("cyml_parse_sections");
    var src = str_from("[package]\nname = \"test\"\nversion = \"1.0\"\n\n[depends]\nruntime = [\"glibc\"]\n");
    var sections = nous_cyml_parse(src);
    assert(vec_len(sections) >= 2, "2+ sections");
    var pkg = cyml_section_by_name(sections, "package");
    assert(pkg != 0, "has package");
    var name = cyml_get(pkg, "name");
    assert(str_eq(name, str_from("test")), "name=test");
    var deps = cyml_section_by_name(sections, "depends");
    assert(deps != 0, "has depends");
    var rt = cyml_get(deps, "runtime");
    assert(rt != 0, "has runtime");
    var parsed = parse_toml_array(rt);
    assert_eq(vec_len(parsed), 1, "1 dep");
    assert(str_eq(vec_get(parsed, 0), str_from("glibc")), "glibc");
}

fn test_sysdb_unavailable() {
    test_group("sysdb_unavailable");
    var db = sysdb_make(0);
    assert_eq(sysdb_available(db), 0, "unavailable");
    var srch_t, srch = sysdb_search(db, str_from("x"));
    assert_eq(vec_len(srch), 0, "search empty");
    var inst_t, inst = sysdb_is_installed(db, str_from("x"));
    assert_eq(inst, 0, "not installed");
    var gi_t, gi = sysdb_get_installed(db, str_from("x"));
    assert_eq(gi, 0, "no get");
    var lst_t, lst = sysdb_list(db);
    assert_eq(vec_len(lst), 0, "list empty");
    var ups_t, ups = sysdb_updates(db);
    assert_eq(vec_len(ups), 0, "no updates");
    var info_t, info = sysdb_info(db, str_from("x"));
    assert_eq(info, 0, "no info");
}

# 1.3.0 — pluggable multi-source update detection.
fn t_avail_two(name, src) { return str_from("2.0.0"); }
fn t_avail_same(name, src) { return str_from("1.0.0"); }

fn updates_has(ups, name) {
    var i = 0;
    while (i < vec_len(ups)) {
        if (str_eq(load64(vec_get(ups, i)), name) == 1) { return 1; }
        i = i + 1;
    }
    return 0;
}

fn test_check_updates_pluggable() {
    test_group("check_updates_pluggable");
    # update_is_newer — semver comparison.
    assert_eq(update_is_newer(str_from("1.4.0"), str_from("1.3.9")), 1, "1.4.0 > 1.3.9");
    assert_eq(update_is_newer(str_from("2.0.0"), str_from("1.9.9")), 1, "2.0.0 > 1.9.9");
    assert_eq(update_is_newer(str_from("1.0.0"), str_from("1.0.0")), 0, "equal -> none");
    assert_eq(update_is_newer(str_from("1.0.0"), str_from("1.2.0")), 0, "older -> none");
    assert_eq(update_is_newer(str_from(""), str_from("1.0.0")), 0, "empty avail -> none");
    assert_eq(update_is_newer(0, str_from("1.0.0")), 0, "null avail -> none");
    # Hardening: an oversized (>i64) component from the untrusted callback is
    # treated as not-newer rather than crashing (semver_parse returns 0).
    assert_eq(update_is_newer(str_from("99999999999999999999"), str_from("1.0.0")), 0, "oversized avail -> none");
    assert_eq(update_is_newer(str_from("1.0.0"), str_from("99999999999999999999")), 0, "oversized installed -> none");

    var d = mkdir_test();
    var c = mkdir_test();
    var r_t, r = resolver_new(d, c);
    var inst = vec_new();
    vec_push(inst, installed_pkg_new(str_from("agent"), str_from("1.0.0"), SOURCE_MARKETPLACE, 0, 0, 0));

    # avail_fn returns a newer version -> the marketplace package shows an update.
    var ups_t, ups = resolver_check_updates(r, inst, &t_avail_two);
    assert_eq(updates_has(ups, str_from("agent")), 1, "newer avail -> update emitted");
    # avail_fn returns the same version -> no marketplace update.
    var ups2_t, ups2 = resolver_check_updates(r, inst, &t_avail_same);
    assert_eq(updates_has(ups2, str_from("agent")), 0, "same avail -> no update");
    # avail_fn == 0 -> apt-only, no marketplace detection.
    var ups3_t, ups3 = resolver_check_updates(r, inst, 0);
    assert_eq(updates_has(ups3, str_from("agent")), 0, "no avail_fn -> apt-only");

    rm_rf(d); rm_rf(c);
}

