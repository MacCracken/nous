# 1.6.1: a Flutter-runtime registry package reports SOURCE_FLUTTER_APP from
# search and list, as it does from resolve. Both used to say marketplace.
fn test_flutter_labels() {
    test_group("flutter_labels");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest(d, "fl-app", "flutter");
    write_manifest(d, "nat-app", "native");
    var r_t, r = resolver_new(d, c);
    var sr_t, sr = resolver_search(r, str_from("app"));
    assert_eq(is_ok(sr_t), 1, "search ok");
    var fl_s = 0 - 1;
    var nat_s = 0 - 1;
    var all_in = 1;
    var res = sr_results(sr);
    var srcs = sr_sources(sr);
    var i = 0;
    while (i < vec_len(res)) {
        var p = vec_get(res, i);
        if (str_eq_cstr(rp_name(p), "fl-app") == 1) { fl_s = rp_src(p); }
        if (str_eq_cstr(rp_name(p), "nat-app") == 1) { nat_s = rp_src(p); }
        var j = 0;
        var hit = 0;
        while (j < vec_len(srcs)) { if (vec_get(srcs, j) == rp_src(p)) { hit = 1; } j = j + 1; }
        if (hit == 0) { all_in = 0; }
        i = i + 1;
    }
    assert_eq(fl_s, SOURCE_FLUTTER_APP, "search labels a Flutter app flutter-app");
    assert_eq(nat_s, SOURCE_MARKETPLACE, "search labels a native package marketplace");
    assert_eq(all_in, 1, "every search result's source is in sr_sources");
    assert_eq(vec_get(srcs, 1), SOURCE_FLUTTER_APP, "sr_sources lists flutter-app");
    var ls_t, ls = resolver_list(r);
    var fl_l = 0 - 1;
    var nat_l = 0 - 1;
    i = 0;
    while (i < vec_len(ls)) {
        var q = vec_get(ls, i);
        if (str_eq_cstr(ip_name(q), "fl-app") == 1) { fl_l = ip_src(q); }
        if (str_eq_cstr(ip_name(q), "nat-app") == 1) { nat_l = ip_src(q); }
        i = i + 1;
    }
    assert_eq(fl_l, SOURCE_FLUTTER_APP, "list labels a Flutter app flutter-app");
    assert_eq(nat_l, SOURCE_MARKETPLACE, "list labels a native package marketplace");
    var rv_t, rv = resolver_resolve(r, str_from("fl-app"));
    assert_eq(rp_src(rv), fl_s, "resolve and search agree");
    assert_eq(rp_src(rv), fl_l, "resolve and list agree");
    # A manifest with no runtime at all (built in code, runtime 0) is marketplace.
    var ag = nous_agent_info_new(str_from("bare"), str_from("1.0.0"), str_from(""));
    var bare = installed_mpkg_new(manifest_new(ag, map_new(), 0), 0, str_from("/x"), 0);
    assert_eq(_nous_mkt_src(bare), SOURCE_MARKETPLACE, "runtime 0 is marketplace");
    rm_rf(d); rm_rf(c);
}

fn test_deterministic_order() {
    test_group("deterministic_order");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest(d, "zeta-pkg", "native");
    write_manifest(d, "alpha-pkg", "native");
    write_manifest(d, "mid-pkg", "native");
    var r_t, r = resolver_new(d, c);
    var list_t, list = resolver_list(r);
    var names = vec_new();
    var i = 0;
    while (i < vec_len(list)) {
        var pkg = vec_get(list, i);
        if (ip_src(pkg) == SOURCE_MARKETPLACE) { vec_push(names, ip_name(pkg)); }
        i = i + 1;
    }
    assert_eq(vec_len(names), 3, "3 pkgs");
    assert(str_eq(vec_get(names, 0), str_from("alpha-pkg")), "alpha first");
    assert(str_eq(vec_get(names, 1), str_from("mid-pkg")), "mid second");
    assert(str_eq(vec_get(names, 2), str_from("zeta-pkg")), "zeta third");
    rm_rf(d); rm_rf(c);
}

# A graph node with deps given as a comma-free list of cstrs.
fn det_node(name, d1, d2): i64 {
    var deps = vec_new();
    if (d1 != 0) { vec_push(deps, str_from(d1)); }
    if (d2 != 0) { vec_push(deps, str_from(d2)); }
    return resolved_pkg_new(str_from(name), str_from("1.0.0"), SOURCE_MARKETPLACE,
      str_from(""), 0, deps, 1);
}

# 1.5.3 (P0-1): output order must not depend on the per-process hash seed. The
# seed cannot be pinned, so this asserts the exact order the byte-sorted fix
# gives. Under the old hash order it matched by chance about 1 run in 120
# (topo), and the cycle reported varied between [p,q,p] and [q,p,q].
fn test_determinism_hash_order() {
    test_group("determinism_hash_order");
    # Five independent nodes plus a root that depends on two of them.
    var g = dep_graph_new();
    dep_graph_add(g, det_node("libe", 0, 0));
    dep_graph_add(g, det_node("liba", 0, 0));
    dep_graph_add(g, det_node("libd", 0, 0));
    dep_graph_add(g, det_node("app", "libc", "libb"));
    dep_graph_add(g, det_node("libb", 0, 0));
    dep_graph_add(g, det_node("libc", 0, 0));
    var order = dep_graph_topo_sort(g);
    var want = vec_new();
    vec_push(want, "app"); vec_push(want, "liba"); vec_push(want, "libd");
    vec_push(want, "libe"); vec_push(want, "libc"); vec_push(want, "libb");
    assert_eq(vec_len(order), 6, "6 nodes ordered");
    var same = 1;
    var i = 0;
    while (i < vec_len(want) && i < vec_len(order)) {
        if (str_eq(vec_get(order, i), str_from(vec_get(want, i))) == 0) { same = 0; }
        i = i + 1;
    }
    assert_eq(same, 1, "topo order is byte-sorted Kahn order, every run");
    # Two disjoint 2-cycles: the one reported is the byte-first, always.
    var g2 = dep_graph_new();
    dep_graph_add(g2, det_node("q", "p", 0));
    dep_graph_add(g2, det_node("y", "x", 0));
    dep_graph_add(g2, det_node("p", "q", 0));
    dep_graph_add(g2, det_node("x", "y", 0));
    var cyc = dep_graph_detect_cycle(g2);
    assert(cyc != 0, "cycle found");
    assert(str_eq(format_cycle(cyc), str_from("p -> q -> p")), "reported cycle is p -> q -> p");
    # Marketplace dependency order follows the dep names, not hash slots.
    var m = map_new();
    map_set(m, "zeta", str_from("*"));
    map_set(m, "alpha", str_from("*"));
    map_set(m, "mid", str_from("*"));
    var k = _nous_sorted_keys(m);
    assert(str_eq(str_from(vec_get(k, 0)), str_from("alpha")), "sorted keys: alpha");
    assert(str_eq(str_from(vec_get(k, 2)), str_from("zeta")), "sorted keys: zeta");
}

# 1.5.3 (P1): an unparseable constraint version (here a 20-digit component) in
# a manifest is Err(NOUS_ERR_INVALID_VERSION_CONSTRAINT). It used to reach
# semver_cmp as a null SemVer and SIGSEGV the resolver, which any marketplace
# manifest could trigger.
fn test_constraint_overflow_is_err() {
    test_group("constraint_overflow_is_err");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest_deps(d, "ca", "native", "\"dd\":\">=1.0.0\"");
    write_manifest_deps(d, "cb", "native", "\"dd\":\">=99999999999999999999\"");
    write_manifest(d, "dd", "native");
    var r_t, r = resolver_new(d, c);
    resolver_with_strategy(r, strategy_only(SOURCE_MARKETPLACE));
    var names = vec_new();
    vec_push(names, str_from("ca"));
    vec_push(names, str_from("cb"));
    var p_t, p = resolver_resolve_all(r, names);
    assert_eq(is_err_result(p_t), 1, "oversized constraint is Err, not a crash");
    assert_eq(ne_kind(p), NOUS_ERR_INVALID_VERSION_CONSTRAINT, "kind INVALID_VERSION_CONSTRAINT");
    assert(str_eq(ne_msg(p), str_from("dd")), "names the dependency");
    var c2 = constraint_parse(str_from("^99999999999999999999"));
    assert_eq(constraint_matches(c2, semver_new(1, 0, 0)), 0, "matcher refuses a null version");
    rm_rf(d); rm_rf(c);
}

# 1.5.3 (P1, security): a package directory holding `a -> .` and `b -> .`
# made the registry scan walk 2^40 paths (500 MB and climbing after 10 s).
# Symlinks are no longer followed. The scan must finish and count the manifest
# only.
fn test_symlink_fanout_bounded() {
    test_group("symlink_fanout_bounded");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest(d, "loopy", "native");
    var pdir = path_join(path_join(d, str_from("installed")), str_from("loopy"));
    sys_symlink(".", _nous_cstr(path_join(pdir, str_from("a"))));
    sys_symlink(".", _nous_cstr(path_join(pdir, str_from("b"))));
    var r_t, r = resolver_new(d, c);
    assert_eq(is_ok(r_t), 1, "registry scan returns");
    var pkgs = rg_pkgs(rs_reg(r));
    assert_eq(vec_len(pkgs), 1, "one package");
    var msize = file_stat_size(_nous_cstr(path_join(pdir, str_from("manifest.json"))));
    assert_eq(mp_size(vec_get(pkgs, 0)), msize, "size counts the manifest, not the links");
    rm_rf(d); rm_rf(c);
}

# 1.5.3 (P1): files larger than the old fixed buffers (manifest 8 KiB, recipe
# 64 KiB) were half-parsed, and dependencies after a long description were
# silently lost. They are now read whole.
fn test_large_files_read_whole() {
    test_group("large_files_read_whole");
    var d = mkdir_test();
    var c = mkdir_test();
    # A 20 KB manifest whose "dependencies" come after the description.
    var installed = path_join(d, str_from("installed"));
    mkdir_str(installed);
    var pd = path_join(installed, str_from("bigdesc"));
    mkdir_str(pd);
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"agent\":{\"name\":\"bigdesc\",\"version\":\"1.0.0\",\"description\":\"");
    var i = 0;
    while (i < 20000) { str_builder_add_cstr(sb, "x"); i = i + 1; }
    str_builder_add_cstr(sb, "\"},\"dependencies\":{\"depdep\":\"*\"},\"runtime\":\"native\"}");
    var json = str_builder_build(sb);
    file_write_all(_nous_cstr(path_join(pd, str_from("manifest.json"))), _nous_cstr(json), str_len(json));
    var r_t, r = resolver_new(d, c);
    var mp = nous_registry_get(rs_reg(r), str_from("bigdesc"));
    assert(mp != 0, "big manifest loads");
    assert_eq(map_has(mpkg_deps(mp), "depdep"), 1, "dependency after a 20 KB description is kept");
    # An 80 KB recipe whose [depends] comes after a long description.
    var rb = str_builder_new();
    str_builder_add_cstr(rb, "[package]\nname = \"bigrecipe\"\nversion = \"1.0\"\ndescription = \"");
    i = 0;
    while (i < 80000) { str_builder_add_cstr(rb, "y"); i = i + 1; }
    str_builder_add_cstr(rb, "\"\n\n[depends]\nruntime = [\"zlib\"]\n");
    var rtext = str_builder_build(rb);
    var rpath = path_join(c, str_from("bigrecipe.cyml"));
    file_write_all(_nous_cstr(rpath), _nous_cstr(rtext), str_len(rtext));
    var rc = nous_recipe_parse_file(rpath);
    assert(rc != 0, "big recipe parses");
    assert_eq(vec_len(rc_rt_deps(rc)), 1, "runtime dep after an 80 KB description is kept");
    rm_rf(d); rm_rf(c);
}

# 1.5.3: the apt/dpkg parsers are pure functions now, tested here on fixtures
# shaped like real Debian 12 output (no apt needed). Each check is a bug the old
# inline parsing had.
fn test_sysdb_parsers() {
    test_group("sysdb_parsers");
    # apt-cache show with TWO versions: first stanza only, Pre-Depends counted,
    # :any stripped, the first alternative kept, Description-<lang> read.
    var show = j4(
      "Package: multi\nVersion: 3.0-1\nPre-Depends: predep (>= 1)\n",
      "Depends: libnew (>= 3.0), python3:any, alt-a | alt-b\nDescription-en: newer one\n",
      "Size: 4096\n\nPackage: multi\nVersion: 2.0-1\nDepends: libold\nDescription: older\n\n",
      "");
    var info = _sysdb_parse_info(str_from("multi"), show);
    assert(info != 0, "info parsed");
    assert(str_eq(rp_ver(info), str_from("3.0-1")), "candidate (first) version, not the oldest");
    assert(str_eq(rp_desc(info), str_from("newer one")), "Description-<lang> read");
    assert_eq(rp_size(info), 4096, "size");
    var deps = rp_deps(info);
    assert_eq(vec_len(deps), 4, "predep + libnew + python3 + alt-a, no libold");
    assert(str_eq(vec_get(deps, 0), str_from("predep")), "Pre-Depends counts");
    assert(str_eq(vec_get(deps, 2), str_from("python3")), ":any stripped");
    assert(str_eq(vec_get(deps, 3), str_from("alt-a")), "first alternative");
    # 1.5.3 (fuzz case 2096): a leading qualifier never leaks into a name.
    var odd = vec_new();
    _sysdb_dep_names(str_from(":athon3pyny, (>= 1), ok-dep"), odd);
    assert_eq(vec_len(odd), 1, "malformed items yield no name");
    assert(str_eq(vec_get(odd, 0), str_from("ok-dep")), "the clean one survives");
    assert_eq(_sysdb_parse_info(str_from("virt"), str_from("N: Can't select versions\n")), 0, "a virtual name is 0");
    # dpkg-query with ${db:Status-Status}: held = installed, config-files = not.
    var dq = j4(
      "bash\t5.2.15-2\t7164\tinstalled\nfoo\t1.0\t10\tconfig-files\n",
      "libc6\t2.36-9\t13001\tinstalled\nlibc6\t2.36-9\t12000\tinstalled\n",
      "huge\t1\t999999999999999999\tinstalled\n",
      "");
    var inst = _sysdb_parse_installed(dq);
    assert_eq(vec_len(inst), 3, "bash, libc6 once, huge; config-files excluded");
    assert(str_eq(ip_name(vec_get(inst, 0)), str_from("bash")), "held package is installed");
    assert_eq(ip_size(vec_get(inst, 1)), 13001 * 1024, "first multi-arch line kept");
    assert(ip_size(vec_get(inst, 2)) > 0, "Installed-Size saturates, no overflow");
    # apt-get -s dist-upgrade Inst lines.
    var sim = j4(
      "NOTE: This is only a simulation!\n",
      "Inst perl-base [5.36.0-7+deb12u3] (5.36.0-7+deb12u4 Debian-Security:12/oldstable-security [amd64])\n",
      "Inst newpkg (1.0 Debian:12/stable [amd64])\n",
      "Conf perl-base (5.36.0-7+deb12u4 Debian-Security:12/oldstable-security [amd64])\n");
    var ups = _sysdb_parse_upgrades(sim);
    assert_eq(vec_len(ups), 1, "one upgrade; the new install and Conf skipped");
    assert(str_eq(load64(vec_get(ups, 0)), str_from("perl-base")), "upgrade name");
    assert(str_eq(load64(vec_get(ups, 0) + 16), str_from("5.36.0-7+deb12u3")), "installed version");
    assert(str_eq(load64(vec_get(ups, 0) + 24), str_from("5.36.0-7+deb12u4")), "available version");
    # apt-cache search.
    var sr = _sysdb_parse_search(str_from("coreutils - GNU core utilities\n"));
    assert_eq(vec_len(sr), 1, "one search hit");
    assert(str_eq(rp_desc(vec_get(sr, 0)), str_from("GNU core utilities")), "search description");
    # Only Debian-syntax names ever reach apt.
    assert_eq(_sysdb_debian_name(str_from("libc6")), 1, "libc6");
    assert_eq(_sysdb_debian_name(str_from("g++")), 1, "g++");
    assert_eq(_sysdb_debian_name(str_from("-c/tmp/evil.conf")), 0, "option-shaped name refused");
    assert_eq(_sysdb_debian_name(str_from("publisher/agent")), 0, "marketplace name is not apt");
    assert_eq(_sysdb_debian_name(str_from("Foo")), 0, "uppercase is not Debian");
    assert_eq(_sysdb_debian_name(str_from("a")), 0, "one char is too short");
    # Several names in one apt-cache call: one stanza each, keyed by Package.
    var many = _sysdb_parse_info_many(j4(
        "Package: aa\nVersion: 1.0\nDepends: bb\n\nPackage: bb\nVersion: 2.0\n\n",
        "",
        "",
        ""));
    assert_eq(map_count(many), 2, "two stanzas, two packages");
    assert(str_eq(rp_ver(map_get(many, "bb")), str_from("2.0")), "keyed by Package");
    assert_eq(vec_len(rp_deps(map_get(many, "aa"))), 1, "deps per stanza");
    # The search query is escaped for apt-cache's regex.
    assert(str_eq(str_from(_sysdb_regex_escape(str_from("g++"))), str_from("g\\+\\+")), "regex escaped");
}

fn write_text(path, text): i64 {
    file_write_all(_nous_cstr(path), text, strlen(text));
    return 0;
}

# 1.5.3 (P1): the recipe DB scanned a hard-coded category list ("desktop" for
# zugot's "desktops", plus a nonexistent "bazaar") and lost 221 of 563 recipes.
# A multi-line `runtime = [` gave 0 deps, and a trailing `# "x"` comment added
# one. Duplicate names now have a fixed precedence (base first) and are
# reported.
fn test_recipe_db_scan() {
    test_group("recipe_db_scan");
    var z = mkdir_test();
    var base = path_join(z, str_from("base"));
    var desk = path_join(z, str_from("desktops"));
    mkdir_str(base);
    mkdir_str(desk);
    write_text(path_join(base, str_from("dbus.cyml")),
      j4c(
        "[package]\nname = \"dbus\"\nversion = \"1.14\"\n\n[depends]\nruntime = [\n",
        "    \"glibc\",   # the C library\n    \"expat\",\n]\n",
        "build = [\"gcc\"]  # \"not-a-dep\"\n",
        ""));
    write_text(path_join(desk, str_from("dbus.cyml")),
      "[package]\nname = \"dbus\"\nversion = \"9.9\"\n\n[depends]\nruntime = [\"evil-payload\"]\n");
    write_text(path_join(desk, str_from("plasma.cyml")),
      "[package]\nname = \"plasma\"\nversion = \"6.0\"\n");
    var db = recipe_db_load(z);
    assert_eq(recipe_db_count(db), 2, "dbus + plasma (an unlisted category is scanned)");
    var dbus = recipe_db_get(db, str_from("dbus"));
    assert(str_eq(rc_ver(dbus), str_from("1.14")), "base wins a duplicate name");
    var rt = rc_rt_deps(dbus);
    assert_eq(vec_len(rt), 2, "multi-line array: glibc + expat");
    assert(str_eq(vec_get(rt, 1), str_from("expat")), "second element of the multi-line array");
    assert_eq(vec_len(rc_bd_deps(dbus)), 1, "a quoted word in a trailing comment is not a dep");
    var dups = nous_recipe_db_duplicates(db);
    assert_eq(vec_len(dups), 1, "one duplicate reported");
    assert(str_eq(nous_rdup_kept(vec_get(dups, 0)), str_from("base/dbus.cyml")), "kept path");
    assert(str_eq(nous_rdup_ignored(vec_get(dups, 0)), str_from("desktops/dbus.cyml")), "ignored path");
    rm_rf(z);
}

# 1.5.3 (D4): a missing dependency is no longer dropped silently. `a5 -> ghost`
# gave Ok [a5], and a missing root gave Ok [].
fn test_missing_deps_are_errors() {
    test_group("missing_deps_are_errors");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest_deps(d, "a5", "native", "\"ghost\":\"*\"");
    write_manifest(d, "pkg-alpha", "native");
    var r_t, r = resolver_new(d, c);
    resolver_with_strategy(r, strategy_only(SOURCE_MARKETPLACE));
    var n1 = vec_new();
    vec_push(n1, str_from("a5"));
    var t1, e1 = resolver_resolve_all(r, n1);
    assert_eq(is_err_result(t1), 1, "a missing dependency is an Err");
    assert_eq(ne_kind(e1), NOUS_ERR_NOT_FOUND, "kind NOT_FOUND");
    assert(str_eq(ne_msg(e1), str_from("ghost")), "names the missing package");
    assert(str_contains(ne_detail(e1), str_from("required by `a5`")), "names who needed it");
    var n2 = vec_new();
    vec_push(n2, str_from("pkg-alphx"));
    var t2, e2 = resolver_resolve_all(r, n2);
    assert_eq(is_err_result(t2), 1, "a missing root is an Err");
    assert(str_contains(ne_detail(e2), str_from("did you mean `pkg-alpha`?")), "with a typo suggestion");
    assert(str_contains(nous_error_msg(e2), str_from("package `pkg-alphx` not found")), "readable message");
    var n3 = vec_new();
    vec_push(n3, str_from("pkg-alpha"));
    var t3, p3 = resolver_resolve_all(r, n3);
    assert_eq(is_ok(t3), 1, "a complete closure is still Ok");
    assert_eq(vec_len(nous_pl_unresolved(p3)), 0, "nothing unresolved");
    rm_rf(d); rm_rf(c);
}

fn cyc_node(name, src, d1, d2): i64 {
    var deps = vec_new();
    if (d1 != 0) { vec_push(deps, str_from(d1)); }
    if (d2 != 0) { vec_push(deps, str_from(d2)); }
    return resolved_pkg_new(str_from(name), str_from("1.0.0"), src, str_from(""), 0, deps, 1);
}

# 1.5.3 (D3, ADR 0005): Debian allows dependency cycles (Policy §7.2), e.g.
# libc6 <-> libgcc-s1 on Debian 12. An apt-only cycle is accepted and ordered;
# any cycle touching a non-apt package is still an error. Cycle detection is
# iterative now (a 50k+ chain crashed), and a self-loop's path is right.
fn test_cycle_policy() {
    test_group("cycle_policy");
    var d = mkdir_test();
    var c = mkdir_test();
    var r_t, r = resolver_new(d, c);
    # The Debian shape: an apt-only 2-cycle under a marketplace package.
    var g = dep_graph_new();
    dep_graph_add(g, cyc_node("app", SOURCE_MARKETPLACE, "libc6", 0));
    dep_graph_add(g, cyc_node("libc6", SOURCE_SYSTEM, "libgcc-s1", 0));
    dep_graph_add(g, cyc_node("libgcc-s1", SOURCE_SYSTEM, "libc6", 0));
    var p_t, p = finalize_graph(r, g);
    assert_eq(is_ok(p_t), 1, "an apt-only cycle is accepted");
    var o = pl_order(p);
    assert_eq(vec_len(o), 3, "all three ordered");
    assert(str_eq(vec_get(o, 0), str_from("libc6")), "cycle members first, byte order");
    assert(str_eq(vec_get(o, 1), str_from("libgcc-s1")), "then the other member");
    assert(str_eq(vec_get(o, 2), str_from("app")), "the dependent last");
    # A marketplace cycle is still rejected, with its path.
    var g2 = dep_graph_new();
    dep_graph_add(g2, cyc_node("ma", SOURCE_MARKETPLACE, "mb", 0));
    dep_graph_add(g2, cyc_node("mb", SOURCE_MARKETPLACE, "ma", 0));
    var e_t, e = finalize_graph(r, g2);
    assert_eq(is_err_result(e_t), 1, "a marketplace cycle is an Err");
    assert_eq(ne_kind(e), NOUS_ERR_DEPENDENCY_CYCLE, "kind DEPENDENCY_CYCLE");
    assert(str_eq(ne_msg(e), str_from("ma -> mb -> ma")), "with its path");
    # A cycle mixing apt and marketplace is rejected too.
    var g3 = dep_graph_new();
    dep_graph_add(g3, cyc_node("sysx", SOURCE_SYSTEM, "mktx", 0));
    dep_graph_add(g3, cyc_node("mktx", SOURCE_MARKETPLACE, "sysx", 0));
    var m_t, m = finalize_graph(r, g3);
    assert_eq(is_err_result(m_t), 1, "a mixed cycle is an Err");
    # Self-loop reached through another node: the path is [aa, aa].
    var g4 = dep_graph_new();
    dep_graph_add(g4, cyc_node("xx", SOURCE_MARKETPLACE, "aa", 0));
    dep_graph_add(g4, cyc_node("aa", SOURCE_MARKETPLACE, "aa", 0));
    assert(str_eq(format_cycle(dep_graph_detect_cycle(g4)), str_from("aa -> aa")), "self-loop path");
    # A 100,000-node chain: no stack crash (the recursive walk crashed).
    var g5 = dep_graph_new();
    var i = 0;
    while (i < 100000) {
        var deps = vec_new();
        if (i + 1 < 100000) { vec_push(deps, str_from_int(i + 1)); }
        dep_graph_add(g5, resolved_pkg_new(str_from_int(i), j4(
              "1",
              "",
              "",
              ""), SOURCE_MARKETPLACE, str_from(""), 0, deps, 1));
        i = i + 1;
    }
    assert_eq(dep_graph_detect_cycle(g5), 0, "100k chain: no cycle, no crash");
    rm_rf(d); rm_rf(c);
}

fn ct_ok(c, v): i64 { return constraint_matches(constraint_parse(str_from(c)), semver_parse(str_from(v))); }
fn ct_err(c): i64 { return nous_constraint_error(constraint_parse(str_from(c))) != 0; }
fn compat(a, b): i64 { return constraints_compatible(constraint_parse(str_from(a)), constraint_parse(str_from(b))); }
fn deb(a, b): i64 { return nous_deb_version_cmp(str_from(a), str_from(b)); }

# 1.5.3 (D1): constraints are version ranges. Partials follow npm/Cargo,
# unsupported syntax is an error, and compatibility is a real intersection.
fn test_version_ranges() {
    test_group("version_ranges");
    # Partials (they gave the wrong range before).
    assert_eq(ct_ok("^0", "0.5.0"), 1, "^0 = <1.0.0");
    assert_eq(ct_ok("^0", "1.0.0"), 0, "^0 excludes 1.0.0");
    assert_eq(ct_ok("^0.0", "0.0.5"), 1, "^0.0 = <0.1.0");
    assert_eq(ct_ok("^0.0", "0.1.0"), 0, "^0.0 excludes 0.1.0");
    assert_eq(ct_ok("~1", "1.5.0"), 1, "~1 = <2.0.0");
    assert_eq(ct_ok("~0", "0.3.0"), 1, "~0 = <1.0.0");
    assert_eq(ct_ok(">1.2", "1.2.1"), 0, ">1.2 = >=1.3.0 (Cargo)");
    assert_eq(ct_ok(">1.2", "1.3.0"), 1, ">1.2 admits 1.3.0");
    assert_eq(ct_ok("<=1.2", "1.2.9"), 1, "<=1.2 = <1.3.0");
    assert_eq(ct_ok("<=1.2", "1.3.0"), 0, "<=1.2 excludes 1.3.0");
    assert_eq(ct_ok("1.2", "1.2.7"), 1, "bare partial is an X-range");
    assert_eq(ct_ok("1.x", "1.9.0"), 1, "1.x");
    assert_eq(ct_ok(">=v1.0", "1.0.0"), 1, "leading v");
    # Full versions keep their exact meaning.
    assert_eq(ct_ok("^1.2.3", "1.9.9"), 1, "^1.2.3");
    assert_eq(ct_ok("^0.2.3", "0.3.0"), 0, "^0.2.3 zero-major");
    # Unsupported syntax is an error that matches nothing (it parsed silently).
    assert_eq(ct_err("!=1.0.0"), 1, "!= refused");
    assert_eq(ct_err("==1.0.0"), 1, "== refused");
    assert_eq(ct_err("~>1.2"), 1, "~> refused");
    assert_eq(ct_err(">=1.0, <2.0"), 0, "comma compound accepted (1.7.1)");
    assert_eq(ct_err("^1.0 || ^2.0"), 0, "|| accepted (1.7.1)");
    assert_eq(ct_err("latest"), 1, "latest refused");
    assert_eq(ct_err("1.0.0-beta"), 0, "a pre-release constraint is accepted (1.7.0)");
    assert_eq(ct_ok("!=1.0", "5.0.0"), 0, "a refused constraint matches nothing");
    assert_eq(ct_err(">=1.2.3"), 0, "a plain comparator is fine");
    # Compatibility is a true intersection, independent of argument order.
    assert_eq(compat(">1.0.0", "<1.1.0"), 1, ">1.0.0 with <1.1.0");
    assert_eq(compat("<1.1.0", ">1.0.0"), 1, "same, swapped");
    assert_eq(compat(">1.2.0", "<1.3.0"), 1, "1.2.1 satisfies both");
    assert_eq(compat(">=2.0.0", "<2.0.0"), 0, "disjoint");
    assert_eq(compat("=1.0.0", "=1.0.0"), 1, "equal exacts");
}

# 1.5.3 (D2): deb-version(7) comparison, the cases nous got wrong.
# 1.7.0: SemVer 2.0.0 pre-release and build (§9-§11). The pre-release took no
# part in ordering, so 1.0.0-rc.1 compared equal to 1.0.0.
fn sv(s): i64 { return semver_parse(str_from(s)); }
fn svc(a, b): i64 { return semver_cmp(sv(a), sv(b)); }
fn svp(a, b): i64 { return nous_semver_cmp_pub(sv(a), sv(b)); }
fn test_semver_prerelease() {
    test_group("semver_prerelease");
    var v = sv("1.2.3-rc.1+build.5");
    assert_eq(sv_patch(v), 3, "core parsed");
    assert(str_eq_cstr(nous_sv_pre(v), "rc.1"), "pre-release kept");
    assert(str_eq_cstr(nous_sv_build(v), "build.5"), "build kept");
    assert(str_eq_cstr(semver_to_str(v), "1.2.3-rc.1+build.5"), "to_str roundtrips");
    assert_eq(nous_sv_pre(sv("1.2.3")), 0, "a release has no pre-release");
    assert_eq(nous_sv_pre(sv("1.2.3-")), 0, "an empty pre-release is dropped");
    assert(str_eq_cstr(nous_sv_pre(sv("2.0-beta")), "beta"), "after a partial too");
    assert(str_eq_cstr(nous_sv_pre(sv("1.0.0-rc.1 trailing")), "rc.1"), "stops at other text");
    # The §11 example chain, every adjacent pair and both directions.
    var chain = vec_new();
    vec_push(chain, "1.0.0-alpha"); vec_push(chain, "1.0.0-alpha.1");
    vec_push(chain, "1.0.0-alpha.beta"); vec_push(chain, "1.0.0-beta");
    vec_push(chain, "1.0.0-beta.2"); vec_push(chain, "1.0.0-beta.11");
    vec_push(chain, "1.0.0-rc.1"); vec_push(chain, "1.0.0");
    var ok = 1;
    var i = 0;
    while (i + 1 < vec_len(chain)) {
        if (svc(vec_get(chain, i), vec_get(chain, i + 1)) >= 0) { ok = 0; }
        if (svc(vec_get(chain, i + 1), vec_get(chain, i)) <= 0) { ok = 0; }
        i = i + 1;
    }
    assert_eq(ok, 1, "SemVer 2.0.0 §11 example order");
    assert(svc("1.0.0-rc.1", "1.0.0") < 0, "pre-release before its release");
    assert(svc("1.0.0-1", "1.0.0-a") < 0, "numeric before alphanumeric");
    assert(svc("1.0.0-beta.2", "1.0.0-beta.11") < 0, "numeric identifiers by value");
    assert(svc("1.0.0-99999999999999999999", "1.0.0-100000000000000000000") < 0, "any length");
    assert_eq(svc("1.0.0+a", "1.0.0+b"), 0, "build ignored for precedence (§10)");
    assert(semver_eq(sv("1.0.0+a"), sv("1.0.0")), "semver_eq ignores build");
    assert(svc("1.0.0-rc.1", "0.9.9") > 0, "core first");
    # pub_semver order (Flutter): build after precedence; none first.
    assert(svp("1.0.0+1", "1.0.0+2") < 0, "pub: +1 before +2");
    assert(svp("1.0.0", "1.0.0+1") < 0, "pub: no build before a build");
    assert(svp("1.0.0+2", "1.0.0+10") < 0, "pub: build numbers by value");
    assert(svp("1.0.0-rc.1+9", "1.0.0") < 0, "pub: precedence still first");
}

# 1.7.0: pre-release constraints, and the npm / Cargo rule that a pre-release
# version matches only a constraint naming a pre-release of the same M.m.p.
fn test_prerelease_constraints() {
    test_group("prerelease_constraints");
    assert_eq(ct_ok(">=1.0.0", "1.1.0-rc.1"), 0, ">=1.0.0 does not take 1.1.0-rc.1");
    assert_eq(ct_ok("*", "1.0.0-rc.1"), 0, "* takes no pre-release");
    assert_eq(ct_ok("^1.0.0", "1.2.0-beta"), 0, "^1.0.0 takes no pre-release");
    assert_eq(ct_ok(">=1.1.0-rc.1", "1.1.0-rc.2"), 1, "opted in on 1.1.0");
    assert_eq(ct_ok(">=1.1.0-rc.1", "1.1.0-rc.0"), 0, "below the bound");
    assert_eq(ct_ok(">=1.1.0-rc.1", "1.1.0"), 1, "the release");
    assert_eq(ct_ok(">=1.1.0-rc.1", "1.2.0-alpha"), 0, "another M.m.p's pre-release");
    assert_eq(ct_ok(">1.2.3-alpha.3", "1.2.3-alpha.7"), 1, "npm README example");
    assert_eq(ct_ok(">1.2.3-alpha.3", "3.4.5-alpha.9"), 0, "npm README example, other tuple");
    assert_eq(ct_ok(">1.2.3-alpha.3", "3.4.5"), 1, "npm README example, a release");
    assert_eq(ct_ok("^1.2.3-beta.2", "1.2.3-beta.4"), 1, "caret with a pre-release");
    assert_eq(ct_ok("^1.2.3-beta.2", "1.9.0"), 1, "caret upper bound unchanged");
    assert_eq(ct_ok("^1.2.3-beta.2", "2.0.0-alpha"), 0, "next major's pre-release");
    assert_eq(ct_ok("=1.0.0-rc.1", "1.0.0-rc.1"), 1, "exact pre-release");
    assert_eq(ct_ok("=1.0.0-rc.1", "1.0.0"), 0, "exact pre-release is not the release");
    assert_eq(ct_ok("<1.0.0-rc.2", "1.0.0-rc.1"), 1, "less than, same tuple");
    assert_eq(ct_ok(">=1.0.0+build.9", "1.0.0"), 1, "build in a constraint is ignored");
    assert_eq(ct_ok(">=1.0.0", "1.0.0+anything"), 1, "build in a version is ignored");
    # Strict syntax in constraints (§9, §10).
    assert_eq(ct_err("1.2-rc.1"), 1, "pre-release on a partial refused");
    assert_eq(ct_err("1.x.0-rc"), 1, "pre-release on a wildcard refused");
    assert_eq(ct_err("1.0.0-"), 1, "empty pre-release refused");
    assert_eq(ct_err("1.0.0-rc..1"), 1, "empty identifier refused");
    assert_eq(ct_err("1.0.0-01"), 1, "leading zero in a numeric identifier refused");
    assert_eq(ct_err("1.0.0-rc_1"), 1, "a character outside [0-9A-Za-z-] refused");
    assert_eq(ct_err("1.0.0+"), 1, "empty build refused");
    assert_eq(ct_err("1.0.0+001"), 0, "a build may have leading zeros");
    assert_eq(ct_err("1.0.0-rc.1 <2"), 0, "a pre-release inside a compound range (1.7.1)");
    # Compatibility is exact when only pre-releases overlap.
    assert_eq(compat("=1.0.0-rc.1", "*"), 0, "* admits no pre-release");
    assert_eq(compat("=1.0.0-rc.1", ">=1.0.0-rc.0"), 1, "both opt in on 1.0.0");
    assert_eq(compat(">=1.0.0-rc.1", "<1.0.0"), 0, "only rc of 1.0.0, and <1.0.0 does not opt in");
    assert_eq(compat(">=1.0.0-rc.1", "<1.0.0-rc.5"), 1, "both opt in");
    assert_eq(compat("<1.0.0-rc.5", ">=1.0.0-rc.1"), 1, "same, swapped");
    assert_eq(compat(">=1.0.0-rc.1", "<2.0.0"), 1, "a release lies between");
    assert_eq(compat(">1.0.0", "<1.0.1"), 0, "only 1.0.1's pre-releases lie between, and neither opts in");
    assert_eq(compat(">=1.0.0", "<=1.0.0"), 1, "a single release");
    assert_eq(compat(">1.0.0", "<1.0.1-rc.1"), 0, "<1.0.1-rc.1 opts in, >1.0.0 does not");
}

# A manifest with a chosen version (the other writers always use 1.0.0).
fn write_manifest_v(dir, name, version, deps_json) {
    var installed = path_join(dir, str_from("installed"));
    mkdir_str(installed);
    var pd = path_join(installed, str_from(name));
    mkdir_str(pd);
    var mp = path_join(pd, str_from("manifest.json"));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "{\"agent\":{\"name\":\"");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "\",\"version\":\"");
    str_builder_add_cstr(sb, version);
    str_builder_add_cstr(sb, "\",\"description\":\"d\"},\"dependencies\":{");
    str_builder_add_cstr(sb, deps_json);
    str_builder_add_cstr(sb, "},\"runtime\":\"native\"}");
    var json = str_builder_build(sb);
    file_write_all(_nous_cstr(mp), _nous_cstr(json), str_len(json));
}

# 1.7.0: resolution checks a pre-release chosen version by the same rule, and
# says why it fails and how to opt in.
fn test_prerelease_resolution() {
    test_group("prerelease_resolution");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest_v(d, "pr-lib", "1.1.0-rc.1", "");
    write_manifest_v(d, "pr-app", "1.0.0", "\"pr-lib\":\">=1.0.0\"");
    write_manifest_v(d, "pr-opt", "1.0.0", "\"pr-lib\":\">=1.1.0-rc.1\"");
    var r_t, r = resolver_new(d, c);
    resolver_with_strategy(r, strategy_only(SOURCE_MARKETPLACE));
    var n1 = vec_new();
    vec_push(n1, str_from("pr-app"));
    var t1, e1 = resolver_resolve_all(r, n1);
    assert_eq(is_err_result(t1), 1, ">=1.0.0 refuses the only candidate, 1.1.0-rc.1");
    assert_eq(ne_kind(e1), NOUS_ERR_VERSION_CONFLICT, "kind VERSION_CONFLICT");
    assert(str_contains(ne_detail(e1), str_from("it is a pre-release")), "says it is a pre-release");
    assert(str_contains(ne_detail(e1), str_from(">=1.1.0-rc.1")), "and how to opt in");
    var n2 = vec_new();
    vec_push(n2, str_from("pr-opt"));
    var t2, p2 = resolver_resolve_all(r, n2);
    assert_eq(is_ok(t2), 1, "an opted-in constraint accepts it");
    rm_rf(d); rm_rf(c);
}

# 1.7.0: update detection orders pre-releases, and Flutter build numbers.
fn test_prerelease_updates() {
    test_group("prerelease_updates");
    assert_eq(update_is_newer(str_from("1.0.0"), str_from("1.0.0-rc.1")), 1, "the release over its rc");
    assert_eq(update_is_newer(str_from("1.0.0-rc.2"), str_from("1.0.0-rc.1")), 1, "rc.2 over rc.1");
    assert_eq(update_is_newer(str_from("1.0.0-rc.1"), str_from("1.0.0")), 0, "never back to an rc");
    assert_eq(update_is_newer(str_from("1.0.0+2"), str_from("1.0.0+1")), 0, "build ignored (marketplace)");
    assert_eq(nous_update_is_newer_src(str_from("1.0.0+2"), str_from("1.0.0+1"), SOURCE_FLUTTER_APP), 1,
      "a Flutter build-number bump is an update");
    assert_eq(nous_update_is_newer_src(str_from("1.0.0+1"), str_from("1.0.0+2"), SOURCE_FLUTTER_APP), 0,
      "not the other way");
    assert_eq(nous_update_is_newer_src(str_from("1.0.0+2"), str_from("1.0.0+1"), SOURCE_MARKETPLACE), 0,
      "marketplace ignores build");
    assert_eq(nous_update_is_newer_src(str_from("1.0.1"), str_from("1.0.0+9"), SOURCE_FLUTTER_APP), 1,
      "Flutter precedence first");
}

# 1.7.0: a github_release recipe exposes its repo and asset pattern.
fn test_recipe_github_fields() {
    test_group("recipe_github_fields");
    var d = mkdir_test();
    var p = path_join(d, str_from("gh.cyml"));
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[package]\nname = \"gh\"\nversion = \"1.0.0\"\n[source]\n");
    str_builder_add_cstr(sb, "github_release = \"Acme/gh\"\nrelease_asset = \"gh-*-linux.tar.gz\"\nsha256 = \"\"\n");
    var body = str_builder_build(sb);
    file_write_all(_nous_cstr(p), _nous_cstr(body), str_len(body));
    var rc = nous_recipe_parse_file(p);
    assert(rc != 0, "parsed");
    assert(str_eq_cstr(nous_rc_github_release(rc), "Acme/gh"), "github_release");
    assert(str_eq_cstr(nous_rc_release_asset(rc), "gh-*-linux.tar.gz"), "release_asset");
    assert(str_eq_cstr(rc_url(rc), "https://github.com/Acme/gh/releases"), "rc_url unchanged");
    var p2 = path_join(d, str_from("plain.cyml"));
    var body2 = "[package]\nname = \"plain\"\nversion = \"1.0\"\n[source]\nurl = \"https://x/y.tar.gz\"\n";
    file_write_all(_nous_cstr(p2), body2, strlen(body2));
    var rc2 = nous_recipe_parse_file(p2);
    assert_eq(str_len(nous_rc_github_release(rc2)), 0, "none: empty");
    assert_eq(str_len(nous_rc_release_asset(rc2)), 0, "none: empty asset");
    rm_rf(d);
}

# 1.7.1: compound ranges (npm "Range Grammar"; Cargo "Multiple version
# requirements"). They were refused with an error.
fn rset_len(c): i64 { return vec_len(_nous_ct_rset(constraint_parse(str_from(c)))); }
fn test_compound_ranges() {
    test_group("compound_ranges");
    # npm README: "1.2.7 || >=1.2.9 <2.0.0".
    var r1 = "1.2.7 || >=1.2.9 <2.0.0";
    assert_eq(ct_ok(r1, "1.2.7"), 1, "npm: 1.2.7");
    assert_eq(ct_ok(r1, "1.2.9"), 1, "npm: 1.2.9");
    assert_eq(ct_ok(r1, "1.4.6"), 1, "npm: 1.4.6");
    assert_eq(ct_ok(r1, "1.2.8"), 0, "npm: not 1.2.8");
    assert_eq(ct_ok(r1, "2.0.0"), 0, "npm: not 2.0.0");
    assert_eq(ct_ok(">=1.2.7 <1.3.0", "1.2.99"), 1, "AND: 1.2.99");
    assert_eq(ct_ok(">=1.2.7 <1.3.0", "1.2.6"), 0, "AND: not 1.2.6");
    assert_eq(ct_ok(">=1.2.7 <1.3.0", "1.3.0"), 0, "AND: not 1.3.0");
    # Hyphen ranges, partials on either side (npm README).
    assert_eq(ct_ok("1.2.3 - 2.3.4", "2.3.4"), 1, "hyphen: inclusive top");
    assert_eq(ct_ok("1.2.3 - 2.3.4", "2.3.5"), 0, "hyphen: above");
    assert_eq(ct_ok("1.2.3 - 2.3.4", "1.2.2"), 0, "hyphen: below");
    assert_eq(ct_ok("1.2 - 2.3.4", "1.2.0"), 1, "hyphen: partial low fills zeros");
    assert_eq(ct_ok("1.2 - 2.3.4", "1.1.9"), 0, "hyphen: partial low, below");
    assert_eq(ct_ok("1.2.3 - 2.3", "2.3.9"), 1, "hyphen: partial high is an X-range");
    assert_eq(ct_ok("1.2.3 - 2.3", "2.4.0"), 0, "hyphen: = <2.4.0");
    assert_eq(ct_ok("1.2.3 - 2", "2.9.9"), 1, "hyphen: 1.2.3 - 2");
    assert_eq(ct_ok("1.2.3 - 2", "3.0.0"), 0, "hyphen: = <3.0.0");
    assert_eq(ct_ok("* - 2.0.0", "0.1.0"), 1, "hyphen: open low");
    assert_eq(ct_ok("1.2.3-alpha - 2.0.0", "1.2.3-beta"), 1, "hyphen: a pre-release low bound opts in");
    # Cargo: comma AND, spaces around operators.
    assert_eq(ct_ok(">= 1.2, < 1.5", "1.4.9"), 1, "cargo: 1.4.9");
    assert_eq(ct_ok(">= 1.2, < 1.5", "1.5.0"), 0, "cargo: not 1.5.0");
    assert_eq(ct_ok(">=1.2,<1.5", "1.1.9"), 0, "cargo, no spaces: not 1.1.9");
    assert_eq(ct_ok("^1.0, <1.5 || ^3", "3.2.0"), 1, "comma AND inside an OR");
    assert_eq(ct_ok("^1.0, <1.5 || ^3", "1.6.0"), 0, "comma AND inside an OR, outside");
    # An empty side of || is "*", which takes any release and no pre-release.
    assert_eq(ct_ok("1.x ||", "5.0.0"), 1, "empty alternative is *");
    assert_eq(ct_ok("1.x ||", "5.0.0-rc.1"), 0, "* takes no pre-release");
    # Representation: one comparator stays simple; more is OP_SET.
    assert_eq(ct_op(constraint_parse(str_from(">= 1.2"))), OP_GTE, "an operator standing apart is still simple");
    assert_eq(nous_ct_sets(constraint_parse(str_from(">= 1.2"))), 0, "a simple constraint has no sets");
    var cs = constraint_parse(str_from("^1.0 || ^2.0 >=2.1"));
    assert_eq(ct_op(cs), OP_SET, "compound is OP_SET");
    assert_eq(vec_len(nous_ct_sets(cs)), 2, "two comparator sets");
    assert_eq(vec_len(vec_get(nous_ct_sets(cs), 1)), 2, "the second has two comparators");
    # Range sets are merged.
    assert_eq(rset_len("^1.0 || ^1.5"), 1, "overlapping alternatives merge");
    assert_eq(rset_len("^1.0 || ^3.0"), 2, "disjoint ones do not");
    assert_eq(rset_len("<1.0.0 || >=1.0.0"), 1, "touching ones merge");
    assert_eq(rset_len("1.0 2.0"), 0, "an empty AND takes nothing");
    # Pre-releases, per comparator set (npm).
    assert_eq(ct_ok(">=1.2.3-alpha.3 <1.3.0", "1.2.3-alpha.7"), 1, "set opts in on 1.2.3");
    assert_eq(ct_ok(">=1.2.3-alpha.3 <1.3.0", "1.2.4-alpha"), 0, "but not on 1.2.4");
    var r2 = "^1.0.0 || >=2.0.0-beta.1 <3.0.0";
    assert_eq(ct_ok(r2, "2.0.0-beta.2"), 1, "the second set opts in on 2.0.0");
    assert_eq(ct_ok(r2, "1.5.0-rc"), 0, "no set opts in on 1.5.0");
    assert_eq(ct_ok(r2, "2.1.0-rc"), 0, "nor on 2.1.0");
    assert_eq(ct_ok("<2.0.0-rc.1 || >=3.0.0", "2.0.0-beta"), 1, "an upper pre-release bound opts in");
    assert_eq(ct_ok(">=1.0.0-rc.1 <2.0.0 || >=1.0.0", "1.5.0-alpha"), 0, "opt-in is per M.m.p");
    # Errors.
    assert_eq(ct_err("1.0 | 2.0"), 1, "a single | refused");
    assert_eq(ct_err(">=1.0,,<2.0"), 1, "empty comparator between commas");
    assert_eq(ct_err(">=1.0, "), 1, "trailing comma");
    assert_eq(ct_err(", >=1.0"), 1, "leading comma");
    assert_eq(ct_err(">= "), 1, "an operator with no version");
    assert_eq(ct_err(">=1.0 >="), 1, "a trailing operator with no version");
    assert_eq(ct_err("1.2.3 - "), 1, "a dangling hyphen");
    assert_eq(ct_err("- 1.2.3"), 1, "a leading hyphen");
    assert_eq(ct_err("1.2.3 - 2.3.4 - 5"), 1, "two hyphens");
    assert_eq(ct_err(">=1.0 - 2.0"), 1, "a hyphen range takes plain versions");
    var ce = constraint_parse(str_from("^1 || !=2"));
    assert(str_contains(nous_constraint_error(ce), str_from("'!='")), "a comparator's own error comes through");
    assert_eq(ct_ok("^1 || !=2", "1.5.0"), 0, "and the constraint matches nothing");
    # Compatibility.
    assert_eq(compat("^1.0 || ^3.0", "^2.0 || ^3.1"), 1, "3.1 and up is in both");
    assert_eq(compat("^1.0 || ^3.0", "^2.0"), 0, "no common alternative");
    assert_eq(compat(">=1.0 <1.5", ">=1.4 <2"), 1, "AND sets overlap");
    assert_eq(compat(">=1.0 <1.5", ">=1.5"), 0, "AND set ends where the other starts");
    assert_eq(compat("1.2.3 - 2.0.0", "2.0.0 - 3.0.0"), 1, "hyphen ranges touch at 2.0.0");
    assert_eq(compat("1.2.3 - 1.9.9", "2.0.0 - 3.0.0"), 0, "hyphen ranges apart");
    assert_eq(compat(">1.0.0 <1.0.1 || >=5.0.0-rc.1 <5.0.0", ">=5.0.0-rc.2 <5.0.0"), 1,
      "pre-releases of 5.0.0, both sides opt in");
    assert_eq(compat(">1.0.0 <1.0.1 || ^9", "<1.0.1-rc.1"), 0, "only 1.0.1-x in common, one side opts in");
    assert_eq(compat("<1.0.1-rc.1", ">1.0.0 <1.0.1 || ^9"), 0, "same, swapped");
    assert_eq(compat("^1 || ^2", "=1.5.0"), 1, "compound with simple");
}

# 1.7.1: resolution intersects range sets and checks the chosen version
# against every comparator set.
fn test_compound_resolution() {
    test_group("compound_resolution");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest_v(d, "cr-lib", "2.3.0", "");
    write_manifest_v(d, "cr-a1", "1.0.0", "\"cr-lib\":\"^1.0 || ^2.0\"");
    write_manifest_v(d, "cr-a2", "1.0.0", "\"cr-lib\":\">=1.0, <2.0\"");
    write_manifest_v(d, "cr-a7", "1.0.0", "\"cr-lib\":\"<2.0.0 || >=9\"");
    write_manifest_v(d, "cr-a8", "1.0.0", "\"cr-lib\":\">=2.0.0 <3.0.0\"");
    write_manifest_v(d, "cr-pre", "1.5.0-rc.1", "");
    write_manifest_v(d, "cr-a9", "1.0.0", "\"cr-pre\":\"^1.0 || ^2.0\"");
    var r_t, r = resolver_new(d, c);
    resolver_with_strategy(r, strategy_only(SOURCE_MARKETPLACE));
    var n1 = vec_new();
    vec_push(n1, str_from("cr-a1"));
    var t1, p1 = resolver_resolve_all(r, n1);
    assert_eq(is_ok(t1), 1, "^1.0 || ^2.0 takes 2.3.0");
    var n2 = vec_new();
    vec_push(n2, str_from("cr-a2"));
    var t2, e2 = resolver_resolve_all(r, n2);
    assert_eq(is_err_result(t2), 1, ">=1.0, <2.0 refuses 2.3.0");
    assert(str_contains(ne_detail(e2), str_from("the version available is 2.3.0")), "says which version");
    var n3 = vec_new();
    vec_push(n3, str_from("cr-a7")); vec_push(n3, str_from("cr-a8"));
    var t3, e3 = resolver_resolve_all(r, n3);
    assert_eq(is_err_result(t3), 1, "disjoint range sets conflict");
    assert_eq(ne_kind(e3), NOUS_ERR_VERSION_CONFLICT, "kind VERSION_CONFLICT");
    assert(str_contains(ne_detail(e3), str_from("cr-a7 requires <2.0.0 || >=9")), "names one side");
    assert(str_contains(ne_detail(e3), str_from("cr-a8 requires >=2.0.0 <3.0.0")), "and the other");
    var n4 = vec_new();
    vec_push(n4, str_from("cr-a9"));
    var t4, e4 = resolver_resolve_all(r, n4);
    assert_eq(is_err_result(t4), 1, "a pre-release fails a compound that does not opt in");
    assert(str_contains(ne_detail(e4), str_from("it is a pre-release")), "with the hint");
    rm_rf(d); rm_rf(c);
}

# 1.7.2: the lockfile (ADR 0008). Generate, write, parse, diff, and locked
# resolution, which refuses any drift. lk_* build lock text in pieces.
fn lk_parse_err(text): i64 {
    var t, v = nous_lock_parse(str_from(text));
    if (is_err_result(t) == 1) { return 1; }
    return 0;
}
# A [[package]] table; `deps` is the array text as written ("[]", "[\"a\"]").
fn lk_pkg(name, ver, src, deps): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[[package]]\nname = \"");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "\"\nversion = \"");
    str_builder_add_cstr(sb, ver);
    str_builder_add_cstr(sb, "\"\nsource = \"");
    str_builder_add_cstr(sb, src);
    str_builder_add_cstr(sb, "\"\ndependencies = ");
    str_builder_add_cstr(sb, deps);
    str_builder_add_cstr(sb, "\n");
    return _nous_cstr(str_builder_build(sb));
}
# A package table as nous_lock_to_str writes it (blank line first).
fn lk_out(name, ver, src, deps): i64 { return j4c("\n", lk_pkg(name, ver, src, deps), "", ""); }
# A multi-line array of one or two names, as nous_lock_to_str writes it.
fn lk_a1(a): i64 { return j4c("[\n    \"", a, "\",\n]", ""); }
fn lk_a2(a, b): i64 { return _nous_cstr(j4(j4c("[\n    \"", a, "\",\n    \"", b), "\",\n]", "", "")); }
var LK_HEAD = "# nous lockfile: generated by nous_lock_to_str; do not edit by hand.\nversion = 1\n";
# version = 1, roots = [one], then one package table.
fn lk_doc(root, pkg): i64 { return j4c("version = 1\nroots = [\"", root, "\"]\n", pkg); }

fn test_lockfile() {
    test_group("lockfile");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest_v(d, "lk-app", "1.0.0", "\"lk-util\":\"^0.3\",\"lk-lib\":\">=1.0\"");
    write_manifest_v(d, "lk-lib", "1.2.0", "");
    write_manifest_v(d, "lk-util", "0.3.0", "\"lk-lib\":\"*\"");
    var r_t, r = resolver_new(d, c);
    resolver_with_strategy(r, strategy_only(SOURCE_MARKETPLACE));
    var roots = vec_new();
    vec_push(roots, str_from("lk-app"));
    var pt, plan = resolver_resolve_all(r, roots);
    assert_eq(is_ok(pt), 1, "resolves");
    var lt, lock = nous_lock_from_plan(plan, roots);
    assert_eq(is_ok(lt), 1, "lock from plan");
    var text = nous_lock_to_str(lock);
    var want = j4(j4c(LK_HEAD, "roots = ", lk_a1("lk-app"), "\n"),
      lk_out("lk-app", "1.0.0", "marketplace", lk_a2("lk-lib", "lk-util")),
      lk_out("lk-lib", "1.2.0", "marketplace", "[]"),
      lk_out("lk-util", "0.3.0", "marketplace", lk_a1("lk-lib")));
    assert(str_eq(text, want), "exact lockfile text");
    var p2t, p2 = resolver_resolve_all(r, roots);
    var l2t, l2 = nous_lock_from_plan(p2, roots);
    assert(str_eq(nous_lock_to_str(l2), text), "byte-stable across resolutions");
    var pkt, parsed = nous_lock_parse(text);
    assert_eq(is_ok(pkt), 1, "parses");
    assert(str_eq(nous_lock_to_str(parsed), text), "text roundtrips byte for byte");
    assert_eq(vec_len(nous_lock_diff(lock, parsed)), 0, "no differences after a roundtrip");
    assert_eq(nous_lock_version(parsed), 1, "format version 1");
    assert(str_eq_cstr(nous_lp_version(nous_lock_get(parsed, str_from("lk-lib"))), "1.2.0"), "get by name");
    assert_eq(nous_lock_get(parsed, str_from("nope")), 0, "get: absent");
    var rlt, rplan = nous_resolve_locked(r, parsed);
    assert_eq(is_ok(rlt), 1, "locked resolution matches");
    # Version drift.
    write_manifest_v(d, "lk-lib", "1.3.0", "");
    registry_reload(rs_reg(r));
    var dt, de = nous_resolve_locked(r, parsed);
    assert_eq(is_err_result(dt), 1, "a new version is drift");
    assert_eq(ne_kind(de), NOUS_ERR_LOCK_MISMATCH, "kind LOCK_MISMATCH");
    assert(str_eq_cstr(ne_msg(de), "lk-lib"), "names the first difference");
    assert(str_contains(ne_detail(de), str_from("lk-lib: version 1.2.0 -> 1.3.0")), "says what moved");
    assert(str_contains(nous_error_msg(de), str_from("Regenerate the lockfile")), "says how to accept it");
    var nt, np = resolver_resolve_all(r, roots);
    var nlt, nl = nous_lock_from_plan(np, roots);
    var df = nous_lock_diff(parsed, nl);
    assert_eq(vec_len(df), 1, "one difference");
    assert_eq(nous_ld_kind(vec_get(df, 0)), NOUS_LOCK_VERSION_CHANGED, "VERSION_CHANGED");
    # A new dependency: an added package and a changed edge list.
    write_manifest_v(d, "lk-extra", "2.0.0", "");
    write_manifest_v(d, "lk-util", "0.3.0", "\"lk-lib\":\"*\",\"lk-extra\":\"*\"");
    registry_reload(rs_reg(r));
    var at, ap = resolver_resolve_all(r, roots);
    var alt, al = nous_lock_from_plan(ap, roots);
    var df2 = nous_lock_diff(nl, al);
    assert_eq(vec_len(df2), 2, "added + deps changed");
    assert_eq(nous_ld_kind(vec_get(df2, 0)), NOUS_LOCK_ADDED, "lk-extra added");
    assert(str_eq_cstr(nous_ld_new(vec_get(df2, 0)), "marketplace 2.0.0"), "added: source and version");
    assert_eq(nous_ld_kind(vec_get(df2, 1)), NOUS_LOCK_DEPS_CHANGED, "lk-util deps changed");
    assert(str_eq_cstr(nous_lock_diff_text(vec_get(df2, 1)),
        "lk-util: dependencies [lk-lib] -> [lk-extra, lk-lib]"), "deps diff text");
    var rev = nous_lock_diff(al, nl);
    assert_eq(nous_ld_kind(vec_get(rev, 0)), NOUS_LOCK_REMOVED, "the reverse is a removal");
    # Source drift: the lock says community, the resolver finds marketplace.
    var st, sl = nous_lock_parse(str_from(lk_doc("lk-lib", lk_pkg("lk-lib", "1.3.0", "community", "[]"))));
    assert_eq(is_ok(st), 1, "a hand-made lock parses");
    var sdt, sde = nous_resolve_locked(r, sl);
    assert_eq(is_err_result(sdt), 1, "a source change is drift");
    assert(str_contains(ne_detail(sde), str_from("lk-lib: source community -> marketplace")), "says so");
    # A root that no longer resolves comes through as the resolution's own error.
    var gt, gl = nous_lock_parse(str_from(lk_doc("lk-gone", lk_pkg("lk-gone", "1", "marketplace", "[]"))));
    var gdt, gde = nous_resolve_locked(r, gl);
    assert_eq(ne_kind(gde), NOUS_ERR_NOT_FOUND, "a vanished root is NOT_FOUND");
    # JSON both ways.
    var jl = nous_lock_from_json(nous_lock_to_json(lock));
    assert(jl != 0, "lock from json");
    assert_eq(vec_len(nous_lock_diff(lock, jl)), 0, "lock JSON roundtrips");
    assert(str_eq(nous_lock_to_str(jl), text), "and gives the same text");
    var jd = nous_lock_diff_from_json(nous_lock_diff_to_json(vec_get(df2, 0)));
    assert_eq(nous_ld_kind(jd), NOUS_LOCK_ADDED, "diff JSON: kind");
    assert(str_eq_cstr(nous_ld_name(jd), "lk-extra"), "diff JSON: name");
    assert_eq(nous_ld_old(jd), 0, "diff JSON: null old");
    assert(str_eq_cstr(nous_ld_new(jd), "marketplace 2.0.0"), "diff JSON: new");
    rm_rf(d); rm_rf(c);
}

# 1.7.2: parsing is strict about what it needs, lenient about the rest.
fn test_lockfile_parse() {
    test_group("lockfile_parse");
    var pk = lk_pkg("a", "1", "system", "[]");
    var e0 = "version = 1\nroots = []\n";
    assert_eq(lk_parse_err(lk_doc("a", pk)), 0, "minimal lock");
    assert_eq(lk_parse_err(""), 1, "empty");
    assert_eq(lk_parse_err("roots = []\n"), 1, "no version");
    assert_eq(lk_parse_err("version = 2\nroots = []\n"), 1, "unsupported version");
    assert_eq(lk_parse_err("version = 1\n"), 1, "no roots");
    assert_eq(lk_parse_err(e0), 0, "an empty lock");
    var no_name = "[[package]]\nversion = \"1\"\nsource = \"system\"\ndependencies = []\n";
    assert_eq(lk_parse_err(j4c(e0, no_name, "", "")), 1, "no name");
    var no_ver = "[[package]]\nname = \"a\"\nsource = \"system\"\ndependencies = []\n";
    assert_eq(lk_parse_err(j4c(e0, no_ver, "", "")), 1, "no version");
    var no_src = "[[package]]\nname = \"a\"\nversion = \"1\"\ndependencies = []\n";
    assert_eq(lk_parse_err(j4c(e0, no_src, "", "")), 1, "no source");
    var no_deps = "[[package]]\nname = \"a\"\nversion = \"1\"\nsource = \"system\"\n";
    assert_eq(lk_parse_err(j4c(e0, no_deps, "", "")), 1, "no dependencies");
    assert_eq(lk_parse_err(j4c(e0, lk_pkg("a", "1", "pypi", "[]"), "", "")), 1, "unknown source");
    assert_eq(lk_parse_err(j4c(e0, pk, pk, "")), 1, "locked twice");
    var dep_b = lk_pkg("a", "1", "system", "[\"b\"]");
    assert_eq(lk_parse_err(j4c(e0, dep_b, "", "")), 1, "a dependency that is not locked");
    assert_eq(lk_parse_err(lk_doc("zz", pk)), 1, "a root that is not locked");
    var tab = lk_pkg("a", "1\t2", "system", "[]");
    assert_eq(lk_parse_err(j4c(e0, tab, "", "")), 1, "a control character in a value");
    var future = j4c("[[package]]\nname = \"a\"\nversion = \"1\"\n",
      "source = \"system\"\nsignature = \"x\"\ndependencies = []\n", "", "");
    assert_eq(lk_parse_err(j4c("version = 1\nroots = [\"a\"]\nfuture = \"x\"\n", future, "", "")), 0,
      "unknown keys are ignored");
    var et, ee = nous_lock_parse(str_from("version = 2\nroots = []\n"));
    assert_eq(ne_kind(ee), NOUS_ERR_INVALID_LOCKFILE, "kind INVALID_LOCKFILE");
    assert(str_contains(nous_error_msg(ee), str_from("invalid lockfile")), "message");
    # Any order is accepted and put in byte order.
    var messy = j4("version = 1\nroots = [\"b\", \"a\", \"a\"]\n",
      lk_pkg("b", "2", "community", "[\"c\", \"a\"]"),
      lk_pkg("c", "3", "flutter-app", "[]"),
      lk_pkg("a", "", "system", "[]"));
    var mt, ml = nous_lock_parse(messy);
    assert_eq(is_ok(mt), 1, "an unordered lock parses");
    var canon = j4(j4c(LK_HEAD, "roots = ", lk_a2("a", "b"), "\n"),
      lk_out("a", "", "system", "[]"),
      lk_out("b", "2", "community", lk_a2("a", "c")),
      lk_out("c", "3", "flutter-app", "[]"));
    assert(str_eq(nous_lock_to_str(ml), canon), "normalized to byte order (an empty version kept)");
}

# 1.7.2: generating from a plan: apt nodes are locked, edges to names apt
# could not show are not, and values a lockfile cannot hold are refused.
fn lk_rp(name, ver, src, deps): i64 {
    return resolved_pkg_new(str_from(name), str_from(ver), src, str_from(""), 0, deps, 1);
}
fn test_lockfile_from_plan() {
    test_group("lockfile_from_plan");
    var deps = vec_new();
    vec_push(deps, str_from("libb")); vec_push(deps, str_from("virtual-x"));
    var pkgs = vec_new();
    vec_push(pkgs, lk_rp("liba", "1:2.36-9+deb12u7", SOURCE_SYSTEM, deps));
    vec_push(pkgs, lk_rp("libb", "3.0~rc1-1", SOURCE_SYSTEM, vec_new()));
    var roots = vec_new();
    vec_push(roots, str_from("liba"));
    var t, lk = nous_lock_from_plan(res_plan_new(pkgs, vec_new()), roots);
    assert_eq(is_ok(t), 1, "an apt plan locks");
    var a = nous_lock_get(lk, str_from("liba"));
    assert_eq(nous_lp_source(a), SOURCE_SYSTEM, "apt nodes are locked");
    assert(str_eq_cstr(nous_lp_version(a), "1:2.36-9+deb12u7"), "a Debian version as is");
    assert_eq(vec_len(nous_lp_deps(a)), 1, "an edge to a name apt could not show is not locked");
    var pt, back = nous_lock_parse(nous_lock_to_str(lk));
    assert_eq(is_ok(pt), 1, "Debian versions roundtrip");
    assert_eq(vec_len(nous_lock_diff(lk, back)), 0, "unchanged");
    var bad = vec_new();
    vec_push(bad, lk_rp("x", "1.0\"", SOURCE_MARKETPLACE, vec_new()));
    var bt, be = nous_lock_from_plan(res_plan_new(bad, vec_new()), vec_new());
    assert_eq(is_err_result(bt), 1, "a quote in a version is refused");
    assert_eq(ne_kind(be), NOUS_ERR_INVALID_LOCKFILE, "kind INVALID_LOCKFILE");
    var nr = vec_new();
    vec_push(nr, str_from("not-there"));
    var rt, re = nous_lock_from_plan(res_plan_new(pkgs, vec_new()), nr);
    assert_eq(is_err_result(rt), 1, "a root that is not in the plan is refused");
}

# 1.7.2: locked resolution with the recipe DB (community packages).
fn test_lockfile_recipes() {
    test_group("lockfile_recipes");
    var z = mkdir_test();
    var base = path_join(z, str_from("base"));
    mkdir_str(base);
    write_text(path_join(base, str_from("rz-a.cyml")),
      "[package]\nname = \"rz-a\"\nversion = \"1.0\"\n\n[depends]\nruntime = [\"rz-b\"]\n");
    write_text(path_join(base, str_from("rz-b.cyml")), "[package]\nname = \"rz-b\"\nversion = \"2.0p1\"\n");
    var d = mkdir_test();
    var c = mkdir_test();
    var r_t, r = resolver_new(d, c);
    resolver_with_recipes(r, recipe_db_load(z));
    var roots = vec_new();
    vec_push(roots, str_from("rz-a"));
    var pt, plan = resolver_resolve_all_with_recipes(r, roots);
    assert_eq(is_ok(pt), 1, "resolves from recipes");
    var lt, lk = nous_lock_from_plan(plan, roots);
    assert_eq(nous_lp_source(nous_lock_get(lk, str_from("rz-b"))), SOURCE_COMMUNITY, "community source");
    var tt, back = nous_lock_parse(nous_lock_to_str(lk));
    var rt, rp = nous_resolve_locked(r, back);
    assert_eq(is_ok(rt), 1, "locked resolution uses the attached recipe DB");
    rm_rf(z); rm_rf(d); rm_rf(c);
}

# 1.7.3: artifact checksums in the lock (ADR 0009). LK_H1 / LK_H2 are real
# SHA-256 digests (of "" and of "hello").
var LK_H1 = "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855";
var LK_H2 = "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824";
# 1 when two Strs (either may be 0) are equal; 0 and 0 are equal.
fn lk_eq(a, b): i64 {
    if (a == 0 || b == 0) {
        if (a == b) { return 1; }
        return 0;
    }
    return str_eq(a, b);
}
# The first diff of a vec, or a blank one when it is empty (so a missing diff
# fails its assertions instead of crashing).
fn lk_d0(v): i64 {
    if (vec_len(v) > 0) { return vec_get(v, 0); }
    return _nous_ld_new(0 - 1, str_from("?"), str_from(""), str_from(""));
}
# "sha256:<hex>" as a cstr.
fn lk_sum(hex): i64 { return j4c("sha256:", hex, "", ""); }
# A [[package]] table with a checksum line, in the order nous writes it.
fn lk_pkg_sum(name, ver, src, sum, deps): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[[package]]\nname = \"");
    str_builder_add_cstr(sb, name);
    str_builder_add_cstr(sb, "\"\nversion = \"");
    str_builder_add_cstr(sb, ver);
    str_builder_add_cstr(sb, "\"\nsource = \"");
    str_builder_add_cstr(sb, src);
    str_builder_add_cstr(sb, "\"\nchecksum = \"");
    str_builder_add_cstr(sb, sum);
    str_builder_add_cstr(sb, "\"\ndependencies = ");
    str_builder_add_cstr(sb, deps);
    str_builder_add_cstr(sb, "\n");
    return _nous_cstr(str_builder_build(sb));
}
# One locked package (no deps) with a checksum Str or 0, as a one-package lock.
fn lk_one(name, ver, src, sum): i64 {
    var pkgs = vec_new();
    vec_push(pkgs, nous_lock_pkg_new_full(str_from(name), str_from(ver), src, vec_new(), sum));
    return nous_lock_new(1, vec_new(), pkgs);
}
fn test_lockfile_checksums() {
    test_group("lockfile_checksums");
    var h1 = str_from(LK_H1);
    var s1 = str_from(lk_sum(LK_H1));
    var s2 = str_from(lk_sum(LK_H2));
    # The published-digest helper and the lockfile form.
    assert(lk_eq(_nous_sha256_checksum(h1), s1), "64 hex digits become sha256:<hex>");
    var upper = j4("  E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855", " ", "", "");
    assert(lk_eq(_nous_sha256_checksum(upper), s1), "uppercase is lowercased and the value trimmed");
    assert_eq(_nous_sha256_checksum(str_sub(h1, 0, 63)), 0, "63 digits: none");
    assert_eq(_nous_sha256_checksum(j4(LK_H1, "0", "", "")), 0, "65 digits: none");
    assert_eq(_nous_sha256_checksum(j4("g", str_cstr(str_sub(h1, 1, 63)), "", "")), 0, "a non-hex digit: none");
    assert_eq(_nous_sha256_checksum(str_from("")), 0, "empty: none");
    assert_eq(_nous_sha256_checksum(0), 0, "0: none");
    assert_eq(_nous_checksum_ok(s1), 1, "the lockfile form");
    var upsum = "sha256:E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852B855";
    assert_eq(_nous_checksum_ok(str_from(upsum)), 0, "uppercase is not the lockfile form");
    assert_eq(_nous_checksum_ok(j4("sha512:", LK_H1, "", "")), 0, "another algorithm");
    assert_eq(_nous_checksum_ok(str_sub(s1, 0, 70)), 0, "one digit short");
    assert_eq(_nous_checksum_ok(h1), 0, "no algorithm");
    assert_eq(_nous_checksum_ok(0), 0, "0");
    # apt: the candidate stanza's SHA256 field.
    var st1 = j4("Package: libz\nVersion: 1:1.2.13-1\nMD5sum: d41d8cd98f00b204e9800998ecf8427e\n",
      "SHA256: ", LK_H1, "\nDescription: zlib\n");
    var ap = _sysdb_parse_info(str_from("libz"), st1);
    assert(lk_eq(nous_rp_checksum(ap), s1), "apt: SHA256 is the checksum (not MD5sum)");
    var st2 = j4("Package: libz\nVersion: 1\nSHA256: ", LK_H2, "\n\nPackage: libz\nVersion: 0.9\nSHA256: ", LK_H1);
    assert(lk_eq(nous_rp_checksum(_sysdb_parse_info(str_from("libz"), st2)), s2), "apt: the first stanza's");
    var st3 = j4("Package: libz\nVersion: 1\nStatus: install ok installed\n\nPackage: libz\nVersion: 0.9\nSHA256: ",
      LK_H1, "\n", "");
    assert_eq(nous_rp_checksum(_sysdb_parse_info(str_from("libz"), st3)), 0, "apt: dpkg status only, none");
    var st4 = str_from("Package: libz\nVersion: 1\nSHA256: not-a-digest\n");
    assert_eq(nous_rp_checksum(_sysdb_parse_info(str_from("libz"), st4)), 0, "apt: malformed, none");
    var two = j4("Package: a\nVersion: 1\nSHA256: ", LK_H1, "\n\nPackage: b\nVersion: 2\n", "");
    var many = _sysdb_parse_info_many(two);
    assert(lk_eq(nous_rp_checksum(map_get(many, "a")), s1), "apt batch: a's checksum");
    assert_eq(nous_rp_checksum(map_get(many, "b")), 0, "apt batch: b has none");
    # ResolvedPkg JSON carries it.
    var jp = resolved_from_json(resolved_to_json(ap));
    assert(lk_eq(nous_rp_checksum(jp), s1), "ResolvedPkg JSON roundtrips the checksum");
    var nj = resolved_to_json(lk_rp("n", "1", SOURCE_MARKETPLACE, vec_new()));
    assert(str_contains(nj, str_from("\"checksum\":null")), "no checksum is null");
    assert_eq(nous_rp_checksum(resolved_from_json(str_from("{\"name\":\"n\"}"))), 0, "absent in JSON: none");
    # Locking a plan: the checksum is written between source and dependencies.
    var pkgs = vec_new();
    vec_push(pkgs, nous_rp_set_checksum(lk_rp("ca", "1.0", SOURCE_SYSTEM, vec_new()), s1));
    vec_push(pkgs, lk_rp("cb", "2.0", SOURCE_MARKETPLACE, vec_new()));
    var roots = vec_new();
    vec_push(roots, str_from("ca"));
    var lt, lk = nous_lock_from_plan(res_plan_new(pkgs, vec_new()), roots);
    assert_eq(is_ok(lt), 1, "a plan with checksums locks");
    assert(lk_eq(nous_lp_checksum(nous_lock_get(lk, str_from("ca"))), s1), "the checksum is locked");
    assert_eq(nous_lp_checksum(nous_lock_get(lk, str_from("cb"))), 0, "none stays none");
    var want = j4(j4c(LK_HEAD, "roots = ", lk_a1("ca"), "\n"),
      j4c("\n", lk_pkg_sum("ca", "1.0", "system", lk_sum(LK_H1), "[]"), "", ""),
      lk_out("cb", "2.0", "marketplace", "[]"), "");
    assert(str_eq(nous_lock_to_str(lk), want), "exact text: a checksum line only where there is one");
    var pt, back = nous_lock_parse(nous_lock_to_str(lk));
    assert_eq(is_ok(pt), 1, "parses");
    assert(lk_eq(nous_lp_checksum(nous_lock_get(back, str_from("ca"))), s1), "parsed checksum");
    assert_eq(vec_len(nous_lock_diff(lk, back)), 0, "no differences one way");
    assert_eq(vec_len(nous_lock_diff(back, lk)), 0, "nor the other");
    var jl = nous_lock_from_json(nous_lock_to_json(lk));
    assert(lk_eq(nous_lp_checksum(nous_lock_get(jl, str_from("ca"))), s1), "lock JSON carries the checksum");
    assert_eq(nous_lp_checksum(nous_lock_get(jl, str_from("cb"))), 0, "and null back to none");
    assert_eq(vec_len(nous_lock_diff(lk, jl)) + vec_len(nous_lock_diff(jl, lk)), 0, "lock JSON roundtrips");
    assert_eq(nous_lp_checksum(nous_lock_get(lk_one("x", "1", 0, 0), str_from("x"))), 0, "pkg_new_full with 0");
    var bad = vec_new();
    vec_push(bad, nous_rp_set_checksum(lk_rp("x", "1", SOURCE_SYSTEM, vec_new()), str_from(LK_H1)));
    var bt, be = nous_lock_from_plan(res_plan_new(bad, vec_new()), vec_new());
    assert_eq(ne_kind(be), NOUS_ERR_INVALID_LOCKFILE, "a checksum without its algorithm cannot be locked");
    assert(str_contains(ne_detail(be), str_from("sha256:<64 lowercase hex digits>")), "says the form");
    # Parsing: optional, and strict when present.
    var e0 = "version = 1\nroots = []\n";
    assert_eq(lk_parse_err(j4c(e0, lk_pkg_sum("a", "1", "system", lk_sum(LK_H1), "[]"), "", "")), 0, "valid");
    assert_eq(lk_parse_err(j4c(e0, lk_pkg_sum("a", "1", "system", "x", "[]"), "", "")), 1, "not a checksum");
    assert_eq(lk_parse_err(j4c(e0, lk_pkg_sum("a", "1", "system", "", "[]"), "", "")), 1, "empty");
    assert_eq(lk_parse_err(j4c(e0, lk_pkg_sum("a", "1", "system", LK_H1, "[]"), "", "")), 1, "no algorithm");
    assert_eq(lk_parse_err(j4c(e0, lk_pkg_sum("a", "1", "system", upsum, "[]"), "", "")), 1, "uppercase");
    assert_eq(lk_parse_err(j4c(e0, lk_pkg_sum("a", "1", "system", j4c("md5:", LK_H1, "", ""), "[]"), "", "")), 1,
      "another algorithm");
    var ct, ce = nous_lock_parse(str_from(j4c(e0, lk_pkg_sum("a", "1", "system", "x", "[]"), "", "")));
    assert(str_eq_cstr(ne_msg(ce), "a"), "the error names the package");
    # Diff: one-sided, and only for the same version and source.
    var dc = nous_lock_diff(lk_one("p", "1", SOURCE_SYSTEM, s1), lk_one("p", "1", SOURCE_SYSTEM, s2));
    assert_eq(vec_len(dc), 1, "other bytes, same version: one difference");
    assert_eq(nous_ld_kind(lk_d0(dc)), NOUS_LOCK_CHECKSUM_CHANGED, "CHECKSUM_CHANGED");
    assert(lk_eq(nous_ld_old(lk_d0(dc)), s1), "old checksum");
    assert(lk_eq(nous_ld_new(lk_d0(dc)), s2), "new checksum");
    assert(str_eq(nous_lock_diff_text(lk_d0(dc)), j4("p: checksum ", lk_sum(LK_H1), " -> ", lk_sum(LK_H2))),
      "checksum diff text");
    var dg = nous_lock_diff(lk_one("p", "1", SOURCE_SYSTEM, s1), lk_one("p", "1", SOURCE_SYSTEM, 0));
    assert_eq(nous_ld_kind(lk_d0(dg)), NOUS_LOCK_CHECKSUM_CHANGED, "a checksum that is gone is a change");
    assert_eq(nous_ld_new(lk_d0(dg)), 0, "new is 0");
    assert(str_eq(nous_lock_diff_text(lk_d0(dg)), j4("p: checksum ", lk_sum(LK_H1), " -> none", "")),
      "gone reads as none");
    var gj = nous_lock_diff_from_json(nous_lock_diff_to_json(lk_d0(dg)));
    assert_eq(nous_ld_kind(gj), NOUS_LOCK_CHECKSUM_CHANGED, "diff JSON: kind 7");
    assert_eq(nous_ld_new(gj), 0, "diff JSON: null new");
    assert_eq(vec_len(nous_lock_diff(lk_one("p", "1", SOURCE_SYSTEM, 0), lk_one("p", "1", SOURCE_SYSTEM, s1))), 0,
      "a checksum the old lock did not pin is not a change");
    var dv = nous_lock_diff(lk_one("p", "1", SOURCE_SYSTEM, s1), lk_one("p", "2", SOURCE_SYSTEM, s2));
    assert_eq(vec_len(dv), 1, "a new version: no separate checksum change");
    assert_eq(nous_ld_kind(lk_d0(dv)), NOUS_LOCK_VERSION_CHANGED, "VERSION_CHANGED only");
    var ds = nous_lock_diff(lk_one("p", "1", SOURCE_SYSTEM, s1), lk_one("p", "1", SOURCE_COMMUNITY, s2));
    assert_eq(vec_len(ds), 1, "a new source: no separate checksum change");
    assert_eq(nous_ld_kind(lk_d0(ds)), NOUS_LOCK_SOURCE_CHANGED, "SOURCE_CHANGED only");
}

# 1.7.3: locked resolution checks recipe checksums.
fn lk_recipe(dir, sha): i64 {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "[package]\nname = \"rc-b\"\nversion = \"2.0\"\n\n[source]\nsha256 = \"");
    str_builder_add_cstr(sb, sha);
    str_builder_add_cstr(sb, "\"\n");
    write_text(path_join(dir, str_from("rc-b.cyml")), _nous_cstr(str_builder_build(sb)));
    return 0;
}
fn test_lockfile_checksum_drift() {
    test_group("lockfile_checksum_drift");
    var z = mkdir_test();
    var base = path_join(z, str_from("base"));
    mkdir_str(base);
    write_text(path_join(base, str_from("rc-a.cyml")),
      "[package]\nname = \"rc-a\"\nversion = \"1.0\"\n\n[source]\nsha256 = \"\"\n\n[depends]\nruntime = [\"rc-b\"]\n");
    lk_recipe(base, LK_H1);
    var d = mkdir_test();
    var c = mkdir_test();
    var r_t, r = resolver_new(d, c);
    resolver_with_recipes(r, recipe_db_load(z));
    var roots = vec_new();
    vec_push(roots, str_from("rc-a"));
    var pt, plan = resolver_resolve_all_with_recipes(r, roots);
    var lt, lk = nous_lock_from_plan(plan, roots);
    assert(lk_eq(nous_lp_checksum(nous_lock_get(lk, str_from("rc-b"))), str_from(lk_sum(LK_H1))),
      "a recipe's sha256 is locked");
    assert_eq(nous_lp_checksum(nous_lock_get(lk, str_from("rc-a"))), 0, "an empty sha256 locks none");
    var text = nous_lock_to_str(lk);
    var tt, locked = nous_lock_parse(text);
    var ot, op = nous_resolve_locked(r, locked);
    assert_eq(is_ok(ot), 1, "same checksum: locked resolution passes");
    # A 1.7.2 lock has no checksums: it still holds.
    var old = vec_new();
    var pk = nous_lock_pkgs(locked);
    var i = 0;
    while (i < vec_len(pk)) {
        var p = vec_get(pk, i);
        vec_push(old, nous_lock_pkg_new(nous_lp_name(p), nous_lp_version(p), nous_lp_source(p), nous_lp_deps(p)));
        i = i + 1;
    }
    var ol = nous_lock_new(1, nous_lock_roots(locked), old);
    var o2t, o2 = nous_resolve_locked(r, ol);
    assert_eq(is_ok(o2t), 1, "a lock without checksums (1.7.2) still passes");
    # The recipe's source hash changes, the version does not.
    lk_recipe(base, LK_H2);
    resolver_with_recipes(r, recipe_db_load(z));
    var dt, de = nous_resolve_locked(r, locked);
    assert_eq(is_err_result(dt), 1, "other bytes under the same version are drift");
    assert_eq(ne_kind(de), NOUS_ERR_LOCK_MISMATCH, "kind LOCK_MISMATCH");
    assert(str_contains(ne_detail(de), str_from(j4c("rc-b: checksum ", lk_sum(LK_H1), " -> ", lk_sum(LK_H2)))),
      "says which checksum moved");
    var d2t, d2 = nous_resolve_locked(r, ol);
    assert_eq(is_ok(d2t), 1, "the 1.7.2 lock pinned no bytes, so it still passes");
    # The hash is removed from the recipe.
    lk_recipe(base, "");
    resolver_with_recipes(r, recipe_db_load(z));
    var gt, ge = nous_resolve_locked(r, locked);
    assert_eq(is_err_result(gt), 1, "a checksum that is gone is drift");
    assert(str_contains(ne_detail(ge), str_from(j4c("rc-b: checksum ", lk_sum(LK_H1), " -> none", ""))), "says none");
    rm_rf(z); rm_rf(d); rm_rf(c);
}

fn test_deb_versions() {
    test_group("deb_versions");
    assert(deb("7.81.0-1ubuntu1.16", "7.81.0-1ubuntu1.15") > 0, "revision-only security update");
    assert(deb("1:1.0-1", "2.0-1") > 0, "epoch wins");
    assert(deb("2.30-0ubuntu2", "2.30~rc1-1") > 0, "~ sorts before the release");
    assert(deb("1.0~rc1", "1.0") < 0, "~ sorts before the end");
    assert(deb("120.0.6099.224-1~deb12u1", "120.0.6099.216-1~deb12u1") > 0, "numeric parts");
    assert(deb("2024b-1", "2024a-1") > 0, "letter suffix");
    assert(deb("0.9.8zh-1", "0.9.8zg-1") > 0, "letters after digits");
    assert(deb("2.36-10", "2.36-9") > 0, "revision 10 > 9");
    assert_eq(deb("1.0", "1.0-0"), 0, "absent revision == 0");
    assert_eq(deb("1.0", "1.00"), 0, "leading zeros");
    # update detection per source: community uses Debian order, marketplace SemVer.
    assert_eq(nous_update_is_newer_src(j4(
          "10.3p2",
          "",
          "",
          ""), str_from("10.3p1"), SOURCE_COMMUNITY), 1, "zugot p-suffix update");
    assert_eq(nous_update_is_newer_src(j4(
          "2.0-1",
          "",
          "",
          ""), str_from("1:1.0-1"), SOURCE_COMMUNITY), 0, "no epoch downgrade");
    assert_eq(update_is_newer(str_from("v2.0.0"), str_from("1.0.0")), 1, "leading v is an update");
    assert_eq(update_is_newer(str_from("1.0.0"), str_from("v2.0.0")), 0, "and not a downgrade");
}

# 1.5.3 (D1, P0-2 / P1-3): every constraint on a dependency counts, and the
# version chosen must satisfy all of them.
fn test_conflicts_sound() {
    test_group("conflicts_sound");
    var d = mkdir_test();
    var c = mkdir_test();
    # *, =1.0.0 and =2.0.0 on dd: only the first used to be kept.
    write_manifest_deps(d, "xa", "native", "\"dd\":\"*\"");
    write_manifest_deps(d, "ya", "native", "\"dd\":\"=1.0.0\"");
    write_manifest_deps(d, "za", "native", "\"dd\":\"=2.0.0\"");
    write_manifest(d, "dd", "native");
    # b4 >= 2.0.0 while the only b4 is 1.0.0.
    write_manifest_deps(d, "a4", "native", "\"b4\":\">=2.0.0\"");
    write_manifest(d, "b4", "native");
    # >1.0.0 and <1.1.0 with dd7 1.0.0: compatible ranges, but 1.0.0 is outside.
    write_manifest_deps(d, "x7", "native", "\"dd7\":\">=1.0.0\"");
    write_manifest_deps(d, "y7", "native", "\"dd7\":\"<1.1.0\"");
    write_manifest(d, "dd7", "native");
    var r_t, r = resolver_new(d, c);
    resolver_with_strategy(r, strategy_only(SOURCE_MARKETPLACE));
    var n1 = vec_new();
    vec_push(n1, str_from("xa")); vec_push(n1, str_from("ya")); vec_push(n1, str_from("za"));
    var t1, e1 = resolver_resolve_all(r, n1);
    assert_eq(is_err_result(t1), 1, "=1.0.0 and =2.0.0 conflict, whatever came first");
    assert_eq(ne_kind(e1), NOUS_ERR_VERSION_CONFLICT, "kind VERSION_CONFLICT");
    assert(str_contains(ne_detail(e1), str_from("ya requires =1.0.0")), "names one side");
    assert(str_contains(ne_detail(e1), str_from("za requires =2.0.0")), "and the other");
    var n2 = vec_new();
    vec_push(n2, str_from("a4"));
    var t2, e2 = resolver_resolve_all(r, n2);
    assert_eq(is_err_result(t2), 1, "the chosen version is checked");
    assert(str_contains(ne_detail(e2), str_from("the version available is 1.0.0")), "says which version");
    var n3 = vec_new();
    vec_push(n3, str_from("x7")); vec_push(n3, str_from("y7"));
    var t3, p3 = resolver_resolve_all(r, n3);
    assert_eq(is_ok(t3), 1, ">=1.0.0 with <1.1.0 accepts dd7 1.0.0");
    rm_rf(d); rm_rf(c);
}

# 1.5.3: every public type roundtrips through JSON with every field, and
# hostile strings stay strings (escaped on output, decoded on input).
fn test_json_roundtrip_all() {
    test_group("json_roundtrip_all");
    var evil = str_from("say \"hi\" C:\\ path\nnext\tcafé");
    # ResolvedPkg: all seven fields.
    var deps = vec_new();
    vec_push(deps, str_from("a\"b"));
    vec_push(deps, str_from("c"));
    var rp = resolved_pkg_new(str_from("pkg"), str_from("1.2.3"), SOURCE_FLUTTER_APP, evil, 4096, deps, 1);
    var rj = resolved_to_json(rp);
    var rb = resolved_from_json(rj);
    assert(rb != 0, "resolved parses back");
    assert(str_eq(rp_desc(rb), evil), "hostile description roundtrips");
    assert_eq(rp_size(rb), 4096, "size roundtrips");
    assert_eq(vec_len(rp_deps(rb)), 2, "deps roundtrip");
    assert(str_eq(vec_get(rp_deps(rb), 0), str_from("a\"b")), "dep with a quote roundtrips");
    assert_eq(rp_trust(rb), 1, "trust roundtrips");
    assert_eq(rp_src(rb), SOURCE_FLUTTER_APP, "source roundtrips");
    # A description cannot inject keys any more.
    var inj = resolved_pkg_new(str_from("x"), str_from("1"), SOURCE_COMMUNITY,
      str_from("x\",\"trusted\":true,\"z\":\""), 0, vec_new(), 0);
    var ib = resolved_from_json(resolved_to_json(inj));
    assert_eq(rp_trust(ib), 0, "injected \"trusted\":true is just text");
    # InstalledPkg: date, negative size, auto flag.
    var ip = installed_pkg_new(str_from("ipk"), str_from("2.0"), SOURCE_SYSTEM, 1700000000, 0 - 5, 1);
    var ipb = installed_from_json(installed_to_json(ip));
    assert_eq(ip_date(ipb), 1700000000, "install_date roundtrips");
    assert_eq(ip_size(ipb), 0 - 5, "negative size roundtrips");
    assert_eq(ip_auto(ipb), 1, "auto_installed roundtrips");
    # AvailUpdate (new from_json), with and without a changelog.
    var u = avail_update_new(str_from("upk"), SOURCE_MARKETPLACE, str_from("1.0"), str_from("1.1"), evil);
    var ub = nous_update_from_json(update_to_json(u));
    assert(str_eq(load64(ub + 24), str_from("1.1")), "available_version roundtrips");
    assert(str_eq(load64(ub + 32), evil), "changelog roundtrips");
    var u0 = nous_update_from_json(update_to_json(avail_update_new(j4(
            "z",
            "",
            "",
            ""), SOURCE_SYSTEM, str_from("1"), str_from("2"), 0)));
    assert_eq(load64(u0 + 32), 0, "null changelog roundtrips as 0");
    # SearchResult (new from_json), sources included.
    var res = vec_new();
    vec_push(res, rp);
    var srcs = vec_new();
    vec_push(srcs, SOURCE_MARKETPLACE);
    vec_push(srcs, SOURCE_SYSTEM);
    var srb = search_result_from_json(search_result_to_json(nous_search_result_new(res, srcs, 1)));
    assert_eq(vec_len(sr_results(srb)), 1, "search results roundtrip");
    assert_eq(vec_get(sr_sources(srb), 1), SOURCE_SYSTEM, "search sources roundtrip");
    assert_eq(sr_total(srb), 1, "search total roundtrips");
    # NousError: message with a quote, detail null.
    var eb = error_kind_from_json(error_kind_to_json(nous_error_new(NOUS_ERR_NOT_FOUND, str_from("d\"d"), 0)));
    assert(str_eq(ne_msg(eb), str_from("d\"d")), "message with a quote roundtrips");
    assert_eq(ne_detail(eb), 0, "null detail roundtrips as 0");
    assert_eq(ne_kind(eb), NOUS_ERR_NOT_FOUND, "kind roundtrips");
    # AgentInfo and Manifest (new from_json).
    var ag = nous_agent_info_new(str_from("ag"), str_from("3.0"), evil);
    var agb = agent_info_from_json(agent_info_to_json(ag));
    assert(str_eq(ai_desc(agb), evil), "agent description roundtrips");
    var md = map_new();
    map_set(md, "dep\\x", str_from("^1.0"));
    var mb = nous_manifest_from_json(manifest_to_json(manifest_new(ag, md, str_from("flutter"))));
    assert(str_eq(mf_runtime(mb), str_from("flutter")), "runtime roundtrips");
    assert_eq(map_has(mf_deps(mb), "dep\\x"), 1, "a dependency key ending in a backslash roundtrips");
    # Strategy (parsed, not substring-matched).
    assert_eq(st_kind(strategy_from_json(strategy_to_json(strategy_system_first()))), STRAT_SYSTEM_FIRST,
      "strategy roundtrips");
    assert_eq(st_only(strategy_from_json(strategy_to_json(strategy_only(SOURCE_FLUTTER_APP)))),
      SOURCE_FLUTTER_APP, "OnlySource roundtrips");
}

# 1.5.3 (D7): manifest fields are read by structure.
fn test_manifest_structure() {
    test_group("manifest_structure");
    var m = nous_manifest_from_json(j4(
        "{\"author\":{\"name\":\"mallory\"},\"agent\":{\"name\":\"real\",\"version\":\"1.0\",",
        "\"description\":\"dependencies\"},\"meta\":{\"evil\":\"1.0\"},",
        "\"dependencies\":{\"good\":\"*\"},\"runtime\":\"native\"}",
        ""));
    assert(m != 0, "manifest parses");
    assert(str_eq(ai_name(mf_agent(m)), str_from("real")), "a nested \"name\" elsewhere is ignored");
    assert_eq(map_has(mf_deps(m), "evil"), 0, "a string \"dependencies\" cannot hijack the deps");
    assert_eq(map_has(mf_deps(m), "good"), 1, "the real dependency is kept");
    assert_eq(nous_manifest_from_json(str_from("not json {")), 0, "not JSON is not a manifest");
    # The kept public helper no longer reads past a trailing backslash.
    var t = json_extract_str(str_from("{\"name\":\"abc\\"), "name");
    assert(str_len(t) <= 4, "json_extract_str stays inside its input");
}

fn test_multiple() {
    test_group("multiple_pkgs");
    var d = mkdir_test();
    var c = mkdir_test();
    var i = 0;
    while (i < 5) {
        var sb = str_builder_new();
        str_builder_add_cstr(sb, "multi-pkg-");
        str_builder_add_int(sb, i);
        write_manifest(d, _nous_cstr(str_builder_build(sb)), "native");
        i = i + 1;
    }
    var r_t, r = resolver_new(d, c);
    var list_t, list = resolver_list(r);
    var cnt = 0;
    i = 0;
    while (i < vec_len(list)) {
        if (str_starts_with(ip_name(vec_get(list, i)), "multi-pkg-") == 1) { cnt = cnt + 1; }
        i = i + 1;
    }
    assert_eq(cnt, 5, "5 pkgs");
    rm_rf(d); rm_rf(c);
}

