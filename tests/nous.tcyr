fn test_constraints_compatible() {
    test_group("constraints_compatible");
    # Compatible: >=1.0 and <2.0
    var c1 = constraint_parse(str_from(">=1.0.0"));
    var c2 = constraint_parse(str_from("<2.0.0"));
    assert_eq(constraints_compatible(c1, c2), 1, "gte+lt compat");
    # Compatible: ^1.2 and >=1.3
    var c3 = constraint_parse(str_from("^1.2.0"));
    var c4 = constraint_parse(str_from(">=1.3.0"));
    assert_eq(constraints_compatible(c3, c4), 1, "caret+gte compat");
    # Incompatible: =1.0.0 and =2.0.0
    var c5 = constraint_parse(str_from("=1.0.0"));
    var c6 = constraint_parse(str_from("=2.0.0"));
    assert_eq(constraints_compatible(c5, c6), 0, "eq+eq incompat");
    # Compatible: * and anything
    var c7 = constraint_parse(str_from("*"));
    assert_eq(constraints_compatible(c7, c1), 1, "any compat");
}

