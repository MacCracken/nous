}

fn test_errors() {
    test_group("errors");
    var cycle = vec_new();
    vec_push(cycle, str_from("A"));
    vec_push(cycle, str_from("B"));
    vec_push(cycle, str_from("C"));
    vec_push(cycle, str_from("A"));
    assert(str_eq(format_cycle(cycle), str_from("A -> B -> C -> A")), "cycle fmt");
    var e = nous_error_new(NOUS_ERR_INVALID_PACKAGE_NAME, str_from("bad;pkg"), str_from("invalid character ';'"));
    var msg = nous_error_msg(e);
    assert(str_contains(msg, str_from("bad;pkg")), "has name");
    assert(str_contains(msg, str_from("invalid character")), "has reason");
    var d = mkdir_test();
    var c = mkdir_test();
    var r_t, r = resolver_new(d, c);
    assert(is_err_result(resolver_resolve(r, str_from(""))), "empty err");
    assert(is_err_result(resolver_resolve(r, str_from(" leading"))), "ws err");
    assert(is_err_result(resolver_resolve(r, str_from("pkg;rm -rf /"))), "inject err");
    rm_rf(d); rm_rf(c);
}

fn test_json() {
    test_group("json");
    var pkg = resolved_pkg_new(str_from("test-pkg"), str_from("1.2.3"),
      SOURCE_SYSTEM, str_from("A test"), 4096, vec_new(), 1);
    var json = resolved_to_json(pkg);
    assert(str_contains(json, str_from("test-pkg")), "name");
    assert(str_contains(json, str_from("1.2.3")), "ver");
    assert(str_contains(json, str_from("system")), "src");
    var nb = json_extract_str(json, "name");
    assert(nb != 0, "extracted");
    assert(str_eq(nb, str_from("test-pkg")), "roundtrip");
}

# --- New tests ported from Rust for completeness ---

fn test_sysdb_new() {
    test_group("sysdb_new");
    var db = sysdb_new();
    # Just verify construction doesn't crash; apt_available depends on host
    var avail = sysdb_available(db);
    assert(avail == 0 || avail == 1, "valid bool");
}

fn test_check_updates_empty() {
    test_group("check_updates_empty");
    var d = mkdir_test();
    var c = mkdir_test();
    var r_t, r = resolver_new(d, c);
    var upd_t, upd = resolver_updates(r);
    assert(is_ok(upd_t), "updates ok");
    # Can't assert exact count (depends on host), just that it works
    var v = upd;
    assert(vec_len(v) >= 0, "no crash");
    rm_rf(d); rm_rf(c);
}

fn test_resolver_missing_marketplace() {
    test_group("resolver_missing_marketplace");
    # A missing marketplace dir must yield a usable empty-registry resolver
    # (not a hard error). Regression for the SIGSEGV where callers got a
    # sentinel resolver and then deref'd a non-error payload.
    var c = mkdir_test();
    var bad = str_from("/nonexistent/marketplace/path");
    var res_t, res = resolver_new(bad, c);
    assert(is_ok(res_t), "missing dir -> ok resolver");
    var r = res;
    assert(r != 0, "resolver non-null");
    # Use a name guaranteed absent from apt, the (empty) marketplace, and the
    # recipe DB, so the assertions hold regardless of whether the test host
    # has apt installed. The regression is that resolution against a resolver
    # built over a MISSING marketplace dir must not crash.
    var bogus = str_from("zzznonexistentpkgxyzzy");
    var rr_t, rr = resolver_resolve(r, bogus);
    assert(is_err_result(rr_t) == 0, "bogus pkg resolves without error");
    assert_eq(rr, 0, "bogus pkg -> none");
    # Full transitive resolve_all must also survive the empty-everything case.
    var names = vec_new();
    vec_push(names, bogus);
    var ra_t, ra = resolver_resolve_all_with_recipes(r, names);
    # 1.5.3 (D4): a root no source has is Err(NOT_FOUND), not a silent empty
    # plan. The regression this test guards is still that it does not crash.
    assert_eq(is_err_result(ra_t), 1, "resolve_all of a missing root is an Err, not a crash");
    assert_eq(ne_kind(ra), NOUS_ERR_NOT_FOUND, "kind NOT_FOUND");
    rm_rf(c);
}

fn test_source_serde_roundtrip() {
    test_group("source_serde");
    var sources = vec_new();
    vec_push(sources, SOURCE_SYSTEM);
    vec_push(sources, SOURCE_MARKETPLACE);
    vec_push(sources, SOURCE_FLUTTER_APP);
    vec_push(sources, SOURCE_COMMUNITY);
    vec_push(sources, SOURCE_UNKNOWN);
    var i = 0;
    while (i < vec_len(sources)) {
        var src = vec_get(sources, i);
        var s = source_to_str(src);
        var back = source_from_json(s);
        assert_eq(back, src, "source roundtrip");
        i = i + 1;
    }
}

fn test_strategy_serde_roundtrip() {
    test_group("strategy_serde");
    var strats = vec_new();
    vec_push(strats, strategy_default());
    vec_push(strats, strategy_system_first());
    vec_push(strats, strategy_search_all());
    vec_push(strats, strategy_only(SOURCE_MARKETPLACE));
    vec_push(strats, strategy_only(SOURCE_SYSTEM));
    vec_push(strats, strategy_only(SOURCE_FLUTTER_APP));
    var i = 0;
    while (i < vec_len(strats)) {
        var s = vec_get(strats, i);
        var json = strategy_to_json(s);
        var back = strategy_from_json(json);
        assert(strategy_eq(s, back), "strategy roundtrip");
        i = i + 1;
    }
}

