fn test_resolve_mkt() {
    test_group("resolve_mkt");
    var d = mkdir_test();
    var c = mkdir_test();
    write_manifest(d, "test-scanner", "native");
    var r_t, r = resolver_new(d, c);
    var res_t, res = resolver_resolve(r, str_from("test-scanner"));
    assert(is_ok(res_t), "ok");
    var pkg = res;
    assert(pkg != 0, "found");
    assert(str_eq(rp_name(pkg), str_from("test-scanner")), "name");
    assert_eq(rp_src(pkg), SOURCE_MARKETPLACE, "src");
    # 1.5.3 (D9): unverified marketplace packages are not trusted.
    assert_eq(rp_trust(pkg), 0, "marketplace is untrusted until sigil verifies it");
    rm_rf(d); rm_rf(c);
}

