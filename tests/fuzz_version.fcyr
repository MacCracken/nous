# Fuzz: semver_parse, constraint_parse / constraint_matches /
# constraints_compatible, and nous_deb_version_cmp (untrusted constraint
# strings from manifests; versions from apt, zugot and the marketplace).
# Invariants (1.5.3): compatibility is symmetric, the Debian comparison is
# antisymmetric and cmp(a, a) == 0, and a constraint with an error matches
# nothing. 1.7.0, with pre-releases and build metadata in the mix:
#   - semver_cmp and nous_semver_cmp_pub are total orders (reflexive,
#     antisymmetric, transitive over each random triple);
#   - pub order refines precedence (it may only break precedence ties);
#   - semver_to_str reparses to an equal version (pub-equal, so build too);
#   - a pre-release matches no constraint that names no pre-release;
#   - compatibility is sound: a version both constraints match means
#     constraints_compatible says 1.
# 1.7.1, compound ranges in the mix:
#   - OR: "A || B" matches exactly when A or B does (and errs when either does);
#   - AND: for a release version, "A B" matches exactly when A and B both do;
#   - hyphen: "A - B" matches exactly what ">=A <=B" does (npm's desugaring).
include "src/types.cyr"
include "src/util.cyr"
include "src/error.cyr"
include "src/strategy.cyr"
include "src/source.cyr"
include "src/command.cyr"
include "src/sort.cyr"
include "src/registry.cyr"
include "src/sysdb.cyr"
include "src/resolver.cyr"
include "src/json.cyr"
include "src/version.cyr"
include "src/graph.cyr"
include "src/recipe.cyr"
include "src/lock.cyr"
include "src/updates.cyr"
include "tests/fz_driver.cyr"

fn _vr_rand(alpha): i64 {
    var sb = str_builder_new();
    var n = fz_below(14);
    var al = strlen(alpha);
    var i = 0;
    while (i < n) {
        var c = load8(alpha + fz_below(al));
        if (fz_one_in(12) == 1) { c = fz_below(256); }
        str_builder_putc(sb, c);
        i = i + 1;
    }
    return str_builder_build(sb);
}

fn _sgn(x): i64 {
    if (x > 0) { return 1; }
    if (x < 0) { return 0 - 1; }
    return 0;
}

# A random version near the interesting shapes: "M.m.p[-pre][+build]".
fn _vr_ver(): i64 {
    if (fz_one_in(3) == 1) { return _vr_rand("0123456789...v-+rcab"); }
    var sb = str_builder_new();
    str_builder_add_int(sb, fz_below(3)); str_builder_putc(sb, 46);
    str_builder_add_int(sb, fz_below(3)); str_builder_putc(sb, 46);
    str_builder_add_int(sb, fz_below(3));
    if (fz_one_in(2) == 1) {
        str_builder_putc(sb, 45);
        str_builder_add(sb, _vr_rand("0123abrc.-"));
    }
    if (fz_one_in(3) == 1) {
        str_builder_putc(sb, 43);
        str_builder_add(sb, _vr_rand("0129ab."));
    }
    return str_builder_build(sb);
}

# One comparator's text: an operator, then version text `vt` (or a fresh one
# when vt is 0). Built around the case's own version a third of the time, so
# pairs that both admit a pre-release are common enough to test.
fn _vr_cmp_text(sb, vt): i64 {
    var ops = vec_new();
    vec_push(ops, ""); vec_push(ops, "="); vec_push(ops, ">="); vec_push(ops, ">");
    vec_push(ops, "<"); vec_push(ops, "<="); vec_push(ops, "^"); vec_push(ops, "~");
    str_builder_add_cstr(sb, vec_get(ops, fz_below(8)));
    if (fz_one_in(8) == 1) { str_builder_putc(sb, 32); }
    if (vt != 0 && fz_one_in(3) == 1) { str_builder_add(sb, vt); } else { str_builder_add(sb, _vr_ver()); }
    return 0;
}

# One comparator set's text: one or two comparators (joined by a space or a
# comma), or now and then a hyphen range.
fn _vr_set_text(vt): i64 {
    var sb = str_builder_new();
    if (fz_one_in(6) == 1) {
        str_builder_add(sb, _vr_ver());
        str_builder_add_cstr(sb, " - ");
        if (vt != 0 && fz_one_in(2) == 1) { str_builder_add(sb, vt); } else { str_builder_add(sb, _vr_ver()); }
        return str_builder_build(sb);
    }
    _vr_cmp_text(sb, vt);
    if (fz_one_in(2) == 1) {
        if (fz_one_in(2) == 1) { str_builder_putc(sb, 32); } else { str_builder_add_cstr(sb, ", "); }
        _vr_cmp_text(sb, vt);
    }
    return str_builder_build(sb);
}

# A random constraint: garbage a quarter of the time, else one comparator set
# or an OR of two.
fn _vr_ct(vt): i64 {
    if (fz_one_in(4) == 1) { return constraint_parse(_vr_rand("0123456789..^~<>=!*xX v-+,| rcab")); }
    var t = _vr_set_text(vt);
    if (fz_one_in(3) == 1) {
        var sb = str_builder_new();
        str_builder_add(sb, t);
        str_builder_add_cstr(sb, " || ");
        str_builder_add(sb, _vr_set_text(vt));
        t = str_builder_build(sb);
    }
    return constraint_parse(t);
}

# OR and AND are what they say (1.7.1).
fn _vr_logic(vt, v): i64 {
    var ta = _vr_set_text(vt);
    var tb = _vr_set_text(vt);
    var ca = constraint_parse(ta);
    var cb = constraint_parse(tb);
    var sb = str_builder_new();
    str_builder_add(sb, ta);
    str_builder_add_cstr(sb, " || ");
    str_builder_add(sb, tb);
    var cor = constraint_parse(str_builder_build(sb));
    var bad = 0;
    if (nous_constraint_error(ca) != 0 || nous_constraint_error(cb) != 0) { bad = 1; }
    if (bad == 1 && nous_constraint_error(cor) == 0) { syscall(60, 42); }
    if (bad == 0 && v != 0) {
        var ma = constraint_matches(ca, v);
        var mb = constraint_matches(cb, v);
        var want = 0;
        if (ma == 1 || mb == 1) { want = 1; }
        if (constraint_matches(cor, v) != want) { syscall(60, 43); }
        # AND of two single comparators, for a release version.
        var sa = str_builder_new();
        _vr_cmp_text(sa, vt);
        var t1 = str_builder_build(sa);
        var sb2 = str_builder_new();
        _vr_cmp_text(sb2, vt);
        var t2 = str_builder_build(sb2);
        var c1 = constraint_parse(t1);
        var c2 = constraint_parse(t2);
        var sj = str_builder_new();
        str_builder_add(sj, t1);
        str_builder_putc(sj, 32);
        str_builder_add(sj, t2);
        var cand = constraint_parse(str_builder_build(sj));
        if (nous_constraint_error(c1) == 0 && nous_constraint_error(c2) == 0 && nous_sv_pre(v) == 0) {
            var w = 0;
            if (constraint_matches(c1, v) == 1 && constraint_matches(c2, v) == 1) { w = 1; }
            if (constraint_matches(cand, v) != w) { syscall(60, 44); }
        }
        # A hyphen range is >=A <=B.
        var ha = _vr_ver();
        var hb = vt;
        if (fz_one_in(2) == 1) { hb = _vr_ver(); }
        var sh = str_builder_new();
        str_builder_add(sh, ha);
        str_builder_add_cstr(sh, " - ");
        str_builder_add(sh, hb);
        var chy = constraint_parse(str_builder_build(sh));
        var sd = str_builder_new();
        str_builder_add_cstr(sd, ">=");
        str_builder_add(sd, ha);
        str_builder_add_cstr(sd, " <=");
        str_builder_add(sd, hb);
        var cde = constraint_parse(str_builder_build(sd));
        if (nous_constraint_error(chy) == 0 && nous_constraint_error(cde) == 0) {
            if (constraint_matches(chy, v) != constraint_matches(cde, v)) { syscall(60, 45); }
        }
        fz_mix(want);
    }
    return 0;
}

fn _vr_case(k): i64 {
    var vt = _vr_ver();
    var v = semver_parse(vt);
    var c1 = _vr_ct(vt);
    var c2 = _vr_ct(vt);
    var m = constraint_matches(c1, v);
    if (nous_constraint_error(c1) != 0 && m != 0) { syscall(60, 31); }
    if (constraints_compatible(c1, c2) != constraints_compatible(c2, c1)) { syscall(60, 32); }
    fz_mix(m);
    if (v != 0) {
        if (nous_sv_pre(v) != 0 && m == 1 && ct_ver(c1) != 0 && nous_sv_pre(ct_ver(c1)) == 0) { syscall(60, 35); }
        if (m == 1 && constraint_matches(c2, v) == 1 && constraints_compatible(c1, c2) == 0) { syscall(60, 36); }
        var v2 = semver_parse(semver_to_str(v));
        if (v2 == 0 || nous_semver_cmp_pub(v, v2) != 0) { syscall(60, 37); }
    }
    _vr_logic(vt, v);
    var x = semver_parse(_vr_ver());
    var y = semver_parse(_vr_ver());
    var z = semver_parse(_vr_ver());
    if (x != 0 && y != 0 && z != 0) {
        if (semver_cmp(x, x) != 0 || nous_semver_cmp_pub(x, x) != 0) { syscall(60, 38); }
        if (_sgn(semver_cmp(x, y)) != 0 - _sgn(semver_cmp(y, x))) { syscall(60, 39); }
        if (_sgn(nous_semver_cmp_pub(x, y)) != 0 - _sgn(nous_semver_cmp_pub(y, x))) { syscall(60, 39); }
        if (semver_cmp(x, y) <= 0 && semver_cmp(y, z) <= 0 && semver_cmp(x, z) > 0) { syscall(60, 40); }
        var pxy = nous_semver_cmp_pub(x, y);
        if (pxy <= 0 && nous_semver_cmp_pub(y, z) <= 0 && nous_semver_cmp_pub(x, z) > 0) { syscall(60, 40); }
        if (semver_cmp(x, y) != 0 && _sgn(pxy) != _sgn(semver_cmp(x, y))) { syscall(60, 41); }
        fz_mix(_sgn(pxy) + 1);
    }
    var a = _vr_rand("0123456789.:~-+abzZ");
    var b = _vr_rand("0123456789.:~-+abzZ");
    var ab = _sgn(nous_deb_version_cmp(a, b));
    var ba = _sgn(nous_deb_version_cmp(b, a));
    if (ab != 0 - ba) { syscall(60, 33); }
    if (nous_deb_version_cmp(a, a) != 0) { syscall(60, 34); }
    fz_mix(ab + 1);
    return 0;
}

fn main(): i64 {
    alloc_init();
    constraint_parse(str_from(""));
    constraint_parse(str_from(">="));
    constraint_parse(str_from("^99999999999999999999"));
    semver_parse(str_from("9223372036854775808.0.0"));
    semver_parse(str_from("1.0.0-"));
    semver_parse(str_from("1.0.0-.+."));
    constraint_parse(str_from("1.0.0-rc.1+"));
    constraint_parse(str_from(">=1.0.0-0..1"));
    constraint_parse(str_from("||"));
    constraint_parse(str_from(" - "));
    constraint_parse(str_from(",,"));
    constraint_parse(str_from("1 - 2 - 3 || >= , <"));
    nous_deb_version_cmp(str_from(""), str_from(":"));
    nous_deb_version_cmp(str_from("1:"), str_from("-"));
    return fz_run("version fuzz", 20000, &_vr_case);
}

var _ec = main();
syscall(60, _ec);
